[Desktop Entry]
Type=Application
Name=phantGNOME LLM Window
Comment=Launch the on-screen LLM terminal (claude) as the full-auto focal tile
Exec=sh -c "exec \"$HOME/phantGNOME/phantom-llm-window.sh\""
OnlyShowIn=GNOME;
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Phase=Applications
NoDisplay=true
Terminal=false
