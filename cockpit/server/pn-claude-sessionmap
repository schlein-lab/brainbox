#!/usr/bin/env python3

import json, os, subprocess, sys, time

try:
    data = json.load(sys.stdin)
except Exception:
    data = {}

pid = os.getppid()
claude_pid = None
for _ in range(6):
    try:
        with open("/proc/%d/comm" % pid) as f:
            if f.read().strip() == "claude":
                claude_pid = pid
                break
        with open("/proc/%d/stat" % pid) as f:
            pid = int(f.read().rsplit(") ", 1)[1].split()[1])
    except Exception:
        break

tmux_session = None
try:
    pane = os.environ.get("TMUX_PANE")
    if pane and os.environ.get("TMUX"):
        r = subprocess.run(["tmux", "display-message", "-pt", pane, "#S"],
                           capture_output=True, text=True, timeout=3)
        tmux_session = (r.stdout or "").strip() or None
except Exception:
    tmux_session = None

rec = {
    "ts": time.time(),
    "claude_pid": claude_pid,
    "session_id": data.get("session_id"),
    "transcript_path": data.get("transcript_path"),
    "cwd": data.get("cwd") or os.getcwd(),
    "source": data.get("source"),
    "tmux": tmux_session,
}
path = os.path.expanduser("~/.claude/session-map.jsonl")
try:

    if os.path.exists(path) and os.path.getsize(path) > 60000:
        lines = open(path).read().splitlines()[-100:]
        open(path, "w").write("\n".join(lines) + "\n")
    with open(path, "a") as f:
        f.write(json.dumps(rec) + "\n")
except Exception:
    pass
sys.exit(0)
