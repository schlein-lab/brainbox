    bind = cfg.get("bind", "0.0.0.0"); port = cfg.get("port", 8076)
    ThreadingHTTPServer.request_queue_size = 128
    scheme = "http"
    _ctx = None
    if cfg.get("cert") and os.path.exists(cfg["cert"]):
        _ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        _ctx.load_cert_chain(cfg["cert"], cfg["key"])
        scheme = "https"

    class _PortalServer(ThreadingHTTPServer):

        def get_request(self):
            sock, addr = self.socket.accept()
            if _ctx is None:
                return sock, addr
            return _ctx.wrap_socket(sock, server_side=True, do_handshake_on_connect=False), addr
        def finish_request(self, request, client_address):
            if _ctx is not None:
                try:
                    request.settimeout(12)
                    request.do_handshake()
                    request.settimeout(None)
                except OSError:
                    return
            self.RequestHandlerClass(request, client_address, self)

        def handle_error(self, request, client_address):

            exc = sys.exc_info()[1]
            if isinstance(exc, _DISCONNECT_EXC):
                _log_disconnect("connection", client_address, exc)
                return
            super().handle_error(request, client_address)

    srv = _PortalServer((bind, port), Handler)
    srv.daemon_threads = True
    pin = cfg.get("pin")
    print(f"brainbox-portal läuft auf {scheme}://{cfg.get('lan_ip')}:{port}/  "
          f"({'PIN-geschützt' if pin else 'offen'})")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass

