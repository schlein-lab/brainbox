def cmd_adduser(args):

    import getpass
    if not args:
        print("usage: brainbox-portal adduser <uid> [name] [role]"); return
    uid = args[0]; name = args[1] if len(args) > 1 else uid; role = args[2] if len(args) > 2 else "user"
    pw = os.environ.get("PP_NEW_PASSWORD") or getpass.getpass("Passwort für %s: " % uid)
    if not pw:
        print("kein Passwort — abgebrochen"); return
    user_create(uid, pw, name=name, role=role)
    if role == "kid":
        _kid_floor_ensure(uid)
    else:
        _neu_nutzer_llm_floor(uid, role)
    print("angelegt: %s (role=%s) — Login: Benutzer '%s' + Passwort" % (uid, role, _uid_safe(uid)))

