def _assert_fresh_identity(cfg):

    if not os.path.exists("/etc/brainbox/is-appliance"):
        return
    bad = []
    if not os.path.exists("/var/lib/brainbox/firstboot.done"):
        bad.append("first-boot identity not yet minted (firstboot.done missing)")
    if not cfg.get("pin"):
        bad.append("no PIN set (an appliance must not run open)")
    try:
        import pn_certs
        fp = pn_certs.ca_fingerprint_sha256()
        baked = ""
        try:
            baked = open("/usr/share/brainarbeit/baked-ca.fingerprint").read().strip()
        except Exception:
            pass
        if not fp:
            bad.append("per-box CA missing")
        elif baked and fp == baked:
            bad.append("CA equals the baked golden CA — not regenerated")
    except Exception:
        pass
    if bad:
        sys.stderr.write("[portal] REFUSING TO SERVE — placeholder/default identity:\n  - "
                         + "\n  - ".join(bad) + "\n")
        sys.exit(3)

