def ensure_cert(cfg):

    try:
        import pn_certs
        _c, _k = pn_certs.ensure_portal_cert(cfg)
        if _c and _k and os.path.exists(_c) and os.path.exists(_k):
            cfg["cert"], cfg["key"] = _c, _k
            return True
    except Exception as _e:
        try: print("  (pn_certs: %s — Fallback self-signed)" % _e)
        except Exception: pass
    if os.path.exists(CERT_PATH) and os.path.exists(KEY_PATH):
        cfg["cert"], cfg["key"] = CERT_PATH, KEY_PATH
        return True
    if not have("openssl"):
        print("  (openssl fehlt — laufe ohne HTTPS; Kamera/Mikro brauchen HTTPS)")
        return False
    ip = cfg.get("lan_ip", "127.0.0.1")
    cmd = ["openssl", "req", "-x509", "-newkey", "rsa:2048", "-keyout", KEY_PATH,
           "-out", CERT_PATH, "-days", "3650", "-nodes", "-subj", "/CN=brainbox-portal",
           "-addext", f"subjectAltName=IP:{ip},DNS:localhost"]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode == 0:
        cfg["cert"], cfg["key"] = CERT_PATH, KEY_PATH
        print("  HTTPS-Zertifikat erzeugt (selbst-signiert; Browser-Warnung einmal akzeptieren)")
        return True
    print(f"  (Zertifikat fehlgeschlagen: {r.stderr[:80]} — ohne HTTPS)")
    return False

def detect_email(cfg):

    import glob
    user = cfg.get("email_user"); pw = cfg.get("email_pass")
    envp = os.path.join(HOME, ".env")
    if os.path.exists(envp):
        for ln in open(envp):
            ln = ln.strip()
            if not pw and "GMAIL_APP_PASSWORD" in ln.upper() and "=" in ln:
                pw = ln.split("=", 1)[1].strip().strip('"').strip("'")
            if not user and "=" in ln and any(k in ln.upper() for k in ("EMAIL", "SMTP_USER", "GMAIL_USER", "MAIL_FROM")):
                m = re.search(r'[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}', ln)
                if m:
                    user = m.group(0)
    for s in glob.glob(os.path.join(HOME, ".local", "share", "zyrkel", "instances", "*", "settings.json")):
        try:
            d = json.load(open(s))
            user = user or d.get("smtp_user") or d.get("email_from") or d.get("gmail_user") or d.get("email")
            pw = pw or d.get("smtp_pass") or d.get("gmail_app_password") or d.get("smtp_password")
        except Exception:
            pass
    cfg["email_user"] = user; cfg["email_pass"] = pw
    return bool(user and pw)

