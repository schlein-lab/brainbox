def _vpn_status_probe(vid, cmd):
    st = None
    try:
        r = subprocess.run(["bash", "-lc", cmd], capture_output=True, text=True, timeout=12)
        st = json.loads((r.stdout or "").strip() or "{}")
    except Exception:
        st = None
    with _VPN_CACHE_LK:
        _VPN_CACHE[vid] = (time.time(), st)
        _VPN_CACHE_INFLIGHT.discard(vid)
    return st

def _vpn_status(vid, cmd, ttl=8):

    now = time.time()
    with _VPN_CACHE_LK:
        ent = _VPN_CACHE.get(vid)
        if ent and now - ent[0] < ttl:
            return ent[1]
        if ent is not None:
            if vid not in _VPN_CACHE_INFLIGHT:
                _VPN_CACHE_INFLIGHT.add(vid)
                threading.Thread(target=_vpn_status_probe, args=(vid, cmd), daemon=True).start()
            return ent[1]
    return _vpn_status_probe(vid, cmd)

