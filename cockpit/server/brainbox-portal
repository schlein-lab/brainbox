def _sess_conf_int(key, default):

    val = os.environ.get(key)
    if val is None:
        for p in SESSION_CONF_FILES:
            try:
                for ln in open(p):
                    ln = ln.strip()
                    if not ln or ln.startswith("#") or "=" not in ln:
                        continue
                    k, v = ln.split("=", 1)
                    if k.strip() == key:
                        val = v.split("#", 1)[0].strip().strip(chr(34) + chr(39))
            except Exception:
                continue
    try:
        return float(str(val).strip())
    except Exception:
        return float(default)

def _session_limits():

    now = time.time()
    v = _SESS_LIMITS["v"]
    if v is None or (now - _SESS_LIMITS["t"]) > 60.0:
        v = (max(0.0, _sess_conf_int("PN_SESSION_MAX_DAYS", SESSION_MAX_DAYS_DEFAULT)) * 86400.0,
             max(0.0, _sess_conf_int("PN_SESSION_IDLE_DAYS", SESSION_IDLE_DAYS_DEFAULT)) * 86400.0)
        _SESS_LIMITS["v"], _SESS_LIMITS["t"] = v, now
    return v

def _sess_rec(val, tok="", now=None):

    now = now or time.time()
    kind = "agent" if str(tok).startswith("agent-") else "login"
    if isinstance(val, dict):
        return {"uid": str(val.get("uid") or DEFAULT_PRINCIPAL),
                "created": float(val.get("created") or now),
                "seen": float(val.get("seen") or val.get("created") or now),
                "kind": str(val.get("kind") or kind)}

    return {"uid": str(val or DEFAULT_PRINCIPAL), "created": now, "seen": now, "kind": kind}

def _load_sessions():

    now = time.time()
    try:
        with open(SESSIONS_FILE) as fh:
            data = json.load(fh)
        if isinstance(data, dict):
            return {t: _sess_rec(v, t, now) for t, v in data.items()}
        if isinstance(data, list):
            return {t: _sess_rec(DEFAULT_PRINCIPAL, t, now) for t in data}
    except Exception:
        pass
    return {}

def _save_sessions():
    try:
        with _SESS_LK:
            os.makedirs(os.path.dirname(SESSIONS_FILE), exist_ok=True)
            tmp = SESSIONS_FILE + ".tmp"
            with open(tmp, "w") as fh:
                json.dump(dict(SESSIONS), fh)
            os.chmod(tmp, 0o600)
            os.replace(tmp, SESSIONS_FILE)
            _SESS_SAVE_T[0] = time.time()
    except Exception:
        pass

