    def _dispatch_fail(self, method):

        try:
            _traceback_log("dispatch %s %s" % (method, self.path))
        except Exception:
            pass
        code, msg = 500, "Interner Fehler bei der Verarbeitung der Anfrage."
        try:
            raw = self._body() or b""
            raw = raw.decode("utf-8", "replace") if isinstance(raw, (bytes, bytearray)) else raw
            st = raw.strip()
            if st:
                try:
                    if not isinstance(json.loads(st), dict):
                        code, msg = 400, ("Der Anfrage-Body muss ein JSON-Objekt sein "
                                          "(z. B. {\"text\": \"...\"}).")
                except ValueError:
                    code, msg = 400, "Ungültiges JSON im Anfrage-Body."
                except Exception:
                    code, msg = 400, "Anfrage-Body konnte nicht gelesen werden."
        except Exception:
            pass
        try:
            self.send_html(json.dumps({"ok": False, "error": msg}), code,
                           [("Content-Type", "application/json")])
        except Exception:
            pass

