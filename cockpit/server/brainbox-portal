def _session_revoked_at(uid):

    try:
        return portal_users.session_revoked_at(uid)
    except Exception:
        return 0.0

def _session_valid(tok, rec, now):

    if not isinstance(rec, dict):
        return False
    created = float(rec.get("created") or 0.0)
    seen = float(rec.get("seen") or 0.0)
    rev = _session_revoked_at(rec.get("uid"))
    if rev and created < rev:
        return False
    if rec.get("kind") == "agent" or str(tok).startswith("agent-"):
        return True
    max_s, idle_s = _session_limits()
    if max_s and created and (now - created) > max_s:
        return False
    if idle_s and seen and (now - seen) > idle_s:
        return False
    return True

def _sessions_prune(force=False):

    now = time.time()
    with _SESS_LK:
        if not force and (now - _SESS_PRUNE_T[0]) < 3600.0:
            return 0
        _SESS_PRUNE_T[0] = now
        dead = [t for t, r in list(SESSIONS.items()) if not _session_valid(t, r, now)]
        for t in dead:
            SESSIONS.pop(t, None)
    if dead:
        _save_sessions()
    return len(dead)

def _session_uid(tok):

    if not tok:
        return None
    rec = SESSIONS.get(tok)
    if rec is None:
        return None
    now = time.time()
    if not _session_valid(tok, rec, now):
        with _SESS_LK:
            SESSIONS.pop(tok, None)
        _save_sessions()
        return None

    rec["seen"] = now
    if (now - _SESS_SAVE_T[0]) > 60.0:
        _save_sessions()
    _sessions_prune()
    return rec.get("uid") or DEFAULT_PRINCIPAL

def _session_new(uid, kind="login", prefix=""):

    now = time.time()
    tok = prefix + secrets.token_urlsafe(24)
    SESSIONS[tok] = {"uid": uid, "created": now, "seen": now, "kind": kind}
    _save_sessions()
    return tok

def _session_drop(tok):

    if tok and tok in SESSIONS:
        with _SESS_LK:
            SESSIONS.pop(tok, None)
        _save_sessions()
        return True
    return False

_sessions_prune(force=True)

def lan_ip():

    try:
        r = subprocess.run(["ip", "-4", "route", "get", "8.8.8.8"], capture_output=True, text=True, timeout=3)
        toks = (r.stdout or "").split()
        if "src" in toks:
            return toks[toks.index("src") + 1]
    except Exception:
        pass
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("8.8.8.8", 80)); return s.getsockname()[0]
    except Exception:
        return "0.0.0.0"
    finally:
        s.close()

