class Handler(pn_hpc_safeguard.HpcSafeguardRoutes, portal_mcp.McpRoutes, portal_api_v1.ApiV1Routes, portal_backup.BackupRoutes, portal_shutdown.ShutdownRoutes, portal_vpn_profiles.VpnProfileRoutes, portal_routes_identity.IdentityRoutes, portal_routes_admin.AdminRoutes, portal_routes_device.DeviceRoutes, portal_routes_media.MediaRoutes, portal_routes_voice.VoiceRoutes, portal_routes_session.SessionRoutes, portal_routes_live.LiveRoutes, portal_routes_relay.RelayArmRoutes, BaseHTTPRequestHandler, metaclass=_HandlerMeta):
    protocol_version = "HTTP/1.1"
    cfg = {}
    def log_message(self, *a):
        pass

    def handle_one_request(self):

        try:
            return self._handle_one_request_inner()
        except _DISCONNECT_EXC as e:
            self.close_connection = True
            _log_disconnect("during", getattr(self, "client_address", None), e,
                            getattr(self, "path", None))

    def _handle_one_request_inner(self):

        self.__dict__.pop("_apikey_cache", None)
        self.__dict__.pop("_body_cache", None)
        return BaseHTTPRequestHandler.handle_one_request(self)

    def _apikey_entry(self):

        if hasattr(self, "_apikey_cache"):
            return self._apikey_cache
        ent = None
        if _apikeys is not None:
            raw = ""
            h = self.headers.get("Authorization", "") or ""
            if h[:7].lower() == "bearer ":
                raw = h[7:].strip()
            if not raw:
                raw = (self.headers.get("X-API-Key", "") or "").strip()
            if not raw:
                try:
                    raw = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query).get("key", [""])[0]
                except Exception:
                    raw = ""
            if raw:
                ent = _apikeys.resolve(raw)
        self._apikey_cache = ent
        return ent

    def _apikey_scoped_for(self, path=None, method=None):

        ent = self._apikey_entry()
        if ent is None or _apikeys is None:
            return False
        p = path or urllib.parse.urlparse(self.path).path
        return bool(_apikeys.scope_ok(ent, p, method or self.command))

    def _apikey_ratelimited(self):

        if _apikeys is None:
            return False
        ent = self._apikey_entry()
        if ent is None:
            return False
        return not _apikeys.rate_ok(ent["id"])

    def _is_session_auth(self):

        cookie = http.cookies.SimpleCookie(self.headers.get("Cookie", ""))
        tok = cookie["pp_session"].value if "pp_session" in cookie else ""
        if _session_uid(tok) is not None:
            return True
        try:
            qtok = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query).get("token", [""])[0]
            return bool(qtok and _session_uid(qtok) is not None)
        except Exception:
            return False

    @property
    def cfg(self):

        return cfg_live()

    def caps(self):

        return caps_live(self.cfg.get("caps", {}))

    _SENSITIVE_PREFIXES = ("/api/admin", "/api/secret", "/api/vault", "/api/keys", "/api/key",
                           "/api/pair", "/api/vpn", "/api/user", "/api/shutdown", "/api/kids",

                           "/api/identity")

    def _lan_open(self):
        return bool(self.cfg.get("lan_open"))

    def _client_is_lan(self):

        ip = self.client_address[0] if self.client_address else ""
        if ip in ("127.0.0.1", "::1") or ip.startswith(("192.168.", "10.", "169.254.")):
            return True
        if ip.startswith("172."):
            try:
                return 16 <= int(ip.split(".")[1]) <= 31
            except Exception:
                return False
        return False

    def _route_sensitive(self, path=None):
        p = path or urllib.parse.urlparse(self.path).path
        return any(p == s or p.startswith(s) for s in self._SENSITIVE_PREFIXES)

    def authed(self):
        pin = self.cfg.get("pin")
        if not pin:
            return True
        cookie = http.cookies.SimpleCookie(self.headers.get("Cookie", ""))
        tok = cookie["pp_session"].value if "pp_session" in cookie else ""

        if _session_uid(tok) is not None:
            return True

        try:
            qtok = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query).get("token", [""])[0]
            if qtok and _session_uid(qtok) is not None:
                return True
        except Exception:
            pass

        htok = self.headers.get("X-PP-Token", "")
        if htok and _session_uid(htok) is not None:
            return True

        if self._apikey_scoped_for():
            return True

        if self._lan_open() and self._client_is_lan() and not self._route_sensitive():
            return True
        return False

    def _inject_wstoken(self, html):
        cookie = http.cookies.SimpleCookie(self.headers.get("Cookie", ""))
        tok = cookie["pp_session"].value if "pp_session" in cookie else ""
        try:
            _u = user_get(self._principal())
            role = (_u or {}).get("role", "") if _u else ""
        except Exception:
            role = ""
        inj = ("<script>window.PP_WSTOKEN=%s;window.PP_USER=%s;window.PP_ROLE=%s</script></head>"
               % (json.dumps(tok), json.dumps(self._principal()), json.dumps(role)))

        idx = html.rfind("</head>")
        if idx < 0:
            return html + inj
        return html[:idx] + inj + html[idx + len("</head>"):]

    def _cookie_flags(self):

        base = "Path=/; HttpOnly; SameSite=Lax"
        try:
            import ssl as _ssl
            if isinstance(self.connection, _ssl.SSLSocket):
                return base + "; Secure"
        except Exception:
            pass
        return base

    def send_html(self, body, code=200, extra=None):

        b = body.encode("utf-8") if isinstance(body, str) else body
        extra = list(extra or [])
        ctype = next((v for k, v in extra if k.lower() == "content-type"),
                     "text/html; charset=utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-cache, no-store, must-revalidate")
        self.send_header("Content-Length", str(len(b)))
        for k, v in extra:
            if k.lower() == "content-type":
                continue
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(b)

    def _body(self):

        if not hasattr(self, "_body_cache"):
            try:
                n = int(self.headers.get("Content-Length", 0) or 0)
            except (ValueError, TypeError):
                n = 0
            self._body_cache = self.rfile.read(n) if n > 0 else b""
        return self._body_cache

    def _json_obj(self):

        raw = self._body() or b""
        if isinstance(raw, (bytes, bytearray)):
            raw = raw.decode("utf-8", "replace")
        raw = raw.strip() or "{}"
        try:
            obj = json.loads(raw)
        except ValueError:
            return self._bad_body("Ungültiges JSON im Anfrage-Body.")
        if not isinstance(obj, dict):
            return self._bad_body("Der Anfrage-Body muss ein JSON-Objekt sein "
                                  "(z. B. {\"text\": \"...\"}), kein %s." % type(obj).__name__)
        return obj

