def main():
    a = sys.argv[1:]
    cmd = a[0] if a else "serve"
    if cmd == "setup":
        cmd_setup(a[1:])
    elif cmd == "serve":
        cmd_serve(a[1:])
    elif cmd == "status":
        cmd_status(a[1:])
    elif cmd == "adduser":
        cmd_adduser(a[1:])
    elif cmd == "users":
        cmd_users(a[1:])
    elif cmd == "install-service":
        cmd_install_service(a[1:])
    elif cmd == "install-voice":
        _install_voice_cli(a[1:])
    elif cmd == "update":
        import portal_update as _pu_cli
        raise SystemExit(_pu_cli._cli(a[1:]))
    elif cmd == "_commission":

        Handler.cfg = load_cfg() or {}
        os.makedirs(JOBS_DIR, exist_ok=True)
        jid = a[1]
        try:
            run_commission(jid)
        except Exception as e:
            try:
                job_update(jid, status="error"); job_log(jid, "FEHLER: " + str(e))
            except Exception:
                pass
            sys.exit(1)
    elif cmd == "_commission_goal":

        Handler.cfg = load_cfg() or {}
        os.makedirs(JOBS_DIR, exist_ok=True)
        goal = a[1] if len(a) > 1 else ""
        principal = (os.environ.get("PN_PRINCIPAL") or os.environ.get("PN_SUBMITTER") or "owner").strip()
        if principal.startswith("web:"):
            principal = principal[4:] or "owner"
        jid = job_create(goal, None, mode="commission", principal=principal)
        try:
            run_commission(jid)
        except Exception as e:
            try:
                job_update(jid, status="error"); job_log(jid, "FEHLER: " + str(e))
            except Exception:
                pass
            sys.exit(1)
    else:
        print(__doc__)

if __name__ == "__main__":
    main()
