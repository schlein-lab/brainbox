CAPS_ENV_FILES = ("/etc/brainbox/caps.env", "/etc/brainbox/site.conf")
CAPS_TTL_S = 30.0
_CAPS_CACHE = {"t": 0.0, "v": None}
_CAPS_LK = threading.Lock()

def _caps_env_files():

    out = {}
    for p in CAPS_ENV_FILES:
        try:
            for ln in open(p):
                ln = ln.strip()
                if not ln or ln.startswith("#") or "=" not in ln:
                    continue
                k, v = ln.split("=", 1)
                out[k.strip()] = v.split("#", 1)[0].strip().strip(chr(34) + chr(39))
        except Exception:
            continue
    return out

def caps_pins():

    env = _caps_env_files()
    env.update({k: v for k, v in os.environ.items() if k.startswith("CAP_")})
    return {k[len("CAP_"):].lower(): (str(v).strip().lower() not in ("0", "false", "no", "off", ""))
            for k, v in env.items() if k.startswith("CAP_")}

def caps_live(base=None, force=False):

    now = time.time()
    with _CAPS_LK:
        fresh = _CAPS_CACHE["v"]
        if force or fresh is None or (now - _CAPS_CACHE["t"]) > CAPS_TTL_S:
            try:
                fresh = detect_caps()
                _CAPS_CACHE["v"], _CAPS_CACHE["t"] = fresh, now
            except Exception:
                fresh = fresh or {}
    caps = dict(base or {})
    caps.update(fresh or {})
    try:
        caps.update(caps_pins())
    except Exception:
        pass
    return caps

def load_cfg():
