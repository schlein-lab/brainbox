def _webapp_stand():

    try:
        import hashlib as _hl
        eintraege = []
        for n in sorted(os.listdir(WEBAPP_DIR)):
            if ".bak" in n or not n.endswith((".js", ".css", ".html")):
                continue
            try:
                st = os.stat(os.path.join(WEBAPP_DIR, n))
            except OSError:
                continue
            eintraege.append("%s:%d:%d" % (n, st.st_size, st.st_mtime_ns))
        return _hl.md5("\n".join(eintraege).encode()).hexdigest()[:12] if eintraege else ""
    except Exception:
        return ""

