    def _do_POST(self):
        u = urllib.parse.urlparse(self.path)

        self._body()

        if not portal_torwache.frei("POST", u.path) and not self.authed():
            return self._tor_zu("POST", u.path)

        if u.path == "/api/v1" or u.path.startswith("/api/v1/"):
            return self._api_v1("POST", u)
        if self._live_dispatch("POST", u.path, raw=self._body()):
            return
        if self._vpnprof_dispatch("POST", u.path, raw=self._body()):
            return
        if self._relay_dispatch("POST", u.path, raw=self._body()):
            return
        if portal_routes_passkey.dispatch(self, "POST", u.path):
            return
        if portal_einrichtung.dispatch(self, "POST", u.path):
            return

        if u.path == "/mcp":
            return self._api_mcp()
        if u.path == "/api/login":
            body = self._body().decode("utf-8", "replace")
            form = urllib.parse.parse_qs(body)
            username = (form.get("user", [""])[0]).strip()
            password = (form.get("password", [""])[0])
            pin = (form.get("pin", [""])[0])
            if not username and pin:
                username, password = DEFAULT_PRINCIPAL, pin
            ip = self.client_address[0] if self.client_address else "?"

            canon = _resolve_login_uid(username)
            key = ((canon or username) or "?") + "@" + ip
            if _login_locked(key):
                return self.send_html(self._login_html("Zu viele Versuche — kurz warten."), 429)

            _ensure_owner_user(self.cfg.get("pin"))
            if canon is not None and user_verify(canon, password):

