        sid = (urllib.parse.parse_qs(query).get("sid", [""])[0] or "").strip()
        if not sid:
            return self.send_html(json.dumps({"ok": False, "error": "sid fehlt"}), 400,
                                  [("Content-Type", "application/json")])
        rec = delivery_status(self._principal(), sid)
        if not rec:
            return self.send_html(json.dumps({"ok": True, "sid": sid, "state": "unknown"}), 200,
                                  [("Content-Type", "application/json")])
        out = {"ok": True, "sid": sid, "state": rec.get("state"), "ts": rec.get("ts")}
        if rec.get("detail"):
            out["detail"] = rec["detail"]
        return self.send_html(json.dumps(out), 200, [("Content-Type", "application/json")])

    def _principal(self):

        cookie = http.cookies.SimpleCookie(self.headers.get("Cookie", ""))
        tok = cookie["pp_session"].value if "pp_session" in cookie else ""
        _u = _session_uid(tok)
        if _u is not None:
            return _u
        try:
            qtok = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query).get("token", [""])[0]
            _u = _session_uid(qtok)
            if _u is not None:
                return _u
        except Exception:
            pass

        htok = self.headers.get("X-PP-Token", "")
        _u = _session_uid(htok)
        if _u is not None:
            return _u

        ent = self._apikey_entry()
        if ent is not None:
            return ent.get("uid") or DEFAULT_PRINCIPAL

        if self.cfg.get("pin") and self._lan_open():
            return "lan-guest"
        return DEFAULT_PRINCIPAL

