def _box_server_caps():

    cores = os.cpu_count() or 4
    memmb = 4096
    try:
        with open("/proc/meminfo") as _mf:
            for _l in _mf:
                if _l.startswith("MemTotal:"):
                    memmb = int(int(_l.split()[1]) / 1024)
                    break
    except Exception:
        pass
    return _PServerCaps(has_gpu=False, cores=cores, mem_mb=memmb, loaded=False)

def _placement_for(caps_query, policy_name="auto", label="default"):

    if _decide_placement is None:
        return None
    client = _PClientCaps.from_query(caps_query or {})
    server = _box_server_caps()
    pol = {"centralized": _PPolicy.CENTRALIZED, "offload": _PPolicy.OFFLOAD,
           "auto": _PPolicy.AUTO}.get(str(policy_name or "auto").lower(), _PPolicy.AUTO)
    dec = _decide_placement(client=client, server=server, policy=pol,
                            workload=_PWorkload(label=label or "default"))
    return {"mode": dec.mode, "policy": dec.policy_used.value, "reason": dec.reason,
            "client_can_composite": client.can_composite(),
            "server": {"has_gpu": server.has_gpu, "cores": server.cores, "mem_mb": server.mem_mb}}

