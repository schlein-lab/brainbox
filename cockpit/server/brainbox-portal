            if not (self._is_admin() or self._principal() == "owner"):
                return self.send_html('{"ok":false,"error":"nur Owner/Admin"}', 403, [("Content-Type", "application/json")])
            if sub == "enable":
                return self.send_html(json.dumps(portal_smarthome.set_enabled(True)), 200, [("Content-Type", "application/json")])
            if sub == "disable":
                return self.send_html(json.dumps(portal_smarthome.set_enabled(False)), 200, [("Content-Type", "application/json")])
            if sub == "pause":
                return self.send_html(json.dumps(portal_smarthome.pause()), 200, [("Content-Type", "application/json")])
            if sub == "resume":
                return self.send_html(json.dumps(portal_smarthome.resume()), 200, [("Content-Type", "application/json")])
            if sub == "run_now":
                return self.send_html(json.dumps(portal_smarthome.run_now()), 200, [("Content-Type", "application/json")])
            if sub in ("observe/on", "observe/off"):
                if self._principal() != "owner":
                    return self.send_html('{"ok":false,"error":"nur Owner"}', 403, [("Content-Type", "application/json")])
                return self.send_html(json.dumps(portal_smarthome.set_observe_only(sub == "observe/on")), 200, [("Content-Type", "application/json")])
            if sub.startswith("component/") and sub.endswith("/restart"):
                name = sub[len("component/"):-len("/restart")]
                body = self._json_obj()
                if body is None: return
                return self.send_html(json.dumps(portal_smarthome.restart_component(name, confirm=bool(body.get("confirm")))), 200, [("Content-Type", "application/json")])
            return self.send_html('{"ok":false,"error":"unbekannte Smarthome-Aktion"}', 404, [("Content-Type", "application/json")])
        if u.path.startswith("/api/widgets/"):
            if not (self._is_admin() or self._principal() == "owner"):
                return self.send_html('{"ok":false,"error":"nur Owner/Admin"}', 403, [("Content-Type", "application/json")])
            _wsub = u.path[len("/api/widgets/"):]
            _wab = self._json_obj()
            if _wab is None:
                return
            if _wsub == "install":
                _war = portal_widget_addons.install(_wab.get("id"))
            elif _wsub == "uninstall":
                _war = portal_widget_addons.uninstall(_wab.get("id"))
            elif _wsub == "enable":
                _war = portal_widget_addons.set_enabled(_wab.get("id"), bool(_wab.get("on", True)))
            elif _wsub == "config":
                _war = portal_widget_addons.config_set(_wab.get("id"), _wab.get("config") or {})
            else:
                _war = {"ok": False, "error": "unbekannte Widget-Aktion"}
            return self.send_html(json.dumps(_war), 200, [("Content-Type", "application/json")])
        if u.path.startswith("/api/wa/"):
            _wparts = u.path[len("/api/wa/"):].split("/", 1)
            _wab = self._json_obj()
            if _wab is None:
                return
            _war = portal_widget_addons.dispatch(_wparts[0], _wparts[1] if len(_wparts) > 1 else "", "POST", _wab, {}, self._principal(), self._is_admin())
            return self.send_html(json.dumps(_war), 200, [("Content-Type", "application/json")])
        if u.path == "/api/pipelines":
            body = self._json_obj()
            if body is None: return
            spec = (body.get("spec") or "").strip()
            if not spec:
                return self.send_html('{"ok":false,"error":"spec fehlt"}', 200, [("Content-Type", "application/json")])
            ptype = "commission" if body.get("type") == "commission" else "task"

            if ptype == "task":
                return self.send_html(json.dumps({"ok": False, "geschlossen": True,
                    "error": "Pipelines mit rohem Befehl sind geschlossen. Lege eine "
                             "commission-Pipeline an — die laeuft in einer Zelle."}), 403,
                    [("Content-Type", "application/json")])
            try:
                mem = int(body.get("mem")) if str(body.get("mem") or "").strip() else None
            except Exception:
                mem = None
            pid = pipeline_add(body.get("name"), ptype, spec, mem, owner=self._principal())
            return self.send_html(json.dumps({"ok": True, "id": pid}), 200, [("Content-Type", "application/json")])
        if u.path.startswith("/api/pipelines/"):
            pid = u.path[len("/api/pipelines/"):]
            for suffix, fn in (("/start", pipeline_start), ("/pause", pipeline_pause), ("/delete", pipeline_delete)):
                if pid.endswith(suffix):
                    rid = pid[:-len(suffix)]
                    p = pipeline_find(rid)

                    if not p or (not self._is_admin() and p.get("owner") != self._principal()):
                        return self.send_html('{"ok":false,"error":"not your pipeline"}', 403, [("Content-Type", "application/json")])

                    if suffix == "/start" and p.get("type") == "task":
                        return self.send_html(json.dumps({"ok": False, "geschlossen": True,
                            "error": "Pipelines mit rohem Befehl sind geschlossen — auf dem Wirt "
                                     "wird nichts mehr ausgefuehrt."}), 403,
                            [("Content-Type", "application/json")])
                    if suffix == "/delete":
                        pipeline_delete(rid)
                        return self.send_html('{"ok":true}', 200, [("Content-Type", "application/json")])
                    return self.send_html(json.dumps(fn(rid)), 200, [("Content-Type", "application/json")])
        if u.path == "/api/term/send":

            return self.send_html(json.dumps({
                "ok": False, "error": "retired",
                "detail": "Dieser Weg tippte direkt in eine Host-Shell und ist aus Sicherheitsgründen "
                          "abgeschaltet. Text in eine Session schicken: POST /api/session/say "
                          "{sid, text} — oder die Terminal-Lane /ws/term der Session.",
                "next": "/api/session/say"}), 410, [("Content-Type", "application/json")])
        if u.path == "/api/shortcut/claude-login":

            _wiz = "http://%s/" % (self.cfg.get("lan_ip") or lan_ip())
            return self.send_html(json.dumps({
                "ok": False, "error": "retired",
                "detail": "`claude login` oeffnet einen interaktiven Ersteinrichtungs-Dialog, der so "
                          "nicht bedienbar ist. Claude-Anmeldung laeuft ueber den Einrichtungs-Assistenten "
                          "(`claude setup-token`).",
                "next": _wiz}), 410, [("Content-Type", "application/json")])
        if u.path == "/api/shortcut/vpn":

            return self.send_html(json.dumps({
                "ok": False, "error": "retired",
                "detail": "Dieser Weg tippte den VPN-Connect-Befehl in eine Host-Shell und ist "
                          "abgeschaltet. VPN läuft über die VPN-Seite (Netz-Namespace, SSO/2FA-Link) "
                          "— dort starten statt hier.",
                "next": "/vpn"}), 410, [("Content-Type", "application/json")])
        if u.path == "/api/links/clear":
            links_clear(self._principal())
            return self.send_html('{"ok":true}', 200, [("Content-Type", "application/json")])
        if u.path == "/api/screen/open":
            body = self._json_obj()
            if body is None: return
            res = _screen_open(str(body.get("url", "")), self._principal())
            if res.get("ok"):
                links_add(self._principal(), str(body.get("url", "")), "opened")
            return self.send_html(json.dumps(res), 200, [("Content-Type", "application/json")])
        if u.path == "/api/screen/firefox-restart":
            return self.send_html(json.dumps(_firefox_restart("https://claude.ai/new", self._principal())),
                                  200, [("Content-Type", "application/json")])
        return self.send_html("not found", 404)

    def _is_admin(self):

        try:
            u = user_get(self._principal())
            return bool(u) and portal_admin.require_admin(u.get("role"))
        except Exception:
            return False

    def _login_html(self, err=""):

        try:
            p = os.path.join(WEBAPP_DIR, "login.html")
            if os.path.isfile(p):
                return open(p, encoding="utf-8").read().replace("%ERR%", err)
        except Exception:
            pass
        return LOGIN_HTML.replace("%ERR%", err)

    def _ws_upgrade(self, handler):
        key = self.headers.get("Sec-WebSocket-Key")
        if not key:
            return self.send_html("bad ws", 400)
        accept = base64.b64encode(hashlib.sha1((key + WS_GUID).encode()).digest()).decode()
        self.send_response(101)
        self.send_header("Upgrade", "websocket")
        self.send_header("Connection", "Upgrade")
        self.send_header("Sec-WebSocket-Accept", accept)
        self.end_headers()
        try:
            handler(self.connection)
        except (BrokenPipeError, ConnectionResetError, OSError):
            pass
        except Exception:

            try:
                open("/tmp/ws_err.log", "a").write("[ws_upgrade %s]\n%s\n" %
                                                    (self.path, __import__("traceback").format_exc()))
            except Exception:
                pass

