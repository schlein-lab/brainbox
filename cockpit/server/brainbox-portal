_CFG_CACHE = {"key": None, "v": {}}
_CFG_LK = threading.Lock()

def cfg_live():

    try:
        _st = os.stat(CFG_PATH)
        key = (_st.st_mtime_ns, _st.st_size)
    except OSError:
        key = None
    with _CFG_LK:
        if key is not None and _CFG_CACHE["key"] != key:
            d = load_cfg()
            if d:
                _CFG_CACHE["v"], _CFG_CACHE["key"] = d, key
        cfg = _CFG_CACHE["v"]
    if cfg:
        try:
            cfg["caps"] = caps_live(cfg.get("caps"))
        except Exception:
            pass
    return cfg

