def _cer_target(verb, text):
    t = text or ""
    meta = {}
    label = t.strip()
    m = re.search(r"[\w.+-]+@[\w-]+\.[\w.-]+", t)
    if m:
        meta["address"] = m.group(0)
        label = m.group(0)
    ms = re.search(r"betreff\s+(.+?)(?:\s+(?:mit|und|anhang)\b|$)", t, re.I)
    if ms:
        meta["subject"] = ms.group(1).strip()
    if verb == "verb.pay":
        ma = re.search(r"(\d+(?:[.,]\d+)?)\s*(eur|euro|usd|dollar|€|\$)?", t, re.I)
        if ma:
            meta["amount"] = ma.group(1).replace(",", ".")
            meta["currency"] = (ma.group(2) or "EUR").upper().replace("EURO", "EUR").replace("€", "EUR")
        mp = re.search(r"an\s+([\w äöüÄÖÜß.-]+?)(?:\s+\d|$)", t, re.I)
        if mp:
            meta["payee"] = mp.group(1).strip()
            label = meta["payee"]
    if verb == "verb.kill":
        mk = re.search(r"\b(pid\s*)?(\d{2,7})\b", t)
        if mk:
            meta["pid"] = mk.group(2)
        mn = re.search(r"(?:prozess|service|dienst)\s+([\w.-]+)", t, re.I)
        if mn:
            meta["service_name"] = mn.group(1)
            label = mn.group(1)
    typ = {"verb.mail_send": "message", "verb.pay": "payment", "verb.kill": "process",
           "verb.delete": "artifact", "verb.commit": "change",
           "verb.credential_enter": "credential"}.get(verb, "action")
    return _CerEntry(ref="utt:" + hashlib.sha256(t.encode("utf-8")).hexdigest()[:12],
                     type=typ, label=(label or verb), meta=meta)

