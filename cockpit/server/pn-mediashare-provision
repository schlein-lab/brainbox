#!/bin/sh
set -eu
VERB="${1:-}"
OWNER="${PN_SHARES_OWNER:-$(getent passwd 1000 | cut -d: -f6 | xargs -r basename 2>/dev/null || echo brainbox)}"
GROUP=sharemembers
OWNER_HOME="$(getent passwd "$OWNER" | cut -d: -f6 2>/dev/null)"; OWNER_HOME="${OWNER_HOME:-/home/$OWNER}"

in_freigabe(){
  _p="$(readlink -f -- "${1:-}" 2>/dev/null || true)"
  [ -n "$_p" ] || { echo "refuse: Pfad nicht aufloesbar" >&2; exit 2; }
  for _r in "/data/shares" "$OWNER_HOME/.local/share/brainbox-portal/shares"; do
    _rr="$(readlink -f -- "$_r" 2>/dev/null || true)"; [ -n "$_rr" ] || _rr="$_r"
    case "$_p/" in "$_rr"/*) printf '%s' "$_p"; return 0 ;; esac
  done
  echo "refuse: Pfad liegt ausserhalb der Freigabe-Wurzel" >&2; exit 2
}

case "$VERB" in
  sso)
    USER="${2:-}"; PATHDIR="${3:-}"
    [ -z "$PATHDIR" ] || PATHDIR="$(in_freigabe "$PATHDIR")" || exit 2
    printf '%s' "$USER" | grep -qE '^[a-z_][a-z0-9_-]{0,15}$' || { echo "refuse: bad uid shape" >&2; exit 2; }
    case "$USER" in bshare-*) echo "refuse: bshare-* is the add verb, not sso" >&2; exit 2 ;; esac
    case " root daemon bin sys sync games man lp mail news uucp proxy www-data backup list irc nobody sshd samba messagebus systemd-network $GROUP $OWNER " in
      *" $USER "*) echo "refuse: reserved/system/owner account" >&2; exit 2 ;;
    esac
    if id "$USER" >/dev/null 2>&1; then
      SH="$(getent passwd "$USER" | cut -d: -f7)"
      case "$SH" in */nologin|*/false|/bin/false|"") : ;; *) echo "refuse: existing interactive account" >&2; exit 2 ;; esac
    fi
    getent group "$GROUP" >/dev/null 2>&1 || groupadd -r "$GROUP"
    id -nG "$OWNER" 2>/dev/null | tr ' ' '\n' | grep -qx "$GROUP" || usermod -aG "$GROUP" "$OWNER" 2>/dev/null || true
    if ! id "$USER" >/dev/null 2>&1; then
      useradd -r -M -s /usr/sbin/nologin -c "brainbox SSO share" "$USER"
    fi
    usermod -aG "$GROUP" "$USER" 2>/dev/null || true
    PW="$(cat)"
    [ -n "$PW" ] || { echo "refuse: empty password" >&2; exit 2; }
    if pdbedit -L 2>/dev/null | cut -d: -f1 | grep -qx "$USER"; then
      printf '%s\n%s\n' "$PW" "$PW" | smbpasswd -s "$USER" >/dev/null
    else
      printf '%s\n%s\n' "$PW" "$PW" | smbpasswd -s -a "$USER" >/dev/null
    fi
    smbpasswd -e "$USER" >/dev/null 2>&1 || true
    if [ -n "$PATHDIR" ] && [ -d "$PATHDIR" ]; then
      chown -R "$OWNER":"$GROUP" "$PATHDIR" 2>/dev/null || true
      chmod 2775 "$PATHDIR" 2>/dev/null || true
    fi
    ;;
  add)
    USER="${2:-}"; PATHDIR="${3:-}"
    [ -z "$PATHDIR" ] || PATHDIR="$(in_freigabe "$PATHDIR")" || exit 2
    case "$USER" in bshare-*) : ;; *) echo "refuse: user must be bshare-*" >&2; exit 2 ;; esac
    printf '%s' "$USER" | grep -qE '^bshare-[a-z0-9-]{1,13}$' || { echo "refuse: bad user shape" >&2; exit 2; }
    getent group "$GROUP" >/dev/null 2>&1 || groupadd -r "$GROUP"
    id -nG "$OWNER" 2>/dev/null | tr ' ' '\n' | grep -qx "$GROUP" || usermod -aG "$GROUP" "$OWNER" 2>/dev/null || true
    if ! id "$USER" >/dev/null 2>&1; then
      useradd -r -M -s /usr/sbin/nologin -c "brainbox session share" "$USER"
    fi
    usermod -aG "$GROUP" "$USER" 2>/dev/null || true
    PW="$(cat)"
    printf '%s\n%s\n' "$PW" "$PW" | smbpasswd -s -a "$USER" >/dev/null
    smbpasswd -e "$USER" >/dev/null 2>&1 || true
    if [ -n "$PATHDIR" ] && [ -d "$PATHDIR" ]; then
      chown "$OWNER":"$OWNER" "$PATHDIR" 2>/dev/null || true
      chmod 2770 "$PATHDIR" 2>/dev/null || true
      PUB="$(dirname "$(dirname "$PATHDIR")")/public"
      PUB="$(in_freigabe "$PUB" 2>/dev/null || true)"
      if [ -n "$PUB" ] && [ -d "$PUB" ]; then
        chown "$OWNER":"$GROUP" "$PUB" 2>/dev/null || true
        chmod 2775 "$PUB" 2>/dev/null || true
      fi
    fi
    ;;
  remove)
    USER="${2:-}"
    case "$USER" in
      bshare-*) : ;;
      *)
        printf '%s' "$USER" | grep -qE '^[a-z_][a-z0-9_-]{0,15}$' || { echo "refuse: bad uid shape" >&2; exit 2 ; }
        case " root daemon bin sys sync games man lp mail news uucp proxy www-data backup list irc nobody sshd samba messagebus systemd-network $GROUP $OWNER " in
          *" $USER "*) echo "refuse: reserved/system/owner account" >&2; exit 2 ;;
        esac
        if id "$USER" >/dev/null 2>&1; then
          SH="$(getent passwd "$USER" | cut -d: -f7)"
          case "$SH" in */nologin|*/false|/bin/false|"") : ;; *) echo "refuse: existing interactive account" >&2; exit 2 ;; esac
        fi
        ;;
    esac
    smbpasswd -x "$USER" >/dev/null 2>&1 || true
    userdel "$USER" >/dev/null 2>&1 || true
    ;;
  reload)
    CONF="${2:-/etc/samba/smb.conf}"
    case "$CONF" in /etc/samba/*.conf) : ;; *) echo "refuse: conf path must be /etc/samba/*.conf" >&2; exit 2 ;; esac
    NEW="$(cat)"
    if [ -n "$NEW" ]; then
      TMP="$(mktemp)"; printf '%s' "$NEW" > "$TMP"
      if testparm -s "$TMP" >/dev/null 2>&1; then
        install -m 0644 "$TMP" "$CONF"
      else
        echo "refuse: rendered smb.conf failed testparm — keeping existing $CONF" >&2
      fi
      rm -f "$TMP"
    fi
    smbcontrol smbd reload-config >/dev/null 2>&1 || pnctl reload smbd >/dev/null 2>&1 || true
    ;;
  ensure)
    /usr/local/sbin/brainbox-smbd >/dev/null 2>&1 || true
    ;;
  *)
    echo "usage: pn-mediashare-provision add|remove|sso|reload|ensure ..." >&2
    exit 2
    ;;
esac
