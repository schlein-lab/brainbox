#!/usr/bin/env python3

import os, sys, json, base64, urllib.request, urllib.parse

BASE = os.environ.get("PORTAL_URL", "http://127.0.0.1:8089").rstrip("/")

def call(path, data=None):
    req = urllib.request.Request(
        BASE + path,
        data=(json.dumps(data).encode() if data is not None else None),
        headers={"Content-Type": "application/json"},
        method=("POST" if data is not None else "GET"))
    with urllib.request.urlopen(req, timeout=90) as r:
        return r.read()

def main(a):
    if not a:
        sys.stderr.write("usage: cellfs ls|cat|stat <path> | cellfs write <path> (content on stdin)\n")
        return 2
    op = a[0]
    try:
        if op in ("ls", "stat"):
            p = a[1] if len(a) > 1 else "/"
            out = call("/api/cellfs/%s?path=%s" % (op, urllib.parse.quote(p)))
            d = json.loads(out or b"{}")
            if not d.get("ok"):
                sys.stderr.write("error: %s\n" % d.get("error")); return 1
            if op == "ls":
                for e in d.get("entries", []):
                    sys.stdout.write("%s%s\t%d\n" % (e["name"], "/" if e["dir"] else "", e.get("size", 0)))
            else:
                sys.stdout.write(json.dumps(d) + "\n")
            return 0
        if op in ("cat", "read"):
            p = a[1]
            out = call("/api/cellfs/read?path=%s" % urllib.parse.quote(p))
            sys.stdout.buffer.write(out)
            return 0
        if op == "write":
            p = a[1]; content = sys.stdin.buffer.read()
            out = call("/api/cellfs/write", {"path": p, "content_b64": base64.b64encode(content).decode()})
            d = json.loads(out or b"{}")
            sys.stdout.write(json.dumps(d) + "\n")
            return 0 if d.get("ok") else 1
    except urllib.error.HTTPError as e:
        try:
            sys.stderr.write("verweigert: %s\n" % json.loads(e.read()).get("error", e.code))
        except Exception:
            sys.stderr.write("error: %s\n" % e)
        return 1
    except Exception as e:
        sys.stderr.write("error: %s\n" % e)
        return 1
    sys.stderr.write("unknown op\n"); return 2

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
