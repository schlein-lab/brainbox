    "conversation.disambiguate":{ "family": "conversation", "kind": "evt", "ceremony": "none", "note": "the disambiguation ask (§6.1)" },
    "conversation.ack":         { "family": "conversation", "kind": "evt", "ceremony": "none", "note": "felt-latency earcon" },

    "terminal.read":  { "family": "terminal", "kind": "req", "ceremony": "read" },
