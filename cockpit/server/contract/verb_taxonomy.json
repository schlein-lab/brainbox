    "screen.region":    { "family": "screen", "kind": "req", "ceremony": "low-stakes" },

    "app.sense": { "family": "app", "kind": "req", "ceremony": "read" },
    "app.focus": { "family": "app", "kind": "req", "ceremony": "low-stakes" },
    "app.click": { "family": "app", "kind": "req", "ceremony": "low-stakes" },
    "app.type":  { "family": "app", "kind": "req", "ceremony": "low-stakes", "note": "SECRET-marked text goes via secret.* NOT here" },
    "app.key":   { "family": "app", "kind": "req", "ceremony": "low-stakes" },
    "app.open":  { "family": "app", "kind": "req", "ceremony": "low-stakes" },
    "app.macro": { "family": "app", "kind": "req", "ceremony": "low-stakes" },

    "files.drop": { "family": "files", "kind": "req", "ceremony": "low-stakes" },
    "files.get":  { "family": "files", "kind": "req", "ceremony": "read" },
    "files.list": { "family": "files", "kind": "req", "ceremony": "read" },

    "artifact.produce":     { "family": "artifact", "kind": "req", "ceremony": "low-stakes" },
