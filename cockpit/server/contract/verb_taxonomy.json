    "artifact.sync_ack":    { "family": "artifact", "kind": "req", "ceremony": "low-stakes" },
    "artifact.ledger_tail": { "family": "artifact", "kind": "req", "ceremony": "read" },

    "verb.mail_send":        { "family": "verb", "kind": "req", "ceremony": "irreversible" },
    "verb.credential_enter": { "family": "verb", "kind": "req", "ceremony": "irreversible", "note": "secret-critical; verify+speak target before vault inject (§3.8)" },
    "verb.delete":           { "family": "verb", "kind": "req", "ceremony": "irreversible" },
    "verb.pay":              { "family": "verb", "kind": "req", "ceremony": "irreversible" },
    "verb.commit":           { "family": "verb", "kind": "req", "ceremony": "irreversible" },
    "verb.kill":             { "family": "verb", "kind": "req", "ceremony": "irreversible", "interlock": "name-pid", "note": "pn-init name<->pid interlock (§3.11)" },
    "verb.ceremony_prompt":  { "family": "verb", "kind": "evt", "ceremony": "none" },
    "verb.ceremony_confirm": { "family": "verb", "kind": "req", "ceremony": "none" },
    "verb.ceremony_cancel":  { "family": "verb", "kind": "req", "ceremony": "none" },

    "secret.list_names": { "family": "secret", "kind": "req", "ceremony": "read" },
