    "enroll.request":  { "family": "enroll", "kind": "req", "ceremony": "none", "note": "self-signed proof-of-possession; TOFU-pending (§2.5)" },
    "enroll.approve":  { "family": "enroll", "kind": "req", "ceremony": "irreversible", "interlock": "name-key", "note": "owner approval-gate; grants a principal" },
