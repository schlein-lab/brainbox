    "terminal.input": { "family": "terminal", "kind": "req", "ceremony": "low-stakes", "note": "rm-class intents SHOULD escalate (§6.4)" },
    "terminal.close": { "family": "terminal", "kind": "req", "ceremony": "low-stakes" },

    "screen.show":      { "family": "screen", "kind": "req", "ceremony": "low-stakes" },
    "screen.placement": { "family": "screen", "kind": "evt", "ceremony": "none" },
