    "enroll.list":     { "family": "enroll", "kind": "req", "ceremony": "read" },
    "enroll.rotate":   { "family": "enroll", "kind": "req", "ceremony": "irreversible", "interlock": "name-key" },

    "profile.advertise":   { "family": "profile", "kind": "req", "ceremony": "low-stakes" },
    "profile.renegotiate": { "family": "profile", "kind": "req", "ceremony": "low-stakes" },
    "placement.query":     { "family": "placement", "kind": "req", "ceremony": "read" }
