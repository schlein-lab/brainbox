+        "(Dateiname mit Zeitstempel). Notiert in BUILD.md. Nach den 2 Iterationen mit dem DONE-Token beenden.")
+    wait_seal(room, None, since_off=off, timeout=1800, min_elapsed=20)
+    _pnprog(2, 3, "review")
+    subprocess.run([PR, "delete", room], capture_output=True)
+    rroom = f"{room}-rev"
+    subprocess.run([PR, "new", rroom, "--agents", "2", "--cwd", cwd, "--force", "--cap", "16"], capture_output=True)
+    wait_seal(rroom, None, since_off=0, timeout=150, quiet=True)
+    off = feed_size(rroom); pr_send(rroom,
+        "ZIEL (goal.txt): " + goal + " — Das Artefakt liegt in ../artifacts/. FRISCHE Reviewer OHNE Bau-Kontext. "
+        "Prueft STRENG, bugfixt + optimiert direkt. Schreibt VERDICT.md. Dann mit dem DONE-Token beenden.")
+    wait_seal(rroom, None, since_off=off, timeout=1800, min_elapsed=20)
+    adir = os.path.join(ws, "artifacts")
+    arts = sorted(os.listdir(adir)) if os.path.isdir(adir) else []
+    _pnprog(3, 3, f"done · {len(arts)} Artefakt(e)")
+    subprocess.run([PR, "stop", rroom], capture_output=True)
+    print(f"commission done: {len(arts)} Artefakt(e) in {adir}")
+    return 0
