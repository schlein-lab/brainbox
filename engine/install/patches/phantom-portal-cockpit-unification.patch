+def ws_events(conn, topics, after_id=None):
+    """COCKPIT UNIFICATION (architecture §9/§12): bridge the browser to pnd's ONE typed event
+    bus. We open a streaming `subscribe` on the pnd socket (per-principal authorized SERVER-SIDE
+    from the portal's peercred/broker identity — the portal never gets a topic it isn't entitled
+    to) and forward each newline-JSON event frame to the browser as a WS text frame. The browser
+    passes ?topics=user/<me>&topics=job/<id> and, on reconnect, &after=<last_event_id> so it gets
+    exactly the delta it missed (reconnect replay -> no permanent desync)."""
+    req = {"verb": "subscribe", "topics": topics}
+    if after_id is not None:
+        req["after_id"] = after_id
+    try:
+        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        s.settimeout(None)
+        s.connect(PN_SOCK)
+        s.sendall((json.dumps(req) + "\n").encode())
+    except Exception as e:
+        try:
+            ws_send(conn, json.dumps({"type": "error", "error": f"pnd: {e}"}))
+        except Exception:
+            pass
+        return
+    buf = b""
+    try:
+        while True:
+            ch = s.recv(65536)
+            if not ch:
+                break
+            buf += ch
+            while b"\n" in buf:
+                line, buf = buf.split(b"\n", 1)
+                if line.strip():
+                    ws_send(conn, line.decode("utf-8", "replace"))
+    except Exception:
+        pass
+    finally:
+        try:
+            s.close()
+        except Exception:
+            pass
