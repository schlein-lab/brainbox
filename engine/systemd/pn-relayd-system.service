[Unit]
Description=Brainarbeit off-LAN relay client (pn-relayd) — SYSTEM unit, runs as the de-privileged adapter
Documentation=file://@OPERATOR_HOME@/portioneer/docs/relay.md file://@OPERATOR_HOME@/portioneer/docs/relay-security.md
After=systemd-tmpfiles-setup.service
Wants=systemd-tmpfiles-setup.service

[Service]
Type=notify
NotifyAccess=main
User=adapter
Group=adapter
SupplementaryGroups=pnbroker
ExecStart=@OPERATOR_HOME@/portioneer/tools/pn-relayd

Environment=RELAY_PND_SOCK=/run/portioneer/pnd-broker.sock
Environment=XDG_DATA_HOME=@OPERATOR_HOME@/.local/share

Restart=always
RestartSec=2
WatchdogSec=60

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@OPERATOR_HOME@/.local/share/portioneer/relay /run/portioneer
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
