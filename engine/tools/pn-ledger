#!/usr/bin/env python3

from __future__ import annotations

import argparse
import json
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, ROOT)

from pnlib.ledger.store import LedgerStore
from pnlib.ledger import merkle, checkpoint, verify as ledger_verify
from pnlib.ledger.append import LedgerWriter
from pnlib.origin import Origin

def _emit(obj, as_json: bool):
    if as_json:
        print(json.dumps(obj, sort_keys=True, separators=(",", ":")))
    else:
        for k, v in obj.items():
            print(f"{k}: {v}")

def _load_event(args):
    n = sum(x is not None for x in (args.event, args.event_file, args.event_text))
    if n == 0:

        return None
    if n > 1:
        raise SystemExit("pn-ledger append: use only ONE of --event/--event-file/--event-text")
    if args.event is not None:
        return json.loads(args.event)
    if args.event_file is not None:
        with open(args.event_file, "r", encoding="utf-8") as f:
            return json.load(f)
    return args.event_text

def _read_pubkey(spec: str) -> bytes:

    if os.path.exists(spec):
        with open(spec, "r", encoding="utf-8") as f:
            spec = f.read().strip()
    return bytes.fromhex(spec)

def cmd_append(args) -> int:
    org = Origin(args.origin_kind, args.component, actor=args.actor, agent_id=args.agent_id)
    event = _load_event(args)
    store = LedgerStore(args.db)
    spool = args.spool or (args.db + ".spool")
    w = LedgerWriter(store, spool, background=False)
    try:
        rcpt = w.record(event, origin=org, valid_time=args.valid_time,
                        observed_time=args.observed_time)
        w.flush()

        idx = store.size - 1
        _emit({"ok": True, "spool_id": rcpt.spool_id, "durable": rcpt.durable,
               "merkle_index": idx, "size": store.size, "root": store.root().hex(),
               "leaf_hash": store.leaf_hash(idx).hex()}, args.json)
    finally:
        w.close()
        store.close()
    return 0

def cmd_head(args) -> int:
    store = LedgerStore(args.db)
    try:
        size, root = store.size, store.root()
        if args.sign_key:
            signer = checkpoint.LedgerSigner.load_private(args.sign_key)
            sth = signer.sign_sth(size, root)
            print(sth.to_json())
        else:
            _emit({"size": size, "root": root.hex(),
                   "empty": size == 0}, args.json)
    finally:
        store.close()
    return 0

def cmd_keygen(args) -> int:
    if os.path.exists(args.key) and not args.force:
        raise SystemExit(f"pn-ledger keygen: {args.key} exists (use --force to overwrite)")
    signer = checkpoint.LedgerSigner.generate()
    signer.save_private(args.key)
    _emit({"ok": True, "key": args.key, "pubkey": signer.public_key_hex,
           "log_id": signer.log_id}, args.json)
    return 0

def cmd_prove_inclusion(args) -> int:
    store = LedgerStore(args.db)
    try:
        if args.seq is not None:
            index = store.index_of_seq(args.seq)
        else:
            index = args.index
        size = args.size if args.size is not None else store.size
        proof = store.inclusion_proof(index, size)
        root = store.root_at(size)
        leaf = store.leaf_hash(index)
        ok = merkle.verify_inclusion(index, size, leaf, proof, root)
        _emit({"ok": ok, "index": index, "size": size, "leaf_hash": leaf.hex(),
               "root": root.hex(), "proof": [p.hex() for p in proof]}, args.json)
        return 0 if ok else 3
    finally:
        store.close()

def cmd_prove_consistency(args) -> int:
    store = LedgerStore(args.db)
    try:
        first, second = args.first, args.second
        proof = store.consistency_proof(first, second)
        r1, r2 = store.root_at(first), store.root_at(second)
        ok = merkle.verify_consistency(first, second, proof, r1, r2)
        _emit({"ok": ok, "first": first, "second": second, "first_root": r1.hex(),
               "second_root": r2.hex(), "proof": [p.hex() for p in proof]}, args.json)
        return 0 if ok else 3
    finally:
        store.close()

def cmd_verify(args) -> int:
    store = LedgerStore(args.db)
    try:
        pubkey = _read_pubkey(args.pubkey) if args.pubkey else None
        sths = []
        for p in (args.sth or []):
            with open(p, "r", encoding="utf-8") as f:
                sths.append(checkpoint.STH.from_json(f.read()))
        rep = ledger_verify.self_check(store, pinned_sths=sths or None, pubkey=pubkey)
        if args.json:
            print(json.dumps(rep.to_dict(), sort_keys=True, separators=(",", ":")))
        else:
            print(rep.summary())
            for e in rep.errors:
                print(f"  ERROR: {e}")
        return 0 if rep.ok else 1
    finally:
        store.close()

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="pn-ledger", description="T2 provenance ledger CLI")
    sub = p.add_subparsers(dest="cmd", required=True)

    ap = sub.add_parser("append", help="durably record one event")
    ap.add_argument("--db", required=True)
    ap.add_argument("--origin-kind", required=True, choices=["human", "agent", "model"])
    ap.add_argument("--component", required=True)
    ap.add_argument("--actor")
    ap.add_argument("--agent-id")
    ap.add_argument("--event", help="event body as a JSON string")
    ap.add_argument("--event-file", help="event body from a JSON file")
    ap.add_argument("--event-text", help="event body as a raw string")
    ap.add_argument("--valid-time", type=float)
    ap.add_argument("--observed-time", type=float)
    ap.add_argument("--spool")
    ap.add_argument("--json", action="store_true")
    ap.set_defaults(func=cmd_append)

    hp = sub.add_parser("head", help="print (optionally sign) the current tree head")
    hp.add_argument("--db", required=True)
    hp.add_argument("--sign-key", help="ledger private key to sign an STH with")
    hp.add_argument("--json", action="store_true")
    hp.set_defaults(func=cmd_head)

    kp = sub.add_parser("keygen", help="generate a ledger signing key")
    kp.add_argument("--key", required=True)
    kp.add_argument("--force", action="store_true")
    kp.add_argument("--json", action="store_true")
    kp.set_defaults(func=cmd_keygen)

    ip = sub.add_parser("prove-inclusion", help="emit an inclusion (audit) proof")
    ip.add_argument("--db", required=True)
    g = ip.add_mutually_exclusive_group(required=True)
    g.add_argument("--index", type=int)
    g.add_argument("--seq", type=int)
    ip.add_argument("--size", type=int)
    ip.add_argument("--json", action="store_true")
    ip.set_defaults(func=cmd_prove_inclusion)

    cp = sub.add_parser("prove-consistency", help="emit a consistency proof")
    cp.add_argument("--db", required=True)
    cp.add_argument("--first", type=int, required=True)
    cp.add_argument("--second", type=int, required=True)
    cp.add_argument("--json", action="store_true")
    cp.set_defaults(func=cmd_prove_consistency)

    vp = sub.add_parser("verify", help="run the read-only ledger self-check")
    vp.add_argument("--db", required=True)
    vp.add_argument("--pubkey", help="pinned ledger pubkey (hex string or file)")
    vp.add_argument("--sth", action="append", help="a pinned STH json file (repeatable)")
    vp.add_argument("--json", action="store_true")
    vp.set_defaults(func=cmd_verify)

    return p

def main(argv=None) -> int:
    args = build_parser().parse_args(argv)
    return args.func(args)

if __name__ == "__main__":
    sys.exit(main())
