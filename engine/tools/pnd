def _fleet_marked_portable(job):

    try:
        env = json.loads(job.get("env") or "{}") or {}
        v = str(env.get("PN_OFFLOADABLE", "")).strip().lower()
        if v and v not in ("0", "false", "no"):
            return True
    except Exception:
        pass
    tag = (job.get("client_tag") or job.get("tag") or "").strip()
    return bool(tag) and tag in _FC_TAGS

def _fleet_arch_agnostic(job):

    try:
        env = json.loads(job.get("env") or "{}") or {}
        v = str(env.get("PN_ARCH_AGNOSTIC", "")).strip().lower()
        return bool(v) and v not in ("0", "false", "no")
    except Exception:
        return False

