def _cmd_type_of(argv):

    try:
        if argv and argv[0]:
            base = os.path.basename(str(argv[0])).strip()
            if base:
                return "cmd:" + base[:64]
    except Exception:
        pass
    return None

def job_eta(jid, job, cx=None):

    global _ACCT_READER
    try:
        state = (job or {}).get("state")
        pos = db.position(cx if cx is not None else CX, jid)
        wait = eta.waiting_on(pos, state)
        if state and state != "queued":
            return {"position": pos, "ahead": max(0, pos - 1), "waiting_on": wait,
                    "eta_start_s": None, "eta_done_s": None, "human": None}
        tt = (job or {}).get("task_type")
        if not tt:

            try:
                tt = _cmd_type_of(json.loads((job or {}).get("cmd") or "[]"))
            except Exception:
                tt = None
        if _ACCT_READER is None:
            _ACCT_READER = acct.AcctReader()
        svc = _ACCT_READER.type_service_time(tt) if tt else None
        if not svc or svc <= 0:

            svc = _ACCT_READER.global_service_time()
        svc = svc if (svc and svc > 0) else eta.DEFAULT_SEED_SVC_S
        proj = eta.project_eta(pos, svc, CFG.max_concurrent)
        proj["waiting_on"] = wait
        proj["svc_s"] = svc
        proj["human"] = eta.human(proj["eta_done_s"])
        proj["human_start"] = eta.human(proj["eta_start_s"])

        wr = _wait_reason_for(jid)
        if wr:
            proj["wait_reason"] = wr
            proj["wait_reason_de"] = _wait_reason_de(wr)
            if proj.get("waiting_on") in ("dispatching", "position"):
                proj["waiting_on"] = "resource"

        try:
            _kp_prof = ResourceProfile.from_json((job or {}).get("profile") or "")
            _kk = int(getattr(_kp_prof, "kerne", 0) or 0)
            if _kk and (job or {}).get("state") == "queued":
                _now = time.time()
                _kcx = cx if cx is not None else CX
                _snapshot = _kern_snapshot(now=_now)
                _running, _queued = _kern_rows(_kcx, now=_now)
                _me = next((r for r in _queued if r["id"] == jid), None)
                _ahead = _kern_ahead(_snapshot, _queued,
                                     before_key=_kern_eff_key(_me, _now) if _me else None,
                                     now=_now)
                _jd = {"env": (job or {}).get("env"),
                       "client_tag": (job or {}).get("client_tag")}
                _elig = _kern_eligibility(_snapshot, (job or {}).get("node"), _jd)
                _kp = kernslots.projektion(_snapshot, _elig, _running, _ahead, _kk, now=_now)
                proj["kerne"] = _kk
                _kw = int(getattr(_kp_prof, "kerne_wunsch", 0) or 0)
                if _kw and _kw != _kk:
                    proj["kerne_wunsch"] = _kw
                _own = float(getattr(_kp_prof, "dauer_s", 0) or 0) or float(proj.get("svc_s") or 0)
                if _kp["status"] == "sofort":
                    proj["eta_start_s"] = 0.0
                    proj["eta_done_s"] = _own if _own > 0 else None
                    proj["human_start"] = "sofort"
                    if _own > 0:
                        proj["human"] = eta.human(_own)
                elif _kp["status"] == "eta":
                    proj["eta_start_s"] = _kp["eta_s"]
                    proj["eta_done_s"] = (_kp["eta_s"] + _own) if _own > 0 else None
                    proj["human_start"] = eta.human(_kp["eta_s"])
                    proj["human"] = (eta.human(proj["eta_done_s"])
                                     if proj["eta_done_s"] else eta.human(_kp["eta_s"]))
                    proj["waiting_on"] = "kern-slots"
                else:
                    proj["eta_start_s"] = proj["eta_done_s"] = None
                    proj["human"] = proj["human_start"] = "unbekannt"
                    proj["waiting_on"] = "kern-slots"
                    if _kp.get("grund"):
                        proj["eta_grund"] = _kp["grund"]
        except Exception:
            pass

        try:
            _p = ResourceProfile.from_json((job or {}).get("profile") or "")
            _tot = meters.meminfo().get("total") or 0
            _ceil = max(0, _tot - CFG.mem_floor)
            if _tot and _p.mem > _ceil:
                proj["eta_start_s"] = proj["eta_done_s"] = None
                proj["human"] = proj["human_start"] = "nie (passt nicht auf diese Box)"
                proj["waiting_on"] = "unfit"
                proj["wait_reason"] = ("mem %d MiB exceeds box capacity "
                                       "(%d total - %d floor)" % (_p.mem, _tot, CFG.mem_floor))
                proj["wait_reason_de"] = ("passt nicht auf diese Box: braucht %d MiB RAM, "
                                          "diese Box kann höchstens %d MiB bereitstellen "
                                          "(%d MiB gesamt) — Job abbrechen oder kleiner "
                                          "deklarieren" % (_p.mem, _ceil, _tot))
        except Exception:
            pass
        return proj
    except Exception:
        return None

def _wait_reason_de(reason):

    r = str(reason or "")
    m = re.match(r"(batch|interactive) budget (\d+)\+(\d+)>(\d+)", r)
    if m:
        lane = "Batch" if m.group(1) == "batch" else "Echtzeit"
        free = max(0, int(m.group(4)) - int(m.group(2)))
        return ("wartet auf RAM: braucht %s MiB, im %s-Budget sind nur noch %d MiB frei (%s)"
                % (m.group(3), lane, free, r))
    m = re.match(r"mem floor (\d+)-(\d+)<(\d+)", r)
    if m:
        return ("wartet auf freien Arbeitsspeicher der Box: braucht %s MiB, verfügbar %s MiB "
                "bei Untergrenze %s MiB (%s)" % (m.group(2), m.group(1), m.group(3), r))
    if r.startswith("llm pool") or r.startswith("filler llm pool"):
        return "wartet auf freie LLM-Kapazität (%s)" % r
    if r.startswith("cpu budget") or r.startswith("filler cpu"):
        return "wartet auf freie CPU-Kerne (%s)" % r
    m = re.match(r"kern-slots (\S+): (-?\d+) von (\d+) buchbaren Kernen frei, (\d+) gebucht", r)
    if m:
        return ("wartet auf %s gebuchte Kerne: auf %s sind nur %s von %s buchbaren frei (%s)"
                % (m.group(4), m.group(1), m.group(2), m.group(3), r))
    if r.startswith("kern-slots"):
        return "wartet auf gebuchte Kerne (%s)" % r
    if r.startswith("disk_free") or r.startswith("filler disk"):
        return "wartet auf freien Plattenplatz (%s)" % r
    if (r.startswith("max_concurrent") or r.startswith("batch slots")
            or r.startswith("filler_cap")):
        return "wartet auf einen freien Ausführungs-Slot (%s)" % r
    if r.startswith("machine unhealthy") or r == "filler yields under pressure":
        return "wartet: Box unter Speicherdruck (%s)" % r
    if r.startswith("batch tier throttled"):
        return "wartet: Batch-Spur gedrosselt (%s)" % r
    if r.startswith("admission paused"):
        return "wartet: Job-Annahme ist vom Admin pausiert"
    return "wartet: %s" % r

def _wait_reason_for(jid):

    return WAIT_REASONS["jobs"].get(jid) or WAIT_REASONS.get("global")

def _attach_wait_reasons(jobs):

    now = time.time()
    for j in jobs or []:
        if j.get("state") == "queued":
            nb = j.get("not_before")
            if nb and nb > now:
                att = int(j.get("attempts") or 0)
                j["wait_reason"] = "backoff (attempt %d, retry in %ds)" % (att, int(nb - now))
                j["wait_reason_de"] = ("Backoff nach Fehlversuch %d: nächster Anlauf in %d s "
                                       "(%s)" % (att, int(nb - now),
                                                 j.get("fail_class") or "transient"))
                continue
            wr = _wait_reason_for(j.get("id"))
            if wr:
                j["wait_reason"] = wr
                j["wait_reason_de"] = _wait_reason_de(wr)
    return jobs

def _attach_kerne(jobs):

    for j in jobs or []:
        p = j.get("profile")
        if not p or '"kerne"' not in p:
            continue
        try:
            d = json.loads(p)
        except (ValueError, TypeError):
            continue
        k = d.get("kerne")
        if not k:
            continue
        j["kerne"] = k
        if d.get("kerne_wunsch") and d["kerne_wunsch"] != k:
            j["kerne_wunsch"] = d["kerne_wunsch"]
        if d.get("dauer_s"):
            j["dauer_s"] = d["dauer_s"]
    return jobs

def _kern_status_snapshot(rcx):

    try:
        snap = _kern_snapshot()
        run = [r for r in db.kern_buchungen(rcx) if r["state"] == "running"]
        frei = kernslots.frei_je_node(snap, run)
        return {("box" if n is None else n): {
                    "buchbar": e["buchbar"],
