_FC_NODE_SLOTS_ENV = (os.environ.get("PN_NODE_SLOTS", "") or "").strip()
_FC_NODE_SLOTS_PER_NODE = 4
_FC_NODE_SLOTS_MAX = 64

def _node_slots(workers):

    if _FC_NODE_SLOTS_ENV:
        try:
            return max(0, int(_FC_NODE_SLOTS_ENV))
        except ValueError:
            pass
    n = sum(1 for r in (workers or {}).values()
            if r and r.get("state") == "online" and r.get("endpoint"))

    return min(_FC_NODE_SLOTS_MAX, max(4, _FC_NODE_SLOTS_PER_NODE * n))

def _node_lane_full(rtc, workers, waits, job):

    cap = _node_slots(workers)
    cur = int((rtc or {}).get("node", 0))
    if cur >= cap:
        waits[job["id"]] = "node lane full (%d/%d proxies in flight)" % (cur, cap)
        return True
    return False

def _fc_log(msg):
    line = "%s %s\n" % (time.strftime("%Y-%m-%dT%H:%M:%S"), msg)
    try:
        sys.stderr.write(line)
        sys.stderr.flush()
    except Exception:
        pass
    try:
        with open(_FC_LOG_PATH, "a") as f:
            f.write(line)
    except Exception:
        pass

def _fleet_offloadable(job):

    if job.get("node"):
        return False
    tt = (job.get("task_type") or "").lower()
    if tt in _FC_INTERACTIVE_TT:
        return False

    try:
        if ResourceProfile.from_json(job.get("profile") or "").sandbox == "cell_isolated":
            return False
    except Exception:
        return False
    if _FC_MODE == "enforce" and not _fleet_marked_portable(job):
        return False
    return True

def _fleet_assign(job, workers, inflight, boxload, nproc, mem_avail=None, mem_total=None):

    if _FC_MODE == "off" or not workers or not _fleet_offloadable(job):
        return
    try:
        nid = fleetpick.pick_compute_node(workers, _FC_KIND, boxload, nproc,
                                          reserved_cores=_FC_RESERVE, inflight=inflight,
                                          now=time.time(), box_arch=_FC_BOX_ARCH,
                                          arch_ok=_fleet_arch_agnostic(job),
                                          box_mem_avail_mb=mem_avail,
                                          box_mem_total_mb=mem_total)
        if not nid:
            inflight[None] = inflight.get(None, 0) + 1
            return
        inflight[nid] = inflight.get(nid, 0) + 1
        jid = job.get("id")
        if _FC_MODE == "enforce":
            job["node"] = nid
            try:
                db.assign_node(CX, jid, nid, rdisp.PROXY_MEM_MIB)
            except Exception:
                pass
            _fc_log("[fleet-compute] job %s -> node %s (enforce, box_load=%.2f/%d, reserve=%d)"
                    % (jid, nid, boxload, nproc, _FC_RESERVE))
        else:
            now = time.time()
            if now - _FC_SHADOW_SEEN.get(jid, 0.0) > 300:
                if len(_FC_SHADOW_SEEN) > 500:
                    _FC_SHADOW_SEEN.clear()
                _FC_SHADOW_SEEN[jid] = now
                _fc_log("[fleet-compute:shadow] job %s WÜRDE auslagern -> node %s "
                        "(box_load=%.2f/%d, reserve=%d)" % (jid, nid, boxload, nproc, _FC_RESERVE))
    except Exception as e:
        try:
            sys.stderr.write("[fleet-compute] assign skipped: %s\n" % type(e).__name__)
        except Exception:
            pass

def _kern_snapshot(workers=None, now=None):

    w = rdisp.load_workers() if workers is None else workers
    return kernslots.nodes_snapshot(w, os.cpu_count() or 1, _FC_RESERVE,
                                    kind=_FC_KIND, box_arch=_FC_BOX_ARCH,
                                    now=time.time() if now is None else now)

def _kern_eligibility(snapshot, node_pin, jobdict):

    if node_pin:
        return [node_pin] if node_pin in snapshot else []
    portable = (_FC_MODE == "enforce" and _fleet_marked_portable(jobdict))
    return kernslots.eligible_nodes(snapshot, portable=portable,
                                    arch_ok=_fleet_arch_agnostic(jobdict),
                                    box_arch=_FC_BOX_ARCH)

def _kern_eff_key(r, now):

    return (r["prio"] - int((now - (r["submitted_at"] or now)) // 600), r["id"])

def _kern_rows(cx, now=None):

    now = now or time.time()
    rows = db.kern_buchungen(cx)
    running = [{"node": r["node"], "kerne": r["kerne"],
                "rest_s": kernslots.rest_s(r["started_at"], r["dauer_s"], now)}
               for r in rows if r["state"] == "running"]
    queued = sorted((r for r in rows if r["state"] == "queued"),
                    key=lambda r: _kern_eff_key(r, now))
    return running, queued

def _kern_ahead(snapshot, queued, before_key=None, now=None):

    now = now or time.time()
    out = []
    for r in queued:
        if before_key is not None and _kern_eff_key(r, now) >= before_key:
            continue
        jd = {"env": r["env"], "client_tag": r["client_tag"]}
        out.append({"kerne": r["kerne"], "dauer_s": r["dauer_s"],
                    "eligible": _kern_eligibility(snapshot, r["node"], jd)})
    return out

def _kern_submit_pruefung(req, ctx, prof, node):

    raw = req.get("kerne")
    try:
        wunsch = int(raw)
    except (TypeError, ValueError):
        return {"ok": False, "reason": "kerne-ungueltig",
                "error": "kerne muss eine ganze Zahl >= 1 sein (bekommen: %r)" % (raw,)}, None
    if wunsch < 1:
        return {"ok": False, "reason": "kerne-ungueltig",
                "error": "kerne muss >= 1 sein (bekommen: %d)" % wunsch}, None

    if str(req.get("source") or "") == "filler":
        return {"ok": False, "reason": "kerne-unzulaessig",
                "error": "Filler-Jobs buchen keine Kerne (Backfill läuft nur in Lücken)"}, None
    _tt_iso = None
    if ctx.get("task_type"):
        _tt_iso = (db.get_task_type(CX, ctx["task_type"]) or {}).get("isolation_tier")
    if sched.track_of(prof) == "interactive" or getattr(prof, "trusted", False) or _tt_iso == "cell":
        return {"ok": False, "reason": "kerne-unzulaessig",
                "error": ("Kern-Buchung gilt nur für Batch-Jobs — interaktive/Session/Zell-"
                          "Profile bekommen nie eine harte cpu.max-Quote (Doktrin).")}, None
    flex = bool(req.get("flexibel"))
    now = time.time()
    snapshot = _kern_snapshot(now=now)
    jd = {"env": json.dumps(req.get("env") or {}), "client_tag": req.get("tag")}
    elig = _kern_eligibility(snapshot, node, jd)
    running, queued = _kern_rows(CX, now=now)
    ahead = _kern_ahead(snapshot, queued, now=now)
    ang = kernslots.angebot(snapshot, elig, running, ahead, wunsch, now=now)
    proj = kernslots.projektion(snapshot, elig, running, ahead, wunsch, now=now)
    gebucht = wunsch
    if flex and proj["status"] != "sofort":
        d = kernslots.downgrade_kerne(ang, wunsch)
        if d:
            gebucht = d
            proj = kernslots.projektion(snapshot, elig, running, ahead, d, now=now)
    absagen, grund = kernslots.absage_pruefen(proj)
    if absagen:
        return {"ok": False, "reason": "kerne-absage",
                "error": ("Kern-Buchung über %d Kern(e) abgesagt: %s. Alternativangebot "
                          "siehe `angebot` — kleinere Buchungen starten ggf. sofort."
                          % (gebucht, grund)),
                "angebot": ang}, None
    return None, {"kerne": gebucht, "wunsch": wunsch, "flexibel": flex,
                  "projektion": proj, "angebot": ang}

def _kern_antwort(buchung):

    p = buchung["projektion"]
    e = {"status": p["status"], "eta_s": p.get("eta_s"),
         "human": ("sofort" if p["status"] == "sofort"
                   else eta.human(p["eta_s"]) if p["status"] == "eta" else p["status"])}
    if p.get("grund"):
        e["grund"] = p["grund"]
    return {"kerne": {"gebucht": buchung["kerne"], "wunsch": buchung["wunsch"],
                      "flexibel": buchung["flexibel"], "eta": e},
            "angebot": buchung["angebot"]}

