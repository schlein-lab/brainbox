def detect_io_delegation() -> bool:
    cg = meters.cgroup_path("pn-batch.slice")
    if not cg:
        return False
    try:

        parent = os.path.dirname(cg)
        with open(os.path.join(parent, "cgroup.controllers")) as f:
            return "io" in f.read().split()
    except Exception:
        return False

def sd_notify(msg: str):
    addr = os.environ.get("NOTIFY_SOCKET")
    if not addr:
        return
    if addr[0] == "@":
        addr = "\0" + addr[1:]
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        s.sendto(msg.encode(), addr)
        s.close()
    except Exception:
        pass

