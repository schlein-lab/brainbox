    return {pf: req.get(rk) for pf, rk in _OVR_FIELDS}

def _trusted_posture_allowed(ctx):

    tt_name = ctx.get("task_type")
    if tt_name:
        klass = (db.get_task_type(CX, tt_name) or {}).get("klass")
        base = CLASSES.get(klass) if klass else None
        return bool(base is not None and getattr(base, "trusted", False))

    return bool((ctx.get("caps") or set()) & db.WILDCARD_CAPS)

def authorize_submit(req):

    ctx = _resolve_principal(req)
    principal, caps = ctx["principal"], ctx["caps"]
    tt_name = req.get("task_type")

    if tt_name:
        allowed = (f"task_type:{tt_name}" in caps or "task_type:*" in caps
                   or "task.raw" in caps)
        if not allowed:
            raise AuthzError(f"principal '{principal or 'unknown'}' may not run "
                             f"task_type '{tt_name}'")
        tt = db.get_task_type(CX, tt_name)
        if not tt:
            raise AuthzError(f"unknown task_type '{tt_name}'")
        template = json.loads(tt["cmd_template"])
        schema = json.loads(tt["params_schema"] or "{}")
        params = req.get("params") or {}
        unknown = set(params) - set(schema)
        if unknown:
            raise AuthzError(f"unknown params for '{tt_name}': {sorted(unknown)}")
        sub = {}
        for pname, ptyp in schema.items():
            if pname not in params:
                raise AuthzError(f"missing param '{pname}' for task_type '{tt_name}'")
            sub[pname] = _coerce_param(pname, ptyp, params[pname])

        argv = []
        for elem in template:
            if not isinstance(elem, str):
                raise AuthzError(f"task_type '{tt_name}' template element {elem!r} is not a string")
            argv.append(_PH.sub(lambda m: sub[m.group(1)] if m.group(1) in sub else m.group(0), elem))
        return argv, {**ctx, "task_type": tt_name}

    cmd = req.get("cmd") or req.get("argv")
    if cmd is None:
        raise AuthzError("submit requires either 'task_type' or a raw 'cmd'")
    if "task.raw" not in caps:
        raise AuthzError(f"principal '{principal or 'unknown'}' may not submit raw commands "
                         f"(needs capability task.raw)")
    return cmd, {**ctx, "task_type": None}

def _resolve_caller(req, cx=None):

    ctx = _resolve_principal(req, cx=cx)
    return ctx["principal"], (ctx.get("caps") or set()), ctx.get("is_broker", False)

def view_all_for(ctx):

    return "view:all" in (ctx.get("caps") or set())

def enforce_attenuation(ctx, parent_job):

    if parent_job is None:
        return None

    view_all = "view:all" in (ctx.get("caps") or set())
    parent = db.get(CX, int(parent_job), principal=ctx.get("principal"), scope_all=view_all)
    if not parent:
        raise AuthzError(f"parent_job {parent_job} unknown or not owned by "
                         f"'{ctx.get('principal') or 'unknown'}'")

    raw = parent.get("caps")
    if raw:
        try:
            parent_caps = set(json.loads(raw))
        except (ValueError, TypeError):
            parent_caps = db.caps_for(CX, parent.get("submitter_principal"))
    else:
        parent_caps = db.caps_for(CX, parent.get("submitter_principal"))
    child_caps = set(ctx.get("caps") or set())

    escalation = child_caps - parent_caps
    if escalation:
        raise AuthzError(
            f"attenuation violation: child caps {sorted(escalation)} ⊄ parent_job "
            f"{parent_job} caps {sorted(parent_caps)} (a sub-task may never exceed its parent)")
    return parent

def dag_fields(req):

    deps = req.get("deps")
    dep_ids = []
    if deps:
        if not isinstance(deps, (list, tuple)):
            raise AuthzError("deps must be a list of job ids")
        for d in deps:
            try:
                dep_ids.append(int(d))
            except (TypeError, ValueError):
                raise AuthzError(f"bad dep id {d!r} (must be an int job id)")
    group_id = req.get("group_id")
    parent_job = req.get("parent_job")
    if parent_job is not None:
        try:
            parent_job = int(parent_job)
        except (TypeError, ValueError):
            raise AuthzError(f"bad parent_job {parent_job!r}")
    return dep_ids, group_id, parent_job

def validate_deps_ownership(ctx, dep_ids):

    view_all = "view:all" in (ctx.get("caps") or set())
    for d in dep_ids:
        if db.get(CX, d, principal=ctx.get("principal"), scope_all=view_all) is None:
            raise AuthzError(f"dep job {d} unknown or not visible to "
                             f"'{ctx.get('principal') or 'unknown'}'")

def validate_group_ownership(ctx, group_id):

    if not group_id:
        return
    if "view:all" in (ctx.get("caps") or set()):
        return
    principal = ctx.get("principal")
    r = CX.execute("SELECT 1 FROM jobs WHERE group_id=? AND submitter_principal<>? LIMIT 1",
                   (group_id, principal)).fetchone()
    if r:
        raise AuthzError("group_id belongs to another tenant")

SUB_POLL_S = 0.5
SUB_PING_S = 25.0

def _make_subscriber(principal, topics, after_id):

    def stream(conn, peer_uid):
        def send(obj):
            conn.sendall((json.dumps(obj, separators=(",", ":")) + "\n").encode())

        scx = db.connect_ro(DB_PATH)
        try:
            start = db.max_event_id(scx) if after_id is None else int(after_id)
            send({"ok": True, "type": "subscribed", "topics": topics,
                  "principal": principal, "cursor": start})
            cursor = start
            last_ping = time.time()
            while True:
                evs = db.events_since(scx, topics, after_id=cursor, limit=500) if topics else []
                if evs:
                    for e in evs:
                        send({"type": "event", "event": e})
                        cursor = max(cursor, e["id"])
                    last_ping = time.time()
                else:

                    if time.time() - last_ping >= SUB_PING_S:
                        send({"type": "ping", "cursor": cursor})
                        last_ping = time.time()
                    time.sleep(SUB_POLL_S)
        finally:
            try:
                scx.close()
            except Exception:
                pass
    return stream

READ_VERBS = frozenset({
    "events", "pending", "cvm", "replay", "subscribe", "job", "eta", "list", "my-jobs",
    "via-inflight", "my-history", "my-outputs", "whereis", "group", "result", "handoff",
    "status", "log", "get-approval-prefs",
})

def _handle_read(req, verb):

    rcx = db.connect_ro(DB_PATH)
    try:
        try:
            caller, caller_caps, _is_broker = _resolve_caller(req, cx=rcx)
        except AuthzError as e:
            return {"ok": False, "error": str(e)}
        view_all = "view:all" in caller_caps

        read_scope = view_all or ("approval:resolve" in caller_caps)

        if verb == "get-approval-prefs":
            prefs = db.get_approval_prefs(rcx, caller)
            wildcard = "task_type:*" in caller_caps
            avail = []
            for row in rcx.execute("SELECT name, klass, approval FROM task_types ORDER BY name"):
                name = row["name"]
                if not (wildcard or ("task_type:%s" % name) in caller_caps):
                    continue
                base = row["approval"] or "none"
                avail.append({
                    "name": name, "klass": row["klass"], "default": base,
                    "pref": prefs.get(name),
                    "effective": db.effective_approval(rcx, caller, name, base),
                    "lowerable": db.APPROVAL_STRENGTH.get(base, 0) == 0,
                })
            return {"ok": True, "principal": caller, "prefs": prefs, "available": avail}
        if verb == "events":
            if not db.get(rcx, req.get("id"), principal=caller, scope_all=read_scope):
                return {"ok": False, "error": "no such job"}
            return {"ok": True, "events": db.events(
                rcx, req["id"], _clamp_limit(req.get("limit"), default=200),
                principal=caller, scope_all=read_scope)}

        if verb == "pending":

            return {"ok": True, "pending": db.pending_approvals(
                rcx, principal=caller, scope_all=read_scope,
                limit=_clamp_limit(req.get("limit"), default=100)),
                "now": time.time()}

        if verb == "cvm":
            c = db.cvm(rcx, req.get("id"), principal=caller, scope_all=read_scope)
            if not c:
                return {"ok": False, "error": "no such job"}
            return {"ok": True, "cvm": c}

        if verb == "replay":
            req_topics = req.get("topics") or ([f"job/{req['id']}"] if req.get("id") else [])
            topics = db.authorize_topics(rcx, caller, req_topics, scope_all=view_all)
            evs = db.events_since(rcx, topics, after_id=req.get("after_id", 0),
                                  limit=_clamp_limit(req.get("limit"), default=500))
            return {"ok": True, "events": evs, "topics": topics,
                    "cursor": db.max_event_id(rcx)}

        if verb == "subscribe":
            req_topics = req.get("topics") or ([f"job/{req['id']}"] if req.get("id") else [])
            topics = db.authorize_topics(rcx, caller, req_topics, scope_all=view_all)
            after = req.get("after_id")
            stream = _make_subscriber(caller, topics, after)
            return {"_stream": stream}
        if verb == "job":
            j = db.get(rcx, req["id"], principal=caller, scope_all=view_all)
            if not j:
                return {"ok": False, "error": "no such job"}
            out = {"ok": True, "job": j, "pos": db.position(rcx, req["id"]),
                   "eta": job_eta(req["id"], j, cx=rcx),
                   "now": time.time(), "stall_s": STALL_S}

            if req.get("events"):
                out["events"] = db.events(
                    rcx, req["id"], _clamp_limit(req.get("events"), default=200),
                    principal=caller, scope_all=view_all)
            return out
        if verb == "eta":
            j = db.get(rcx, req["id"], principal=caller, scope_all=view_all)
            if not j:
                return {"ok": False, "error": "no such job"}
            return {"ok": True, "id": req["id"], "state": j.get("state"),
                    "eta": job_eta(req["id"], j, cx=rcx), "now": time.time()}
        if verb == "list":

            lim = _clamp_limit(req.get("limit"), default=50)
            cursor = req.get("continue")
            jobs = _attach_wait_reasons(db.list_recent(
                rcx, lim, principal=caller, scope_all=view_all, before_id=cursor))
            nxt = min((j["id"] for j in jobs), default=None) if len(jobs) >= lim else None

            jobs = _project_rows(_attach_kerne(jobs), req.get("fields"), req.get("cmd_max"))
            return {"ok": True, "jobs": jobs, "counts": db.counts(rcx),
                    "next_cursor": nxt, "now": time.time(), "stall_s": STALL_S}
        if verb == "my-jobs":
            lim = _clamp_limit(req.get("limit"), default=50)
            jobs = _attach_kerne(_attach_wait_reasons(db.jobs_for_principal(
                rcx, caller, state=req.get("state"), via_device=req.get("via"),
                limit=lim, before_id=req.get("continue"))))
            nxt = min((j["id"] for j in jobs), default=None) if len(jobs) >= lim else None
            return {"ok": True, "jobs": jobs, "next_cursor": nxt,
                    "now": time.time(), "stall_s": STALL_S}

        if verb == "via-inflight":
            did = req.get("via_device") or req.get("_selector")
            n = db.count_inflight_via_device(rcx, caller, did)
            return {"ok": True, "in_flight": n, "via_device": did, "principal": caller}
        if verb == "my-history":
            j = db.get(rcx, req["id"], principal=caller, scope_all=view_all)
            if not j:
                return {"ok": False, "error": "no such job"}
            return {"ok": True, "job": j,
                    "events": db.events(rcx, req["id"],
                                        _clamp_limit(req.get("limit"), default=200),
                                        principal=caller, scope_all=view_all)}
        if verb == "my-outputs":
            return {"ok": True, "outputs": db.outputs_for_principal(
                rcx, caller, since=req.get("since"),
                limit=_clamp_limit(req.get("limit"), default=200))}
        if verb == "whereis":

            w = db.whereis(rcx, req["id"], principal=caller, scope_all=view_all)
            if not w:
                return {"ok": False, "error": "no such job"}
            return {"ok": True, "whereis": w}

        if verb == "group":
            gs = db.group_status(rcx, req.get("group_id"), principal=caller, scope_all=view_all)
            if not gs:
                return {"ok": False, "error": "no such group"}
            return {"ok": True, "group": gs}

        if verb == "result":
            rv = db.result_view(rcx, req["id"], principal=caller, scope_all=view_all)
            if not rv:
                return {"ok": False, "error": "no such job"}
            return {"ok": True, "result": rv}
        if verb == "handoff":
            j = db.get(rcx, req["id"], principal=caller, scope_all=view_all)
            if not j:
                return {"ok": False, "error": "no such job"}
            deps = db._deps_of(j)
            return {"ok": True, "handoff": db.handoff_refs(
                rcx, deps, principal=caller, scope_all=view_all), "deps": deps}
        if verb == "status":
            snap = meters.snapshot()
            return {"ok": True, "snap": snap, "counts": db.counts(rcx),
                    "reserved": db.reserved_mib(rcx), "oldest_wait": db.oldest_wait(rcx),
                    "reserved_batch": db.reserved_mib(rcx, track="batch"),
                    "reserved_interactive": db.reserved_mib(rcx, track="interactive"),
                    "running_tracks": db.running_track_counts(rcx),
                    "kern_slots": _kern_status_snapshot(rcx),
                    "wait_global": WAIT_REASONS.get("global"),
                    "wait_reasons": dict(WAIT_REASONS.get("jobs") or {}),
                    "pressure_blocked": GATE.blocked, "now": time.time(),
                    "cfg": {"mem_floor": CFG.mem_floor, "batch_high": CFG.batch_high,
                            "max_concurrent": CFG.max_concurrent, "psi_stop": CFG.psi_stop,
                            "io_enabled": IO_ENABLED, "stall_s": STALL_S},
                    "uptime": time.time() - STARTED, "version": VERSION}
        if verb == "log":

            j = db.get(rcx, req["id"], principal=caller, scope_all=view_all)
            if not j:
                return {"ok": False, "error": "no such job"}
            out, err, _ = out_err_rc_for(req["id"])
            nbytes = _clamp_limit(req.get("bytes", 8000), default=8000, cap=MAX_LOG_BYTES)
            return {"ok": True, "stdout": _tail_file(out, nbytes),
                    "stderr": _tail_file(err, nbytes),
                    "out_path": out, "err_path": err}
        return {"ok": False, "error": f"unknown verb {verb}"}
    finally:
        try:
            rcx.close()
        except Exception:
            pass

def handle(req):
    verb = req.get("verb")

    if verb == "ping":
        return {"ok": True, "version": VERSION, "pid": os.getpid(),
                "uptime": time.time() - STARTED}

    if verb in READ_VERBS:
        try:
            return _handle_read(req, verb)
        except Exception as e:
            return {"ok": False, "error": f"read lane: {type(e).__name__}: {e}"}
    with LK:
        if verb == "ping":
            return {"ok": True, "version": VERSION, "pid": os.getpid(),
                    "uptime": time.time() - STARTED}
        if verb in ("session-attach", "session-turn", "session-detach"):

            return _session_verbs(req, verb)
        if verb == "submit":

            try:
                cmd, ctx = authorize_submit(req)

                dep_ids, group_id, parent_job = dag_fields(req)
                validate_deps_ownership(ctx, dep_ids)
                validate_group_ownership(ctx, group_id)
                enforce_attenuation(ctx, parent_job)
            except AuthzError as e:
                return {"ok": False, "error": str(e)}

            _pol = db.get_policy(CX, ctx["principal"])
            if not int(_pol.get("submit_enabled", 1) or 0):
                return {"ok": False, "reason": "submit-suspended",
                        "error": "Einreichen durch Admin gesperrt%s" % (
                            (": " + str(_pol["submit_reason"])) if _pol.get("submit_reason") else "")}
            _msj = _pol.get("max_submit_jobs")
            if _msj is not None:
                _inflight = len(db.nonterminal_for_principal(CX, ctx["principal"]))
                if _inflight >= int(_msj):
                    return {"ok": False, "reason": "quota",
                            "error": ("Job-Kontingent erreicht (%d/%d gleichzeitig) — warte, bis "
                                      "laufende Jobs fertig sind." % (_inflight, int(_msj)))}

            node = (str(req.get("node") or "").strip() or None)
            if node:
                _w = rdisp.get_worker(node)
                if _w is None:
                    return {"ok": False, "error": f"unknown worker node '{node}' "
                            f"(not registered in workers.json — POST /api/workers/register first)"}
                _nerr = rdisp.caps_cover(_w, "process")
                if _nerr:
                    return {"ok": False, "error": _nerr}

            _ovr = _scheduling_overrides(req, ctx)
            if ctx.get("task_type"):
                tt_def = db.get_task_type(CX, ctx["task_type"]) or {}
                prof = estimate(tt_def.get("klass") or req.get("class"),
                                template_patch=tt_def.get("profile_template"),
                                history=acct_history(ctx["task_type"]), **_ovr)
            else:

                prof = estimate(req.get("class"), history=acct_history(_cmd_type_of(cmd)),
                                **_ovr)

            if getattr(prof, "trusted", False) and not _trusted_posture_allowed(ctx):
                prof.trusted = False

            _undeclared_cap = None
            if (not ctx.get("task_type") and not req.get("class")
                    and req.get("mem") is None and req.get("mem_max") is None
                    and prof.mem_max is None and not getattr(prof, "trusted", False)):
                _env_cap = os.environ.get("PN_UNDECLARED_MEM_MAX", "").strip()
                _undeclared_cap = (int(_env_cap) if _env_cap.isdigit()
                                   else max(1024, prof.mem * 2))
                prof.mem_max = _undeclared_cap

            _kbuch = None
            if req.get("dauer_s") is not None:
                try:
                    _dv = int(req["dauer_s"])
                    if _dv > 0:
                        prof.dauer_s = _dv
                except (TypeError, ValueError):
                    return {"ok": False, "reason": "dauer-ungueltig",
                            "error": "dauer_s muss eine ganze Zahl > 0 sein (bekommen: %r)"
                                     % (req.get("dauer_s"),)}
            if req.get("kerne") is not None:
                _kerr, _kbuch = _kern_submit_pruefung(req, ctx, prof, node)
                if _kerr:
                    return _kerr
                prof.kerne = _kbuch["kerne"]
                prof.kerne_wunsch = _kbuch["wunsch"]
                prof.flexibel = bool(_kbuch["flexibel"])
                prof.cpu_quota_pct = int(prof.kerne) * 100

            _bias = int(db.get_policy(CX, ctx["principal"]).get("prio_bias") or 0)
            if _bias:
                prof.prio = max(0, min(300, int(prof.prio) + _bias))
            _ok, _err, _adv, _delta = _fairshare_admit(req, ctx, prof, CX)
            if not _ok:
                return {"ok": False, "error": _err, "advice": _adv, "reason": "fairshare"}
            if _delta:
                prof.prio = max(0, min(300, int(prof.prio) + _delta))

            if not node:
                _tot = meters.meminfo().get("total") or 0
                _ceil = max(0, _tot - CFG.mem_floor)
                if _tot and prof.mem > _ceil:
                    return {"ok": False, "reason": "unfit",
                            "error": ("Der Job braucht ~%d MiB RAM, diese Box kann höchstens "
                                      "~%d MiB bereitstellen (%d MiB gesamt, %d MiB System-"
                                      "Untergrenze) — auf dieser Box nicht ausführbar. Kleiner "
                                      "deklarieren (--mem) oder auf einem größeren Worker "
                                      "einreichen (--node)."
                                      % (prof.mem, _ceil, _tot, CFG.mem_floor))}
                try:
                    _st = os.statvfs(DATA_DIR)
                    _disk_tot = (_st.f_blocks * _st.f_frsize) // (1024 * 1024)
                except OSError:
                    _disk_tot = None
                if _disk_tot and prof.disk_min_free > _disk_tot:
                    return {"ok": False, "reason": "unfit",
                            "error": ("Der Job verlangt %d MiB freien Plattenplatz, das Daten-"
                                      "Volume dieser Box ist insgesamt nur %d MiB groß — auf "
                                      "dieser Box nicht ausführbar."
                                      % (prof.disk_min_free, _disk_tot))}
            cwd = req.get("cwd") or os.path.expanduser("~")

            eff_source = _validate_source(req, ctx)

            jid = db.submit(CX, cmd, cwd, req.get("env"), prof.to_json(),
                            prof.prio, (rdisp.PROXY_MEM_MIB if node else prof.mem),
                            req.get("tag"),
                            node=node,
                            room=req.get("room"), source=eff_source,
                            principal=ctx["principal"], task_type=ctx["task_type"],
                            submitter_principal=ctx["principal"],
                            via_device=ctx.get("via_device"), via_method=ctx.get("via_method"),

                            reply_to=req.get("reply_to"),

                            deps=dep_ids, group_id=group_id, parent_job=parent_job,
                            caps=ctx.get("caps") or set())
            if _undeclared_cap:

                db.add_event(CX, jid, "note",
                             "kein RAM deklariert -> konservativer Hard-Cap %d MiB "
                             "(memory.max, ohne Swap). Für größere Läufe --mem/--mem-max "
                             "deklarieren; wiederholte Läufe lernen ihre Größe automatisch "
                             "(cmd:-EWMA)." % _undeclared_cap)
            if _kbuch:

                _kp = _kbuch["projektion"]
                _keta = ("sofort" if _kp["status"] == "sofort"
                         else eta.human(_kp["eta_s"]) if _kp["status"] == "eta"
                         else _kp["status"])
                _note = ("Kern-Buchung: %d Kern(e) gebucht (cpu.max %d%%), Start-Einschätzung: %s."
                         % (_kbuch["kerne"], _kbuch["kerne"] * 100, _keta))
                if _kbuch["kerne"] != _kbuch["wunsch"]:
                    _note += (" flexibel-Zuteilung: Wunsch waren %d Kerne, sofort erfüllbar "
                              "waren %d — automatisch heruntergestuft."
                              % (_kbuch["wunsch"], _kbuch["kerne"]))
                if prof.dauer_s:
                    _note += (" Geplante Dauer %ds — reine Planungsgröße, KEIN Limit."
                              % int(prof.dauer_s))
                db.add_event(CX, jid, "note", _note)

            if req.get("work_order"):
                wo = dict(req["work_order"])
                wo["handoff"] = db.handoff_refs(CX, dep_ids, principal=ctx["principal"],
                                                scope_all=view_all_for(ctx))
                db.add_event(CX, jid, "workorder", wo)
            if dep_ids:

                tt = db.get_task_type(CX, ctx["task_type"]) if ctx["task_type"] else None
                ak = (tt.get("approval") if tt else None) or req.get("approval") or "none"

                ak = db.effective_approval(CX, ctx["principal"], ctx["task_type"], ak)
                if ak in ("post", "checkpoint"):
                    CX.execute("UPDATE jobs SET approval_kind=? WHERE id=?", (ak, jid))
                    CX.commit()
                db.add_typed_event(CX, jid, "state",
                                   {"state": "blocked", "deps": dep_ids})
                return {"ok": True, "id": jid, "state": "blocked", "deps": dep_ids,
                        "group_id": group_id, "parent_job": parent_job,
                        "approval": ak if ak != "none" else None,
                        **(_kern_antwort(_kbuch) if _kbuch else {})}

            tt = db.get_task_type(CX, ctx["task_type"]) if ctx["task_type"] else None
            approval_kind = (tt.get("approval") if tt else None) or req.get("approval") or "none"

            approval_kind = db.effective_approval(CX, ctx["principal"], ctx["task_type"], approval_kind)
            needs_conf = (bool(req.get("needs_confirmation"))
                          or bool(tt and tt.get("needs_confirmation")))
            pre_gate = (approval_kind == "pre") or needs_conf
            if pre_gate:
                nonce = secrets.token_urlsafe(18)
                kind = "pre" if approval_kind == "pre" else (approval_kind if approval_kind in
                                                             ("post", "checkpoint") else "pre")
                db.stage_for_approval(CX, jid, nonce, approval_kind="pre")

                ar = {"job_id": jid, "nonce": nonce, "gate": "pre",
                      "task_type": ctx["task_type"],
                      "summary": req.get("tag") or ctx["task_type"] or "raw command",
                      "action": {"argv": cmd, "side_effecting": approval_kind == "pre"},
                      "revise": {"count": 0, "max": 0}}

                if isinstance(req.get("_propose"), dict):
                    ar["proposal"] = req["_propose"]
                    ar["summary"] = req["_propose"].get("summary") or ar["summary"]
                db.add_typed_event(CX, jid, "approval-request", ar)
                return {"ok": True, "id": jid, "state": "staged", "nonce": nonce,
                        "needs_confirmation": True, "gate": "pre",
                        **(_kern_antwort(_kbuch) if _kbuch else {})}

            if approval_kind in ("post", "checkpoint"):
                CX.execute("UPDATE jobs SET approval_kind=? WHERE id=?", (approval_kind, jid))
                CX.commit()
            db.add_typed_event(CX, jid, "state", {"state": "queued"})
            return {"ok": True, "id": jid, "pos": db.position(CX, jid),
                    "eta": job_eta(jid, None),
                    "group_id": group_id, "parent_job": parent_job,
                    "approval": approval_kind if approval_kind != "none" else None,
                    **(_kern_antwort(_kbuch) if _kbuch else {})}

        if verb == "submit-dag":
            nodes = req.get("nodes")
            if not isinstance(nodes, list) or not nodes:
                return {"ok": False, "error": "submit-dag requires a non-empty 'nodes' list"}
            gid = req.get("group_id") or ("wf-" + secrets.token_urlsafe(8))

            ident = {k: req.get(k) for k in ("_peer_uid", "_method", "_selector", "via_device")}

            for i, node in enumerate(nodes):
                for d in (node.get("deps") or []):
                    if not isinstance(d, int) or d < 0 or d >= i:
                        return {"ok": False, "error": f"node {i}: local dep {d!r} must reference an "
                                f"EARLIER node (0..{i-1}) — the DAG must be acyclic/forward-only"}
            created = []
            local = {}
            for i, node in enumerate(nodes):
                real_deps = [local[d] for d in (node.get("deps") or [])]
                sub = dict(node)
                sub.update(ident)
                sub["verb"] = "submit"
                sub["deps"] = real_deps
                sub["group_id"] = gid

                if "parent_job" not in sub and req.get("parent_job") is not None:
                    sub["parent_job"] = req.get("parent_job")
                r = handle(sub)
                if not r.get("ok"):

                    for jid_done in created:
                        db.cancel_blocked_dep_failed(CX, jid_done)
                    return {"ok": False, "error": f"node {i} rejected: {r.get('error')}",
                            "rolled_back": created}
                local[i] = r["id"]
                created.append(r["id"])

            owner = db.group_owner(CX, gid)
            gs = db.group_status(CX, gid, principal=owner, scope_all=False)
            if owner and gs:
                db.add_typed_event(CX, created[0], "group-status", gs,
                                   topics=[db.group_topic(owner, gid)])
            return {"ok": True, "group_id": gid, "job_ids": created,
                    "node_map": local, "group": gs}

        try:
            caller, caller_caps, _is_broker = _resolve_caller(req)
        except AuthzError as e:
            return {"ok": False, "error": str(e)}
        view_all = "view:all" in caller_caps

        approver = "approval:resolve" in caller_caps
        read_scope = view_all or approver
        if verb == "progress":
            if not db.get(CX, req.get("id"), principal=caller, scope_all=view_all):
                return {"ok": False, "error": "no such job"}
            db.update_progress(CX, req["id"], done=req.get("done"),
                               total=req.get("total"), msg=req.get("msg"))
            db.add_typed_event(CX, req["id"], "progress",
                               {"done": req.get("done"), "total": req.get("total"),
                                "msg": req.get("msg")})
            return {"ok": True}
        if verb == "checkpoint":
            if not db.get(CX, req.get("id"), principal=caller, scope_all=view_all):
                return {"ok": False, "error": "no such job"}

            db.add_typed_event(CX, req["id"], req.get("kind") or "partial", req.get("data"))
            return {"ok": True}

        if verb == "steer":
            j = db.get(CX, req.get("id"), principal=caller, scope_all=view_all)
            if not j:
                return {"ok": False, "error": "no such job"}
            if j["state"] != "running":
                return {"ok": False, "error": f"job is {j['state']}, not running (cannot steer)"}
            ws = j.get("workspace_path") or record.workspace_path(j["id"])
            seq = db.enqueue_steer(CX, j["id"])
            try:
                path = record.write_steer(ws, seq, req.get("input"))
            except Exception as e:
                return {"ok": False, "error": f"steer write failed: {type(e).__name__}: {e}"}
            db.add_typed_event(CX, j["id"], "steer",
                               {"seq": seq, "input": req.get("input")})
            return {"ok": True, "seq": seq, "path": path}

        if verb in ("approve", "deny", "reject", "revise"):

            authorized = view_all or ("approval:resolve" in caller_caps)

            if (_is_broker and verb in ("approve", "deny", "reject")
                    and db.submitter_for_nonce(CX, req.get("nonce")) == caller):
                return {"ok": False,
                        "error": "a relayed device cannot self-approve its own submission "
                                 "(separation of duties)"}
            res = db.resolve_approval(CX, req.get("nonce"), verb,
                                      principal=caller, scope_all=authorized,
                                      feedback=req.get("feedback"))
            if not res.get("ok"):
                return res
            jid = res.get("id")

            if res.get("finalize") and not res.get("idempotent"):
                j = db.get(CX, jid, scope_all=True)
                term = finalize_approved(j) if j else None
                res["state"] = term or res.get("state")
                return res
            if res.get("idempotent"):
                return res

            if res.get("decision") == "revise":
                j = db.get(CX, jid, scope_all=True)
                ws = (j or {}).get("workspace_path") or record.workspace_path(jid)
                seq = db.enqueue_steer(CX, jid)
                fb = {"revise": True, "feedback": req.get("feedback"),
                      "revise_count": res.get("revise_count")}
                try:
                    record.write_steer(ws, seq, fb)
                except Exception as e:
                    db.add_event(CX, jid, "error",
                                 f"revise steer write failed: {type(e).__name__}: {e}")
                db.add_typed_event(CX, jid, "steer", {"seq": seq, "input": fb})
                db.add_typed_event(CX, jid, "approval-result",
                                   {"decision": "revise", "feedback": req.get("feedback"),
                                    "revise_count": res.get("revise_count")})
                db.add_typed_event(CX, jid, "state", {"state": "queued", "decision": "revise"})
                return res

            db.add_typed_event(CX, jid, "state",
                               {"state": res["state"], "decision": res["decision"]})
            if res["decision"] in ("rejected", "denied"):
                db.add_typed_event(CX, jid, "approval-result",
                                   {"decision": res["decision"], "state": res["state"]})
            return res

        if verb in ("egress-pending", "egress-approve", "egress-deny"):
            if not view_all:
                return {"ok": False, "error": "egress approval requires the human operator "
                        "(view:all); the brain cannot self-approve a new egress"}
            try:
                from pnlib import egress as _egress, DATA_DIR as _DD
                ecx = _egress.connect(os.environ.get(
                    "PN_EGRESS_DB", os.path.join(_DD, "egress", "allow.db")))
            except Exception as e:
                return {"ok": False, "error": f"egress store unavailable: {e}"}
            if verb == "egress-pending":
                pend = [dict(r) for r in ecx.execute(
                    "SELECT * FROM egress_pending WHERE state='pending' ORDER BY created_at").fetchall()]
                ecx.close()
                return {"ok": True, "egress_pending": pend}
            decision = "approve" if verb == "egress-approve" else "deny"
            res = _egress.resolve_proposal(ecx, req.get("nonce"), decision,
                                           approved_by=caller or "admin")
            ecx.close()
            return res
        if verb == "extend":

            j = db.get(CX, req.get("id"), principal=caller, scope_all=view_all)
            if not j:
                return {"ok": False, "error": "no such job"}
            if j["state"] != "running":
                return {"ok": False, "error": f"job is {j['state']}, not running (cannot extend)"}
            try:
                secs = int(req.get("seconds") or 0)
            except (TypeError, ValueError):
                secs = 0
            if secs <= 0:
                return {"ok": False, "error": "seconds must be a positive integer"}
            prof = ResourceProfile.from_json(j["profile"])
            already = j.get("walltime_extra_s") or 0.0
            if not view_all:
                if prof.max_extend_s <= 0:
                    return {"ok": False, "error": "self-service extension not allowed for this job "
                                                  "class — ask an admin"}
                if already + secs > prof.max_extend_s:
                    return {"ok": False, "error": f"extension cap reached "
                            f"({int(already)}s used of {prof.max_extend_s}s allowance)"}
            total = db.grant_extension(CX, j["id"], secs)
            if total is None:
                return {"ok": False, "error": "job no longer running"}
            db.add_event(CX, j["id"], "note",
                         f"walltime extended +{secs}s by {caller} (total extra {int(total)}s)")
            db.add_typed_event(CX, j["id"], "notify",
                               {"job_id": j["id"], "state": "walltime-extended",
                                "kind": "walltime-extended", "task_type": j.get("task_type"),
                                "principal": j.get("submitter_principal"),
                                "reply_to": j.get("reply_to"),
                                "granted_s": secs, "total_extra_s": int(total), "by": caller})
            return {"ok": True, "granted_s": secs, "total_extra_s": int(total),
                    "new_walltime_s": int(prof.timeout_s + total)}
        if verb == "cancel":
            j = db.get(CX, req["id"], principal=caller, scope_all=view_all)
            if not j:
                return {"ok": False, "error": "no such job"}
            if j["state"] == "queued":
                db.mark_terminal(CX, j["id"], "cancelled", None)
            elif j["state"] == "running":
                slc.stop_unit(j["id"])
                pp = PROCS.get(j["id"])
                if pp:
                    try:
                        pp.wait(timeout=5)
                    except Exception:
                        pass
                _drop(j["id"])
                db.mark_terminal(CX, j["id"], "cancelled", None)
            return {"ok": True, "state": "cancelled"}

        if verb == "set-approval-pref":
            tt_name = (req.get("task_type") or "").strip()
            want = req.get("approval")
            if not db.get_task_type(CX, tt_name):
                return {"ok": False, "error": "unbekannter task_type"}
            may = ("task_type:*" in caller_caps) or (("task_type:%s" % tt_name) in caller_caps)
            if not may:
                return {"ok": False, "error": "keine Berechtigung für diesen Auftragstyp"}
            return db.set_approval_pref(CX, caller, tt_name, want)

        if verb in ("admin-pause", "admin-resume", "admin-queue-status", "admin-set-prio",
                    "admin-reprioritize", "admin-set-quota", "admin-kill-user", "admin-message",
                    "admin-clear-queued", "admin-submit-suspend", "admin-submit-resume",
                    "admin-apply-preset", "admin-set-policy", "admin-fairshare", "get-policy",
                    "admin-ensure-principal", "admin-grant", "admin-bind-identity"):
            if not view_all:
                return {"ok": False, "error": "requires admin (view:all)"}

            _target = req.get("target_principal") or req.get("target")
            if verb == "get-policy":

                if not _target:
                    return {"ok": False, "error": "target_principal required"}
                try:
                    _gp = db.get_policy(CX, _target) or {}
                except Exception as _e:
                    return {"ok": False, "error": str(_e)}
                return {"ok": True, "principal": _target, "policy": {
                    "max_sessions": _gp.get("max_sessions"),
                    "max_submit_jobs": _gp.get("max_submit_jobs"),
                    "submit_enabled": int(_gp.get("submit_enabled", 1) or 0),
                    "weight": int(_gp.get("weight") or 1),
                    "qos_preset": _gp.get("qos_preset")}}

            if verb in ("admin-pause", "admin-resume"):
                global _ADMISSION_PAUSED
                paused = (verb == "admin-pause")
                _ADMISSION_PAUSED = paused
                db.set_meta(CX, "admission_paused", "1" if paused else "0")
                db.set_meta(CX, "admission_paused_by", caller if paused else "")
                db.set_meta(CX, "admission_paused_at", str(time.time()) if paused else "")
                return {"ok": True, "paused": paused, "by": caller}
            if verb == "admin-queue-status":
                pat = db.get_meta(CX, "admission_paused_at", "") or None
                return {"ok": True, "paused": _ADMISSION_PAUSED,
                        "paused_by": (db.get_meta(CX, "admission_paused_by", "") or None),
                        "paused_at": (float(pat) if pat else None),
                        "counts": db.counts(CX)}

            if verb == "admin-fairshare":
                snap = meters.snapshot()
                cfg = _fs_cfg(snap)
                usage = dict(_fs_usage(cfg))
                try:
                    pend, rows_by = _fs.pending_work(DB_PATH, cfg)
                except Exception:
                    pend, rows_by = {}, {}
                accounts = set(usage) | set(pend)
                weights = _fs_account_weights(accounts, CX)
                wtot = sum(weights.values()) or 1.0
                utot = sum(usage.values()) or 1.0
                out_rows, throttled, suspended = [], 0, 0
                for a in sorted(accounts):
                    princ = a.rsplit("/", 1)[0] if "/" in a else a
                    try:
                        pol = db.get_policy(CX, princ)
                    except Exception:
                        pol = {}
                    S = weights.get(a, 1.0) / wtot
                    U = usage.get(a, 0.0)
                    F = _fs.fair_factor(U / utot, S) if utot else 1.0
                    if F < 0.34:
                        throttled += 1
                    se = int(pol.get("submit_enabled", 1) or 0)
                    if not se:
                        suspended += 1
                    out_rows.append({
                        "account": a, "principal": princ,
                        "weight": int(pol.get("weight") or 1),
                        "qos_preset": pol.get("qos_preset"),
                        "norm_share": round(S, 4),
                        "debt": round(U, 1),
                        "norm_usage": round(U / utot, 4) if utot else 0.0,
                        "fair_factor": round(F, 4),
                        "backlog_s": round(pend.get(a, 0.0), 1),
                        "rows": rows_by.get(a, 0),
                        "submit_enabled": se,
                        "max_submit_jobs": pol.get("max_submit_jobs"),
                        "max_sessions": pol.get("max_sessions"),
                        "block_reason": (None if se else "admin-suspended"),
                    })
                out_rows.sort(key=lambda r: r["fair_factor"])
                cpu = snap.get("cpu_count") or 1
                return {"ok": True, "now": time.time(),
                        "kpi": {"accounts": len(accounts), "throttled": throttled,
                                "suspended": suspended,
                                "backlog_total_s": round(sum(pend.values()) or 0.0, 1),
                                "load1": snap.get("load1"), "cpu_count": cpu,
                                "util_pct": min(100, int(round((snap.get("load1") or 0) / max(1, cpu) * 100)))},
                        "weights": {"fairshare": cfg.get("fairshare_weight"), "age": cfg.get("age_weight")},
                        "rows": out_rows[:80]}

            if verb == "admin-set-prio":
                target = _target
                if not target:
                    return {"ok": False, "error": "admin-set-prio requires 'target_principal'"}
                try:
                    bias = int(req.get("prio_bias"))
                except (TypeError, ValueError):
                    return {"ok": False, "error": "prio_bias must be an integer"}
                pol = db.set_policy(CX, target, prio_bias=bias, updated_by=caller)
                return {"ok": True, "principal": target, "prio_bias": pol.get("prio_bias")}

            if verb == "admin-set-quota":
                target = _target
                if not target:
                    return {"ok": False, "error": "admin-set-quota requires 'target_principal'"}
                fields = {}
                for k in ("quota_bytes", "quota_inodes"):
                    if req.get(k) is not None:
                        try:
                            fields[k] = int(req.get(k))
                        except (TypeError, ValueError):
                            return {"ok": False, "error": f"{k} must be an integer"}
                if not fields:
                    return {"ok": False,
                            "error": "admin-set-quota requires quota_bytes and/or quota_inodes"}
                pol = db.set_policy(CX, target, updated_by=caller, **fields)
                return {"ok": True, "principal": target,
                        "quota_bytes": pol.get("quota_bytes"),
                        "quota_inodes": pol.get("quota_inodes")}

            if verb in ("admin-submit-suspend", "admin-submit-resume"):
                target = _target
                if not target:
                    return {"ok": False, "error": "requires 'target_principal'"}
                suspend = (verb == "admin-submit-suspend")
                reason = req.get("reason")
                pol = db.set_policy(CX, target, updated_by=caller, reason=reason,
                                    submit_enabled=(0 if suspend else 1),
                                    submit_reason=(reason if suspend else None))
                try:
                    db.publish_user_notify(CX, target, "notify", {"kind": "governance",
                        "text": ("Einreichen neuer Jobs wurde durch %s %s%s" % (caller,
                                 "GESPERRT" if suspend else "wieder freigegeben",
                                 (" — Grund: " + str(reason)) if reason else "")),
                        "severity": ("warn" if suspend else "info"), "from": caller})
                except Exception:
                    pass
                return {"ok": True, "principal": target, "submit_enabled": pol.get("submit_enabled")}

            if verb == "admin-apply-preset":
                target, preset = _target, req.get("preset")
                if not target or not preset:
                    return {"ok": False, "error": "requires 'target_principal' and 'preset'"}
                pol = db.apply_preset(CX, target, preset, updated_by=caller, reason=req.get("reason"))
                if pol is None:
                    return {"ok": False, "error": "unknown preset '%s'" % preset}
                try:
                    db.publish_user_notify(CX, target, "notify", {"kind": "governance",
                        "text": "Dein Nutzungsprofil wurde auf '%s' gesetzt (durch %s)%s" % (preset,
                                caller, (" — Grund: " + str(req.get("reason"))) if req.get("reason") else ""),
                        "severity": "info", "from": caller})
                except Exception:
                    pass
                return {"ok": True, "principal": target, "qos_preset": pol.get("qos_preset"),
                        "weight": pol.get("weight")}

            if verb == "admin-set-policy":
                target = _target
                if not target:
                    return {"ok": False, "error": "requires 'target_principal'"}
                _ALLOWED = ("weight", "max_submit_jobs", "max_sessions", "priority_boost",
                            "boost_expiry", "exclusive_entitled", "preempt_entitled", "qos_preset")
                fields = {k: req.get(k) for k in _ALLOWED if k in req}
                if not fields:
                    return {"ok": False, "error": "no policy fields given"}
                pol = db.set_policy(CX, target, updated_by=caller, reason=req.get("reason"), **fields)
                try:
                    db.publish_user_notify(CX, target, "notify", {"kind": "governance",
                        "text": "Deine Governance-Richtlinie wurde angepasst (durch %s)%s" % (caller,
                                (" — Grund: " + str(req.get("reason"))) if req.get("reason") else ""),
                        "severity": "info", "from": caller})
                except Exception:
                    pass
                return {"ok": True, "principal": target, "policy": {k: pol.get(k) for k in _ALLOWED}}

            if verb == "admin-kill-user":
                target = _target
                if not target:
                    return {"ok": False, "error": "admin-kill-user requires 'target_principal'"}
                cancelled = []
                for jrow in db.nonterminal_for_principal(CX, target):
                    jid = jrow["id"]
                    if jrow["state"] == "running":
                        slc.stop_unit(jid)
                        pp = PROCS.get(jid)
                        if pp:
                            try:
                                pp.wait(timeout=5)
                            except Exception:
                                pass
                        _drop(jid)
                    db.mark_terminal(CX, jid, "cancelled", None)
                    cancelled.append(jid)
                return {"ok": True, "cancelled": cancelled, "count": len(cancelled)}

            if verb == "admin-clear-queued":
                cancelled = []
                for jid in db.queued_ids(CX, exclude_source=SESSION_SOURCE):
                    j = db.get(CX, jid, scope_all=True)
                    if j and j["state"] == "queued":
                        db.mark_terminal(CX, jid, "cancelled", None)
                        cancelled.append(jid)
                print("[pnd] admin-clear-queued by %s: %d job(s)" % (caller, len(cancelled)),
                      file=sys.stderr, flush=True)
                return {"ok": True, "count": len(cancelled)}

            if verb == "admin-message":
                target = _target
                text = req.get("text")
                if not target or not text:
                    return {"ok": False, "error": "admin-message requires 'target' and 'text'"}
                severity = req.get("severity") or "info"
                db.publish_user_notify(CX, target, "notify",
                                       {"kind": "admin-message", "text": str(text),
                                        "severity": severity, "from": caller})
                return {"ok": True, "target": target, "severity": severity}

            if verb == "admin-ensure-principal":
                name = req.get("name")
                if not name:
                    return {"ok": False, "error": "admin-ensure-principal requires 'name'"}
                db.ensure_principal(CX, name, uid=req.get("uid"),
                                    kind=req.get("kind") or "user", note=req.get("note"))
                return {"ok": True, "principal": name}
            if verb == "admin-grant":
                p, cap = _target, req.get("cap")
                if not p or not cap:
                    return {"ok": False, "error": "admin-grant requires 'target_principal' and 'cap'"}

                if cap in db.WILDCARD_CAPS:
                    return {"ok": False,
                            "error": f"refusing to grant wildcard cap {cap!r} via admin-grant"}
                db.grant_cap(CX, p, cap)
                return {"ok": True, "principal": p, "cap": cap}
            if verb == "admin-bind-identity":
                method, selector, p = req.get("method"), req.get("selector"), _target
                if not method or selector is None or not p:
                    return {"ok": False,
                            "error": "admin-bind-identity requires 'method', 'selector', 'target_principal'"}
                db.bind_identity(CX, method, str(selector), p, verified=int(req.get("verified") or 0))
                return {"ok": True, "method": method, "selector": selector, "principal": p}

            if verb == "admin-reprioritize":
                jid = req.get("id")
                j = db.get(CX, jid, principal=caller, scope_all=view_all)
                if not j:
                    return {"ok": False, "error": "no such job"}
                if j["state"] != "queued":
                    return {"ok": False,
                            "error": f"job is {j['state']}, not queued (cannot reprioritize)"}
                old = int(j.get("prio") or 100)
                if req.get("prio") is not None:
                    try:
                        new = int(req.get("prio"))
                    except (TypeError, ValueError):
                        return {"ok": False, "error": "prio must be an integer"}
                elif req.get("delta") is not None:
                    try:
                        new = old + int(req.get("delta"))
                    except (TypeError, ValueError):
                        return {"ok": False, "error": "delta must be an integer"}
                else:
                    return {"ok": False, "error": "admin-reprioritize requires 'prio' or 'delta'"}
                new = max(0, min(300, new))
                if not db.set_job_prio(CX, jid, new):
                    return {"ok": False, "error": "job no longer queued"}
                db.add_event(CX, jid, "note", f"prio {old}->{new} by {caller}")
                db.add_typed_event(CX, jid, "notify",
                                   {"kind": "reprioritized", "job_id": jid, "prio": new,
                                    "old_prio": old, "by": caller, "task_type": j.get("task_type"),
                                    "principal": j.get("submitter_principal"),
                                    "reply_to": j.get("reply_to")})
                return {"ok": True, "id": jid, "prio": new, "old_prio": old,
                        "position": db.position(CX, jid)}
        if verb == "fairshare":
            if _fs is None:
                return {"ok": False, "error": "fairshare-Modul nicht ladbar"}
            if req.get("unban"):
                return {"ok": _fs.ban_lift(str(req["unban"])), "unbanned": req["unban"]}
            snap = meters.snapshot()
            cfg = _fs_cfg(snap)
            pend, rows = _fs.pending_work(DB_PATH, cfg)
            usage = _fs_usage(cfg)
            active = [a for a, v in pend.items() if v > 0]
            weights = {a: 1.0 for a in set(active) | set(usage)}
            tot = sum(usage.values()) or 1.0
            shares = 1.0 / max(1, len(usage) or 1)
            now = time.time()
            accounts = []
            for a in sorted(set(list(pend) + list(usage))):
                until, lvl = _fs.ban_check(a, now)
                accounts.append({
                    "account": a, "queued_rows": rows.get(a, 0),
                    "reserved_box_s": round(pend.get(a, 0.0)),
                    "allowance_box_s": round(_fs.allowance(a, active, weights, cfg)),
                    "usage_box_s": round(usage.get(a, 0.0)),
                    "fair_factor": round(_fs.fair_factor(usage.get(a, 0.0) / tot, shares), 4),
                    "banned_for": _fs.human_duration(until - now) if until else None,
                    "ban_level": lvl,
                })
            return {"ok": True, "cfg": {k: v for k, v in cfg.items() if not k.startswith("_")},
                    "accounts": accounts, "shape": _fs.shape_report(DB_PATH, cfg),
                    "enforcing": _truthy_env("PN_FAIRSHARE_ENFORCE", "1")}
        return {"ok": False, "error": f"unknown verb {verb}"}

def reconcile():

    live = slc.live_units()
    with LK:
        for job in db.running(CX):
            jid = job["id"]
            if job.get("source") == SESSION_SOURCE:
                _session_supervise(job)
                continue
            _, _, rcp = out_err_rc_for(jid)
            if slc.unit_name(jid) in live:
                continue
            code = slc.read_rc(rcp)
            if code is not None:

                finalize_job(job, code, "done" if code == 0 else "failed")

                _reconcile_llm_release(job)
                continue
            prof = ResourceProfile.from_json(job["profile"])
            attempts = job.get("attempts") or 0

            _reconcile_llm_release(job)
            if prof.idempotent and attempts < prof.max_retries:
                nb = db.requeue(CX, jid)
                _wait = (" — Backoff, nächster Anlauf in %ds" % max(0, int(nb - time.time()))
                         if nb else "")
                db.add_event(CX, jid, "note",
                             f"crash-orphaned -> auto-requeue "
                             f"(attempt {attempts + 1}/{prof.max_retries}){_wait}")
            else:
                reason = "not idempotent" if not prof.idempotent else f"retries exhausted ({attempts})"
                db.add_event(CX, jid, "error", f"crash-orphaned -> failed ({reason})")
                db.mark_terminal(CX, jid, "failed", None, fail_class=failklasse.TRANSIENT)

        try:
            keep = {j["id"] for j in db.running(CX)}
            n = slc.sweep_stale_leaves(keep)
            if n:
                sys.stderr.write(f"pnd: reconcile swept {n} stale empty job cgroup leaves\n")
        except Exception as e:
            sys.stderr.write(f"pnd: stale-leaf sweep skipped ({type(e).__name__}: {e})\n")

def _ensure_cgroup_placement():

    try:
        cg = open("/proc/self/cgroup").read()
    except OSError:
        return
    if "/pn.slice/" in cg:
        return
    try:
        import subprocess
        r = subprocess.run(["sudo", "-n", "/usr/local/bin/pn-cgmove"],
                           capture_output=True, text=True, timeout=30)
        cg2 = open("/proc/self/cgroup").read()
        if "/pn.slice/" in cg2:
            sys.stderr.write("pnd: cgroup self-heal placed into pn.slice/critical/pnd via pn-cgmove\n")
        else:
            sys.stderr.write("pnd: WARNING pn-cgmove did not place into pn.slice "
                             "(rc=%s %s); jobs may refuse with rc126 until fixed\n"
                             % (r.returncode, (r.stderr or '').strip()[:120]))
    except Exception as e:
        sys.stderr.write("pnd: WARNING cgroup self-heal failed (%s); jobs may refuse with rc126\n" % e)

def _load_envfile_fallback():

    path = os.environ.get("PND_ENVFILE", "/etc/brainbox/pnd.env")
    try:
        with open(path) as f:
            lines = f.read().splitlines()
    except OSError:
        return
    for ln in lines:
        ln = ln.strip()
        if not ln or ln.startswith("#") or "=" not in ln:
            continue
        k, _, v = ln.partition("=")
        k, v = k.strip(), v.strip()
        if k and k not in os.environ:
            os.environ[k] = v

def main():
    global CX, CFG, GATE, IO_ENABLED, _ADMISSION_PAUSED
    os.makedirs(LOG_DIR, exist_ok=True)
    _load_envfile_fallback()
    _ensure_cgroup_placement()

    from pnlib import WORK_DIR, INDEX_DIR, TRASH_DIR, CAS_DIR
    for d in (WORK_DIR, INDEX_DIR, TRASH_DIR, CAS_DIR):
        os.makedirs(d, exist_ok=True)

    try:
        from pnlib import recordcfg
        recordcfg.apply_retention(record)
    except Exception as e:
        sys.stderr.write(f"pnd: record retention config not applied ({e}); using defaults\n")
    CX = db.connect(DB_PATH)

    _ADMISSION_PAUSED = (db.get_meta(CX, "admission_paused", "0") == "1")
    CFG = sched.Config.autoscale()

    if not (os.environ.get("PN_BATCH_HIGH") or "").strip():
        try:
            from pnlib import cgdispatch as _cgd
            _td = _cgd.batch_tier_dir()
            _cap_b = (meters._read_int(os.path.join(_td, "memory.high"))
                      or meters._read_int(os.path.join(_td, "memory.max"))) if _td else None
            if _cap_b:
                _cap_mib = int(_cap_b) // (1024 * 1024)
                if _cap_mib and CFG.batch_high > _cap_mib:
                    sys.stderr.write("pnd: batch_high %dM > kernel batch-tier cap %dM -> "
                                     "clamped (admission never promises RAM the tier "
                                     "squeezes/kills at)\n" % (CFG.batch_high, _cap_mib))
                    CFG.batch_high = _cap_mib
        except Exception as e:
            sys.stderr.write("pnd: batch tier cap reconcile skipped (%s: %s)\n"
                             % (type(e).__name__, e))
    GATE = sched.PressureGate(CFG)
    IO_ENABLED = detect_io_delegation()
    reconcile()
    srv = ipc.Server(handle)
    threading.Thread(target=srv.serve_forever, daemon=True).start()

    bsock = ipc.broker_sock_path()
    if bsock:
        try:
            grp_name = ipc.broker_group()
            srv.also_listen(bsock, mode=0o660, group=grp_name)
            st = os.stat(bsock)
            sys.stderr.write(f"pnd: broker socket up at {bsock} "
                             f"(mode {oct(st.st_mode & 0o777)}, gid {st.st_gid}, group target "
                             f"'{grp_name}') — de-privileged broker reachability, authz unchanged\n")
            sys.stderr.flush()
        except Exception as e:

            sys.stderr.write(f"pnd: could not bind broker socket {bsock}: "
                             f"{type(e).__name__}: {e} (default socket unaffected)\n")
            sys.stderr.flush()
    stop = {"v": False}
    signal.signal(signal.SIGTERM, lambda *_: stop.update(v=True))
    signal.signal(signal.SIGINT, lambda *_: stop.update(v=True))
    sd_notify("READY=1")
    sys.stderr.write(f"pnd {VERSION} up: floor={CFG.mem_floor}M batch_high={CFG.batch_high}M "
                     f"max_concurrent={CFG.max_concurrent} io_delegated={IO_ENABLED}\n")
    sys.stderr.flush()
    while not stop["v"]:
        t0 = time.time()
        try:
            tick()
        except Exception as e:
            sys.stderr.write(f"pnd tick error: {type(e).__name__}: {e}\n")
            sys.stderr.flush()
        try:

            maybe_hausmeister()
        except Exception as e:
            sys.stderr.write(f"pnd hausmeister trigger error: {type(e).__name__}: {e}\n")
            sys.stderr.flush()
        dt = time.time() - t0
        time.sleep(max(0.1, CFG.poll_interval - dt))
    sd_notify("STOPPING=1")

if __name__ == "__main__":
    main()
