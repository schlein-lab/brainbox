            "wo_id": job.get("group_id"),
            "job_id": job["id"],
            "reply_to": job.get("reply_to"),
            "verdict": "done" if exit_code == 0 else "failed",
            "record_commit": record_info["commit"],
            "result_hash": record_info["result_hash"],
            "manifest_digest": record_info["result_hash"],
        }
        db.add_event(CX, job["id"], "result", payload)
        return True
    except Exception as e:
        db.add_event(CX, job["id"], "error", f"emit failed: {type(e).__name__}: {e}")
        return False

def emit_approval_request(job, record_info, code, held_state, nonce, gate):

    try:
        preview = record.review_preview(job)
    except Exception as e:
        preview = {"error": f"{type(e).__name__}: {e}"}
    payload = {
        "job_id": job["id"], "nonce": nonce, "gate": gate,
        "task_type": job.get("task_type"),
        "summary": job.get("client_tag") or job.get("task_type") or "produced result",
        "held_state": held_state,
        "result": {
            "record_commit": (record_info or {}).get("commit"),
            "result_hash": (record_info or {}).get("result_hash"),
            "result_uri": None,
            "workspace_path": job.get("workspace_path"),
            "exit_code": code,
        },
        "preview": preview,
        "revise": {"count": job.get("revise_count") or 0,
                   "max": job.get("revise_max") if job.get("revise_max") is not None else 3},
    }
    db.add_typed_event(CX, job["id"], "approval-request", payload)

def _emit_terminal(jid, state, code, record_ok, job):

    db.add_typed_event(CX, jid, "state", {"state": state, "exit_code": code,
                                          "record_ok": bool(record_ok)})

    if str(job.get("source") or "") == "filler":
        return
    db.add_typed_event(CX, jid, "notify",
                       {"job_id": jid, "state": state, "task_type": job.get("task_type"),
                        "principal": job.get("submitter_principal"),
                        "reply_to": job.get("reply_to"), "exit_code": code,
                        "record_commit": job.get("record_commit"),
                        "result_hash": job.get("result_hash")})

def finalize_approved(job):

    jid = job["id"]
    j = db.get(CX, jid, scope_all=True)
    if not j or j["state"] != "awaiting_approval":
        return None
    held_state = j.get("held_state") or "done"
    code = j.get("held_exit_code")
    ws = j.get("workspace_path") or record.workspace_path(jid)
    j = {**j, "workspace_path": ws}

    committed = bool(j.get("record_commit")) and record.valid_workspace(ws)
    record_ok = record.compute_record_ok(
        j, work_success=(held_state == "done"), committed=committed, emitted=committed)
    if record_ok:
        state = "done"
    elif held_state == "timeout":
        state = "timeout"
    else:
        state = "failed"
    snap = meters.snapshot()
    retention_until = time.time() + record.work_ttl_for(snap.get("data_free_pct", 100.0))
    db.finalize(CX, jid, state, code, record_ok=record_ok,
                record_commit=j.get("record_commit"), result_uri=None,
                result_hash=j.get("result_hash"), retention_until=retention_until,
                fail_class=(None if state == "done" else failklasse.FATAL))
    db.add_typed_event(CX, jid, "approval-result", {"decision": "approved", "state": state})
    _emit_terminal(jid, state, code, record_ok, j)
    return state

def finalize_job(job, code, terminal_hint, cg_stats=None):

    jid = job["id"]
    ws = job.get("workspace_path") or record.workspace_path(jid)
    job = {**job, "workspace_path": ws}
    started = job.get("started_at")
    finished = time.time()
    work_success = (terminal_hint == "done" and code == 0)
    argv = json.loads(job["cmd"])

    committed = False
    record_info = None
    try:
        record_info = record.write_record(
            job, argv=argv, exit_code=code if code is not None else -1,
            started_at=started, finished_at=finished,
            rationale=_read_rationale(ws))
        committed = bool(record_info.get("commit"))
    except Exception as e:
        db.add_event(CX, jid, "error", f"record commit failed: {type(e).__name__}: {e}")

    emitted = False
    if committed:
        emitted = emit_result(job, record_info, code if code is not None else -1)

    record_ok = record.compute_record_ok(
        job, work_success=work_success, committed=committed, emitted=emitted)

    gate = (job.get("approval_kind") or "none")
    if work_success and record_ok and gate in ("post", "checkpoint"):
        nonce = secrets.token_urlsafe(18)

        db.set_record(CX, jid, record_commit=(record_info or {}).get("commit"),
                      result_hash=(record_info or {}).get("result_hash"))
        held_state = "done"
        db.hold_for_approval(CX, jid, nonce, held_state, code, approval_kind=gate)

        job = {**job, "revise_count": db.get(CX, jid, scope_all=True).get("revise_count")}
        emit_approval_request(job, record_info, code, held_state, nonce, gate)
        db.add_typed_event(CX, jid, "state",
                           {"state": "awaiting_approval", "gate": gate, "exit_code": code})
        return "awaiting_approval"

    if record_ok:
        state = "done"
    elif terminal_hint == "timeout":
        state = "timeout"
    else:
        state = "failed"

    snap = meters.snapshot()
    ttl = record.work_ttl_for(snap.get("data_free_pct", 100.0))
    retention_until = finished + ttl

    fc = None
    if state != "done":
        _, _errp, _ = out_err_rc_for(jid)
        fc = failklasse.classify(code, terminal_hint,
                                 err_tail=_tail_file(_errp, 4096),
                                 oom=bool((cg_stats or {}).get("oom_kill"))) or failklasse.FATAL
    db.finalize(CX, jid, state, code, record_ok=record_ok,
                record_commit=(record_info or {}).get("commit"),
                result_uri=None,
                result_hash=(record_info or {}).get("result_hash"),
                retention_until=retention_until, fail_class=fc)

    _emit_terminal(jid, state, code, record_ok, job)

    if started:
        gov_observe(finished - started)

    stamp_actuals(job, started, finished, cg_stats=cg_stats)
    if work_success and not record_ok:
        db.add_event(CX, jid, "error",
                     "work succeeded but record incomplete (commit/emit/layout) -> failed, "
                     "not done (no-done-without-record)")
    return state

def _maybe_oom_grow(job, prof, code, cg):

    grown = sched.oom_grow_target(prof, job.get("oom_retries") or 0, code,
                                  (cg or {}).get("oom_kill"))
    if grown is None:
        return False
    new_prof = ResourceProfile.from_json(job["profile"])
    new_prof.mem = grown
    retries = (job.get("oom_retries") or 0) + 1
    db.requeue_oom_grown(CX, job["id"], grown, new_prof.to_json())
    db.add_event(CX, job["id"], "note",
                 f"OOM-killed -> requeue with mem {prof.mem}->{grown} MiB "
                 f"(oom retry {retries}/{prof.max_oom_retries})")
    db.add_typed_event(CX, job["id"], "notify",
                       {"job_id": job["id"], "state": "oom-retry", "kind": "oom-retry",
                        "task_type": job.get("task_type"),
                        "principal": job.get("submitter_principal"),
                        "reply_to": job.get("reply_to"),
                        "mem_from": prof.mem, "mem_to": grown,
                        "retry": retries, "max": prof.max_oom_retries})
    return True

def _walltime_warn(job, prof, wall, extra):

    jid = job["id"]
    limit = prof.timeout_s + max(0.0, extra)
    remaining = max(0, int(limit - wall))
    db.mark_soft_warned(CX, jid)
    if str(job.get("source") or "") != "filler":
        db.add_typed_event(CX, jid, "notify",
                           {"job_id": jid, "state": "walltime-warn", "kind": "walltime-warn",
                            "task_type": job.get("task_type"),
                            "principal": job.get("submitter_principal"),
                            "reply_to": job.get("reply_to"),
                            "remaining_s": remaining, "walltime_s": int(limit),
                            "extendable": prof.max_extend_s > 0})
    db.add_event(CX, jid, "note",
                 f"walltime warning: ~{remaining}s left of {int(limit)}s"
                 + (f" — `pn extend {jid} <s>` to request more time" if prof.max_extend_s > 0
                    else " — ask an admin to extend"))

def _maybe_drain_requeue(job, code):

    if not job.get("node") or code == 0:
        return False
    try:
        cap = max(0, int(os.environ.get("PN_DRAIN_REQUEUE", "2") or 2))
    except (TypeError, ValueError):
        cap = 2
    try:
        v = rdisp.drain_verdict(job, code, rdisp.get_worker(job["node"]), max_requeues=cap)
    except Exception:
        return False
    if not v.get("requeue"):
        if v.get("reason"):
            db.add_event(CX, job["id"], "note", "drain-requeue: " + v["reason"])
        return False
    nb = db.requeue_drain(CX, job["id"], clear_node=v.get("clear_node", False))
    if nb is None:
        return False
    wait_s = max(0, int(nb - time.time()))
    db.add_event(CX, job["id"], "note",
                 "Node-Drain beendete den Lauf (exit %s) -> zurueck in die Queue statt failed: "
                 "%s; Versuch %d/%d, Backoff %ds%s"
                 % (code, v["reason"], int(job.get("drain_requeues") or 0) + 1, cap, wait_s,
                    " — Fleet-Zuweisung geloest, Picker waehlt neu" if v.get("clear_node")
                    else ""))
    db.add_typed_event(CX, job["id"], "state",
                       {"state": "queued", "reason": "node-drain-requeue",
                        "node": job.get("node"), "exit_code": code, "not_before": nb})
    return True

def reap():
    now = time.time()
    for job in db.running(CX):
        jid = job["id"]
        if job.get("source") == SESSION_SOURCE:
            _session_supervise(job)
            continue
        _, _, rcp = out_err_rc_for(jid)
        prof = ResourceProfile.from_json(job["profile"])

        code = None
        done = False
        p = PROCS.get(jid)
        if p is not None:
            ret = p.poll()
            if ret is not None:
                code = slc.read_rc(rcp)
                if code is None:
                    code = ret
                done = True
        else:
            st = slc.unit_status(jid)
            if not st["loaded"] or not st["active"]:
                code = slc.read_rc(rcp)
                if code is None:
                    code = st["code"]
                done = True
        if done:

            cg = _cg_stats(jid)

            if code != 0 and _maybe_oom_grow(job, prof, code, cg):
                _drop(jid)
                continue

            if code != 0 and _maybe_drain_requeue(job, code):
                _drop(jid)
                continue
            finalize_job(job, code, "done" if code == 0 else "failed", cg_stats=cg)
            _drop(jid)
            continue

        if not job.get("started_at"):
            continue

        _dmax = getattr(prof, "disk_max", None)
        if _dmax:
            _used = _dir_usage_mib([_job_scratch_dir(jid),
                                    job.get("workspace_path") or record.workspace_path(jid)])
            if _used > int(_dmax):
                _reason = ("Scratch-Kontingent überschritten: %d MiB auf der Platte geschrieben, "
                           "erlaubt sind %d MiB (--disk-max) — Job gestoppt, Box-Platte unversehrt."
                           % (_used, int(_dmax)))
                cg = _cg_stats(jid)
                slc.stop_unit(jid)
                pp = PROCS.get(jid)
                if pp:
                    try:
                        pp.wait(timeout=5)
                    except Exception:
                        pass
                db.add_event(CX, jid, "error", _reason)
                finalize_job(job, 122, "failed", cg_stats=cg)
                _drop(jid)
                continue
        wall = now - job["started_at"]

        _ds = getattr(prof, "dauer_s", None)
        if _ds and wall > float(_ds) and jid not in _DAUER_NOTED:
            _DAUER_NOTED.add(jid)
            try:
                db.add_event(CX, jid, "note",
                             "überzieht die geplante Dauer (dauer_s=%ds) um %ds — dauer_s ist "
                             "reine Planungsgröße, KEIN Limit; nur die ETA anderer Buchungen "
                             "wird neu gerechnet." % (int(_ds), int(wall - float(_ds))))
            except Exception:
                _DAUER_NOTED.discard(jid)
        extra = job.get("walltime_extra_s") or 0.0
        phase = sched.walltime_phase(prof, wall, extra, bool(job.get("soft_warned")))
        if phase == "warn":
            _walltime_warn(job, prof, wall, extra)
        elif phase == "kill":
            cg = _cg_stats(jid)
            slc.stop_unit(jid)
            pp = PROCS.get(jid)
            if pp:
                try:
                    pp.wait(timeout=5)
                except Exception:
                    pass
            finalize_job(job, 124, "timeout", cg_stats=cg)
            _drop(jid)

def scan_progress():

    for job in db.running(CX):
        jid = job["id"]
        outp, _, _ = out_err_rc_for(jid)
        off = OUT_OFF.get(jid, 0)
        try:
            sz = os.path.getsize(outp)
            if sz <= off:
                continue
            with open(outp, "rb") as f:
                f.seek(off)
                chunk = f.read()
            OUT_OFF[jid] = off + len(chunk)
        except OSError:
            continue
        last = None
        for last in PROGRESS_RE.finditer(chunk):
            pass
        if not last:
            continue
        done = total = msg = None
        if last.group(1):
            try:
                d = json.loads(last.group(1).decode())
                done, total, msg = d.get("done"), d.get("total"), d.get("msg")
            except Exception:
                continue
        else:
            done, total = int(last.group(2)), int(last.group(3))
        if done is not None or total is not None or msg is not None:
            db.update_progress(CX, jid, done=done, total=total, msg=msg)
            db.add_typed_event(CX, jid, "progress",
                               {"done": done, "total": total, "msg": msg})

def replicate_sweep():

    for job in db.replication_pending(CX):
        res = record.replicate(job)
        if res.get("ok"):
            db.mark_replicated(CX, job["id"], result_uri=res.get("result_uri"),
                               result_hash=res.get("result_hash"))
            db.add_event(CX, job["id"], "replicated",
                         {"result_uri": res.get("result_uri"),
                          "result_hash": res.get("result_hash"),
                          "idempotent": res.get("idempotent", False)})

def gc_sweep():

    for job in db.gc_candidates(CX):
        if record.dispose_workspace(job["id"]):
            db.mark_workspace_gcd(CX, job["id"])
            db.add_event(CX, job["id"], "gc",
                         {"reason": "ttl", "result_uri": job.get("result_uri")})

    snap = meters.snapshot()
    pct = snap.get("data_free_pct", 100.0)
    if pct < record.DATA_WARN_PCT:

        for job in db.disk_pressure_victims(CX, limit=50):
            if meters.snapshot().get("data_free_pct", 100.0) >= record.DATA_WARN_PCT:
                break
            if record.dispose_workspace(job["id"]):
                db.mark_workspace_gcd(CX, job["id"])
                db.add_event(CX, job["id"], "gc",
                             {"reason": "disk-pressure", "result_uri": job.get("result_uri")})

    pct = meters.snapshot().get("data_free_pct", 100.0)
    degraded = pct < record.DATA_HARD_PCT
    floored = pct < getattr(record, "DATA_FLOOR_PCT", 3.0)
    if degraded and not HEALTH_DEGRADED["disk"]:
        sys.stderr.write(f"pnd HEALTH DEGRADED: DATA free {pct:.1f}% < {record.DATA_HARD_PCT}% "
                         f"-> THROTTLE: bulk work waits, latency work keeps flowing "
                         f"(NOT deleting unreplicated copies)\n")
        sys.stderr.flush()
    if floored and not HEALTH_DEGRADED["disk_floor"]:
        sys.stderr.write(f"pnd HEALTH FLOOR: DATA free {pct:.1f}% < "
                         f"{getattr(record, 'DATA_FLOOR_PCT', 3.0)}% -> stop admitting "
                         f"ENTIRELY (still NOT deleting unreplicated copies)\n")
        sys.stderr.flush()
    HEALTH_DEGRADED["disk"] = degraded
    HEALTH_DEGRADED["disk_floor"] = floored

def maybe_gc():

    global LAST_GC
    now = time.time()
    if now - LAST_GC < GC_EVERY_S:
        return
    LAST_GC = now
    try:
        replicate_sweep()
        gc_sweep()
    except Exception as e:
        sys.stderr.write(f"pnd gc_sweep error: {type(e).__name__}: {e}\n")
        sys.stderr.flush()

def run_dag_gate():

    res = db.gate_dag(CX)
    for jid in res.get("promoted", []):

        db.add_typed_event(CX, jid, "state", {"state": "queued", "reason": "deps_satisfied"})
    for jid, detail in res.get("cancelled", []):

        db.add_typed_event(CX, jid, "state",
                           {"state": "cancelled", "reason": "dep_failed",
                            "failed_deps": detail.get("failed_deps"),
                            "missing_deps": detail.get("missing_deps")})
        j = db.get(CX, jid, scope_all=True) or {}
        db.add_typed_event(CX, jid, "notify",
                           {"job_id": jid, "state": "cancelled", "reason": "dep_failed",
                            "task_type": j.get("task_type"),
                            "principal": j.get("submitter_principal"),
                            "reply_to": j.get("reply_to")})

    touched = set()
    for jid in res.get("promoted", []) + [c[0] for c in res.get("cancelled", [])]:
        j = db.get(CX, jid, scope_all=True)
        if j and j.get("group_id"):
            touched.add(j["group_id"])
    for gid in touched:

        owner = db.group_owner(CX, gid)
        if not owner:
            continue
        gs = db.group_status(CX, gid, principal=owner, scope_all=False)
        if gs:
            db.add_typed_event(CX, gs["members"][0]["id"], "group-status", gs,
                               topics=[db.group_topic(owner, gid)])
    return res

def preempt_filler(jid) -> bool:

    slc.stop_unit(jid)
    pp = PROCS.get(jid)
    if pp:
        try:
            pp.wait(timeout=STOP_GRACE_S)
        except Exception:
            pass

    alive = (pp is not None and pp.poll() is None)
    if not alive:
        st = slc.unit_status(jid)

        alive = bool(st.get("loaded") and st.get("active"))
    if alive:
        db.add_event(CX, jid, "note",
                     "preempt requested but filler not yet dead -> kept accounted (no re-admit)")
        return False
    _drop(jid)
    db.add_event(CX, jid, "note", "preempted by arriving real work (filler yields)")
    db.requeue(CX, jid, reset_age=True)
    return True

def _maybe_preempt_for(job, prof, hr, proj, llm_reserved):

    fillers = db.running_fillers(CX)
    if not fillers:
        return (False, 0, 0.0)
    cand = [{"id": f["id"],
             "mem": ResourceProfile.from_json(f["profile"]).mem,
             "llm": sched.llm_demand_slots(ResourceProfile.from_json(f["profile"]))}
            for f in fillers]

    used = max(proj.get("batch_current", 0), db.reserved_mib(CX, track="batch"))
    need_mem = max(0, (used + prof.mem) - CFG.batch_high)

    llm_free = (hr or {}).get("llm_free")
    need_llm = 0.0
    if prof.llm_weight:
        demand = sched.llm_demand_slots(prof)
        if llm_free is None:
            need_llm = demand
        else:
            avail = float(llm_free) - float(llm_reserved or 0.0)
            need_llm = max(0.0, demand - avail)

    have_mem = sum(c["mem"] for c in cand)
    have_llm = sum(c["llm"] for c in cand)
    if need_mem > have_mem or need_llm > have_llm:
        return (False, 0, 0.0)
    plan = sched.preempt_plan(need_mem, need_llm, cand)
    by_id = {c["id"]: c for c in cand}
    freed_mem, freed_llm, any_killed = 0, 0.0, False
    for jid in plan:
        if preempt_filler(jid):
            any_killed = True
            freed_mem += by_id[jid]["mem"]
            freed_llm += by_id[jid]["llm"]
    return (any_killed, freed_mem, freed_llm)

def tick():
    with LK:
        reap()
        drain_pending_releases()
        maybe_gc()
        run_dag_gate()
        snap = meters.snapshot()
        scan_progress()

        if _ADMISSION_PAUSED:
            WAIT_REASONS.update(jobs={}, ts=time.time(),
                                **{"global": "admission paused (admin)"})
            sd_notify("WATCHDOG=1")
            return

        _starved = snap["mem_available"] < CFG.mem_floor
        blocked = GATE.update(100.0 if _starved else (snap.get("psi_ctl_full_avg10") or 0.0))

        _bpsi = snap.get("psi_batch_full_avg10")
        batch_blocked = _bpsi is not None and _bpsi >= CFG.psi_stop

        if HEALTH_DEGRADED["disk_floor"]:
            WAIT_REASONS.update(jobs={}, ts=time.time(),
                                **{"global": "DATA-Platte unter dem absoluten Boden "
                                             "(%.1f%%) — es startet nichts mehr, und es wird "
                                             "nichts Unrepliziertes geloescht"
                                             % (snap.get("data_free_pct", 0.0))})
            sd_notify("WATCHDOG=1")
            return
        _disk_gedrosselt = bool(HEALTH_DEGRADED["disk"])

        reassert_llm_leases()
        hr = llm_headroom()
        proj = dict(snap)

        llm_reserved = 0.0
        dispatched = 0

        _fc_workers = rdisp.load_workers() if _FC_MODE != "off" else {}
        _fc_inflight = {}
        try:
            _fc_boxload = os.getloadavg()[0]
        except OSError:
            _fc_boxload = 0.0
        _fc_nproc = os.cpu_count() or 1

        _kern_frei = _kern_snap = None
        try:
            _krows = db.kern_buchungen(CX)
            if any(r["state"] == "queued" for r in _krows):
                _kern_snap = _kern_snapshot(_fc_workers or rdisp.load_workers())
                _kern_frei = kernslots.frei_je_node(
                    _kern_snap, [r for r in _krows if r["state"] == "running"])
        except Exception as e:
            _kern_frei = _kern_snap = None
            try:
                sys.stderr.write("[kern-slots] Tick-Sicht nicht baubar: %s: %s\n"
                                 % (type(e).__name__, e))
            except Exception:
                pass

        _waits: dict = {}
        _wait_global = None

        last_head = None
        skipped = set()

        while dispatched < CFG.max_per_tick:

            _rtc = db.running_track_counts(CX)
            running = _rtc["total"]
            reserved = db.reserved_mib(CX, track="batch")
            cpu_running = db.reserved_cpu(CX, track="batch")

            job = db.next_queued(CX, exclude_filler=True, skip=skipped)
            if not job:
                break
            prof = ResourceProfile.from_json(job["profile"])

            _kb = int(getattr(prof, "kerne", 0) or 0)
            _fa_workers = _fc_workers
            if _kb and _kern_frei is not None:
                _fa_workers = {nid: rec for nid, rec in _fc_workers.items()
                               if _kern_frei.get(nid, -1) >= _kb}
            _fleet_assign(job, _fa_workers, _fc_inflight, _fc_boxload, _fc_nproc,
                          mem_avail=proj.get("mem_available"), mem_total=snap.get("mem_total"))

            if _kb and _kern_frei is not None:
                _ktgt = job.get("node")
                if _ktgt in _kern_frei and _kern_frei[_ktgt] < _kb:
                    _waits[job["id"]] = ("kern-slots %s: %d von %d buchbaren Kernen frei, "
                                         "%d gebucht"
                                         % (_ktgt or "box", max(0, _kern_frei[_ktgt]),
                                            (_kern_snap or {}).get(_ktgt, {}).get("buchbar", 0),
                                            _kb))
                    skipped.add(job["id"])
                    continue
            if job.get("node"):

                prof.mem = rdisp.PROXY_MEM_MIB
                prof.cpu_quota_pct = rdisp.PROXY_CPU_PCT

                if _node_lane_full(_rtc, _fc_workers, _waits, job):
                    skipped.add(job["id"])
                    continue
            _track = sched.track_of(prof)
            dec = sched.evaluate(CFG, proj, prof, running, reserved, blocked, cpu_running,
                                 track=_track, batch_blocked=batch_blocked,
                                 disk_degraded=_disk_gedrosselt,
                                 track_running=_rtc.get("batch", 0) + _rtc.get("filler", 0)
                                 if _track == "batch" else _rtc.get(_track, 0),
                                 slotless=bool(job.get("node")))
            llm_dec = sched.llm_ok(hr, prof, llm_reserved)
            if not dec.admit or not llm_dec.admit:

                _waits[job["id"]] = dec.reason if not dec.admit else llm_dec.reason

                if blocked:
                    _wait_global = _waits[job["id"]]
                    break
                if running >= CFG.max_concurrent:

                    _wait_global = _waits[job["id"]]
                    skipped.add(job["id"])
                    continue
                killed, freed_mem, freed_llm = _maybe_preempt_for(
                    job, prof, hr, proj, llm_reserved)
                if killed:
                    proj["mem_available"] += freed_mem
                    proj["batch_current"] = max(0, proj["batch_current"] - freed_mem)
                    if hr.get("llm_free") is not None:
                        hr = dict(hr); hr["llm_free"] = float(hr["llm_free"]) + freed_llm
                    continue

                skipped.add(job["id"])
                continue

            high = sched.dynamic_mem_high(CFG, proj, reserved, prof)

            if prof.llm_weight and not llm_lease(job["id"], prof.llm_weight, prof.llm_kind):
                _waits[job["id"]] = "llm pool lease refused (pn-llmd saturated/unreachable)"
                break
            if start_job(job, prof, mem_high=high):
                dispatched += 1
                _waits.pop(job["id"], None)
                proj["mem_available"] -= prof.mem
                proj["batch_current"] = max(proj["batch_current"], reserved + prof.mem)
                llm_reserved += sched.llm_demand_slots(prof)
                if _kb and _kern_frei is not None:
                    _kern_frei[job.get("node")] = _kern_frei.get(job.get("node"), 0) - _kb
                last_head = None
            else:

                if prof.llm_weight:
                    llm_release(job["id"])
                if last_head == job["id"]:
                    break
                last_head = job["id"]
                continue

        if not blocked and not db.has_queued_real(CX):
            fdispatched = 0
            flast = None
            fskipped = set()
            while fdispatched < CFG.max_per_tick:
                fjob = db.next_queued_filler(CX, skip=fskipped)
                if not fjob:
                    break
                fprof = ResourceProfile.from_json(fjob["profile"])
                _fleet_assign(fjob, _fc_workers, _fc_inflight, _fc_boxload, _fc_nproc,
                              mem_avail=proj.get("mem_available"), mem_total=snap.get("mem_total"))
                if fjob.get("node"):
                    fprof.mem = rdisp.PROXY_MEM_MIB
                    fprof.cpu_quota_pct = rdisp.PROXY_CPU_PCT
                    if _node_lane_full(db.running_track_counts(CX), _fc_workers, _waits, fjob):
                        break
                reserved = db.reserved_mib(CX, track="batch")
                cpu_running = db.reserved_cpu(CX, track="batch")
                filler_running = len(db.running_fillers(CX))
                fdec = sched.filler_fits(CFG, proj, fprof, reserved, hr, llm_reserved,
                                         filler_running, blocked or batch_blocked,
                                         filler_cap=FILLER_CAP, cpu_running=cpu_running)
                if not fdec.admit:
                    _waits[fjob["id"]] = fdec.reason

                    fskipped.add(fjob["id"])
                    continue
                fhigh = sched.dynamic_mem_high(CFG, proj, reserved, fprof)
                if fprof.llm_weight and not llm_lease(fjob["id"], fprof.llm_weight, fprof.llm_kind):
                    _waits[fjob["id"]] = "llm pool lease refused (pn-llmd saturated/unreachable)"
                    break
                if start_job(fjob, fprof, mem_high=fhigh):
                    fdispatched += 1
                    _waits.pop(fjob["id"], None)
                    proj["mem_available"] -= fprof.mem
                    proj["batch_current"] = max(proj["batch_current"], reserved + fprof.mem)
                    llm_reserved += sched.llm_demand_slots(fprof)
                    flast = None
                else:
                    if fprof.llm_weight:
                        llm_release(fjob["id"])
                    if flast == fjob["id"]:
                        break
                    flast = fjob["id"]
                    continue

        elif (FILLER_TRICKLE_S > 0 and not blocked and not batch_blocked
              and len(db.running_fillers(CX)) == 0
              and (time.time() - globals().get("_LAST_FILLER_TRICKLE", 0.0)) >= FILLER_TRICKLE_S):
            fjob = db.next_queued_filler(CX)
            if fjob:
                fprof = ResourceProfile.from_json(fjob["profile"])
                _fleet_assign(fjob, _fc_workers, _fc_inflight, _fc_boxload, _fc_nproc,
                              mem_avail=proj.get("mem_available"), mem_total=snap.get("mem_total"))
                _nl_full = False
                if fjob.get("node"):
                    fprof.mem = rdisp.PROXY_MEM_MIB
                    fprof.cpu_quota_pct = rdisp.PROXY_CPU_PCT

                    _nl_full = _node_lane_full(db.running_track_counts(CX), _fc_workers,
                                               _waits, fjob)
                reserved = db.reserved_mib(CX, track="batch")
                cpu_running = db.reserved_cpu(CX, track="batch")

                fdec = sched.filler_fits(CFG, proj, fprof, reserved, hr, llm_reserved,
                                         0, False, filler_cap=FILLER_CAP, cpu_running=cpu_running)
                if fdec.admit and not _nl_full:
                    fhigh = sched.dynamic_mem_high(CFG, proj, reserved, fprof)
                    _leased = True
                    if fprof.llm_weight:
                        _leased = llm_lease(fjob["id"], fprof.llm_weight, fprof.llm_kind)
                    if _leased and start_job(fjob, fprof, mem_high=fhigh):
                        globals()["_LAST_FILLER_TRICKLE"] = time.time()
                        _waits.pop(fjob["id"], None)
                        db.add_event(CX, fjob["id"], "note",
                                     "filler trickle: garantierter Drip auf gesunder Box (Owner-Regel)")
                    elif fprof.llm_weight and not _leased:
                        _waits[fjob["id"]] = "filler trickle: llm pool lease refused"
                    elif fprof.llm_weight:
                        llm_release(fjob["id"])
                else:
                    _waits[fjob["id"]] = "filler trickle: " + fdec.reason

        WAIT_REASONS.update(jobs=_waits, ts=time.time(), **{"global": _wait_global})
    sd_notify("WATCHDOG=1")

class AuthzError(Exception):
    pass

def broker_uids():
    raw = os.environ.get("PND_BROKER_UIDS", "4003")
    out = set()
    for tok in raw.replace(",", " ").split():
        try:
            out.add(int(tok))
        except ValueError:
            pass
    return out

def _coerce_param(name, typ, val):

    if typ == "int":
        try:
            return str(int(val))
        except (TypeError, ValueError):
            raise AuthzError(f"param '{name}' must be an int")

    return str(val)

def _clamp_limit(val, default=50, cap=MAX_LIMIT):

    try:
        n = int(val)
    except (TypeError, ValueError):
        n = int(default)
    if n < 0:
        n = int(default)
    return min(n, cap)

def _resolve_principal(req, cx=None):

    cx = CX if cx is None else cx
    peer_uid = req.get("_peer_uid")
    broker_principal = db.principal_for_uid(cx, peer_uid)
    broker_caps = db.caps_for(cx, broker_principal)

    method = req.get("_method")
    selector = req.get("_selector")

    if method or selector:
        if peer_uid not in broker_uids() or "act-as" not in broker_caps:
            raise AuthzError(
                f"peer uid {peer_uid} (principal '{broker_principal or 'unknown'}') is not a "
                f"trusted broker (needs allow-list membership + the 'act-as' cap)")
        if not method or selector is None:
            raise AuthzError("broker submit requires both _method and _selector")

        over_priv = broker_caps & db.WILDCARD_CAPS
        if over_priv:
            raise AuthzError(
                f"a broker principal must be structurally de-privileged (holds {sorted(over_priv)})")
        submitter, _verified = db.resolve_identity(cx, method, selector)
        if not submitter:

            submitter = "lan-guest"
        submitter_caps = db.caps_for(cx, submitter)

        relay_caps = broker_caps - {"act-as"}
        eff_caps = relay_caps & submitter_caps

        ceiling = req.get("_ceiling_caps")
        if ceiling is not None:
            if not isinstance(ceiling, (list, tuple, set)):
                raise AuthzError("_ceiling_caps must be a list of capability strings")
            ceiling = set(ceiling)
            bad = ceiling & db.WILDCARD_CAPS
            if bad:
                raise AuthzError(
                    f"_ceiling_caps may not contain a wildcard cap {sorted(bad)} (a ceiling can "
                    f"only narrow, never widen)")
            eff_caps = db.caps_ceiling(eff_caps, ceiling)
        return {"principal": submitter, "caps": eff_caps, "via_method": method,
                "via_device": req.get("via_device"), "is_broker": True}

    return {"principal": broker_principal, "caps": broker_caps,
            "via_method": "peercred", "via_device": None, "is_broker": False}

_TRUSTED_SOURCES = frozenset({"filler", "internal", "klaviatur", "cron", "box"})
_SAFE_EXTERNAL_SOURCES = frozenset({"cli", "http", "portal", "voice", "device", "relay"})

def _validate_source(req, ctx):

    want = (req.get("source") or "cli").strip().lower()
    caps = ctx.get("caps") or set()
    trusted = ("view:all" in caps) or ("task_type:*" in caps)
    if want in _TRUSTED_SOURCES:
        if trusted:
            return want

        return "cli"
    if want in _SAFE_EXTERNAL_SOURCES:
        return want

    return want if want and want not in _TRUSTED_SOURCES else "cli"

try:
    from pnlib import fairshare as _fs
except Exception:
    _fs = None

_FS = {"t": 0.0, "usage": {}, "cfg": None}
_FS_TTL = 300.0

def _truthy_env(name, dflt="0"):
    return str(os.environ.get(name, dflt)).strip().lower() in ("1", "true", "yes", "on")

def _fs_cfg(snap):
    if _FS["cfg"] is None:
        _FS["cfg"] = _fs.config(snap.get("cpu_count") or 4, snap.get("mem_total") or 4096)
    return _FS["cfg"]

def _fs_usage(cfg):

    now = time.time()
    if now - _FS["t"] > _FS_TTL:
        try:
            _FS["usage"] = _fs.decayed_usage(DB_PATH, cfg)
        except Exception:
            _FS["usage"] = _FS.get("usage") or {}
        _FS["t"] = now
    return _FS["usage"]

def _fs_account_weights(accounts, cx):

    by_princ = {}
    for a in accounts:
        p = a.rsplit("/", 1)[0] if "/" in a else a
        by_princ.setdefault(p, []).append(a)
    out = {}
    for p, accs in by_princ.items():
        w = 1
        if cx is not None:
            try:
                w = max(1, int(db.get_policy(cx, p).get("weight") or 1))
            except Exception:
                w = 1
        share = w / float(len(accs) or 1)
        for a in accs:
            out[a] = share
    return out

def _fairshare_admit(req, ctx, prof, cx=None):

    if _fs is None or not _truthy_env("PN_FAIRSHARE_ENFORCE", "1"):
        return True, None, [], 0
    try:
        acct = _fs.account_of(ctx.get("principal"), req.get("tag"))
        now = time.time()

        until, level = _fs.ban_check(acct, now)
        if until:
            return (False, "Gesperrt wegen Submission-Flooding: '%s' noch %s (Stufe %d)"
                    % (acct, _fs.human_duration(until - now), level),
                    ["Stell die Cron-Frequenz ab oder buendle die Arbeit. Die Sperre eskaliert "
                     "1h -> 2h -> 4h -> 24h -> 7d, wenn weiter geflutet wird."], 0)
        _fs.ban_forgive(acct, now)

        snap = meters.snapshot()
        cfg = _fs_cfg(snap)
        p = prof.to_json() if hasattr(prof, "to_json") else prof
        pdict = json.loads(p) if isinstance(p, str) else p
        realtime = (pdict.get("latency") == "realtime")

        pend, rows = _fs.pending_work(DB_PATH, cfg)
        total_rows = sum(rows.values())
        if total_rows >= cfg["max_queued_rows"] and not realtime:
            return (False, "Warteschlange voll (%d Zeilen, Backstop %d)" % (total_rows, cfg["max_queued_rows"]),
                    ["Die Box ist kein HPC-Cluster: buendle Aufgaben zu weniger, laengeren Jobs."], 0)

        want = _fs.reserve(pdict, cfg)
        active = [a for a, v in pend.items() if v > 0]
        weights = _fs_account_weights(set(active) | {acct}, cx)
        allow = _fs.allowance(acct, active, weights, cfg)
        have = pend.get(acct, 0.0)
        if (have + want > allow) and not realtime:

            banned_until, lvl = _fs.ban_strike(acct, now)
            rep = _fs.shape_report(DB_PATH, cfg).get(acct, {})
            adv = list(rep.get("advice") or [])
            adv.append("'%s' reserviert %.0f Box-Sekunden; sein fairer Anteil unter %d aktiven "
                       "Submittern ist %.0f." % (acct, have, len(weights), allow))
            if banned_until:
                adv.append("FLOODING: ab jetzt %s gesperrt (Stufe %d)."
                           % (_fs.human_duration(banned_until - now), lvl))
            return (False, "Fairshare: '%s' ueber seinem Backlog-Anteil (%.0f + %.0f > %.0f Box-s)"
                    % (acct, have, want, allow), adv, 0)

        usage = _fs_usage(cfg)
        tot = sum(usage.values()) or 1.0

        uw = _fs_account_weights(set(usage) | {acct}, cx)
        shares = (uw.get(acct, 1.0)) / (sum(uw.values()) or 1.0)
        f = _fs.fair_factor(usage.get(acct, 0.0) / tot, shares)
        return True, None, [], _fs.priority_delta(f, 0.0, cfg)
    except Exception as e:
        print("[pnd] fairshare disabled this submit: %s" % e, file=sys.stderr, flush=True)
        return True, None, [], 0

