def _unix_rpc(path, req, timeout=1.0):

    try:
        return ipc.send_request(req, timeout=timeout, path=path)
    except Exception:
        return None

def llm_headroom():

    r = _unix_rpc(_llm_sock(), {"verb": "llm.headroom"}, timeout=1.0)
    if not r or not r.get("ok") or "llm_free" not in r:
        return {"llm_free": None, "llm_pool": None, "llm_in_use": None}
    return {"llm_free": r.get("llm_free"), "llm_pool": r.get("llm_pool"),
            "llm_in_use": r.get("llm_in_use")}

def llm_lease(job_id, weight, kind):

    if not weight:
        return True
    r = _unix_rpc(_llm_sock(), {"verb": "lease", "job_id": job_id,
                                "weight": weight, "kind": kind}, timeout=1.0)
    ok = bool(r and r.get("ok"))
    if ok:
        LLM_HELD[job_id] = {"weight": weight, "kind": kind}
        PENDING_RELEASE.discard(job_id)
    return ok

def llm_release(job_id):

    if job_id not in LLM_HELD and job_id not in PENDING_RELEASE:
        return
    r = _unix_rpc(_llm_sock(), {"verb": "release", "job_id": job_id}, timeout=1.0)
    if r and r.get("ok"):
        LLM_HELD.pop(job_id, None)
        PENDING_RELEASE.discard(job_id)
    else:
        PENDING_RELEASE.add(job_id)

def _reconcile_llm_release(job):

    try:
        prof = ResourceProfile.from_json(job["profile"])
    except Exception:
        return
    if not prof.llm_weight:
        return
    jid = job["id"]
    r = _unix_rpc(_llm_sock(), {"verb": "release", "job_id": jid}, timeout=1.0)
    if not (r and r.get("ok")):
        PENDING_RELEASE.add(jid)

def drain_pending_releases():

    for jid in list(PENDING_RELEASE):
        r = _unix_rpc(_llm_sock(), {"verb": "release", "job_id": jid}, timeout=1.0)
        if r and r.get("ok"):
            LLM_HELD.pop(jid, None)
            PENDING_RELEASE.discard(jid)

def reassert_llm_leases():

    try:
        for j in db.running(CX):
            prof = ResourceProfile.from_json(j["profile"])
            if prof.llm_weight:

                r = _unix_rpc(_llm_sock(), {"verb": "lease", "job_id": j["id"],
                                            "weight": prof.llm_weight, "kind": prof.llm_kind},
                              timeout=1.0)
                if r and r.get("ok"):
                    LLM_HELD[j["id"]] = {"weight": prof.llm_weight, "kind": prof.llm_kind}
    except Exception as e:
        sys.stderr.write(f"pnd: reassert_llm_leases skipped ({type(e).__name__}: {e})\n")

