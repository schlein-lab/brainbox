def _hm_verben_fluessig():

    got = LK.acquire(timeout=2.0)
    if got:
        LK.release()
        return True
    return False

def _hm_run():
    try:
        from pnlib import hausmeister as _hm_mod
        _hm_mod.lauf(DB_PATH, weiter=_hm_verben_fluessig,
                     drucken=lambda s: (sys.stderr.write("pnd %s\n" % s), sys.stderr.flush()))
    except Exception as e:
        sys.stderr.write("pnd hausmeister uebersprungen: %s: %s\n" % (type(e).__name__, e))
        sys.stderr.flush()

def maybe_hausmeister():

    if not HM_ENABLED or HM_EVERY_S <= 0:
        return
    t = _HM.get("thread")
    if t is not None and t.is_alive():
        return
    now = time.time()
    if _HM["last"] == 0.0:
        _HM["last"] = now - HM_EVERY_S + min(600.0, HM_EVERY_S / 2.0)
        return
    if now - _HM["last"] < HM_EVERY_S:
        return
    _HM["last"] = now
    th = threading.Thread(target=_hm_run, daemon=True, name="pn-hausmeister")
    _HM["thread"] = th
    th.start()

