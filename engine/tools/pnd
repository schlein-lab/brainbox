def stamp_actuals(job, started, finished, cg_stats=None):

    jid = job["id"]
    wall_s = (finished - started) if (started and finished and finished > started) else None
    held = LLM_HELD.get(jid) or {}
    llm_calls = held.get("weight")
    if llm_calls is None:
        try:
            llm_calls = ResourceProfile.from_json(job.get("profile") or "").llm_weight or None
        except Exception:
            llm_calls = None
    cg = cg_stats or {}

    _tt = job.get("task_type")
    if not _tt:
        try:
            _tt = _cmd_type_of(json.loads(job.get("cmd") or "[]"))
        except Exception:
            _tt = None
    payload = {
        "task_type": _tt,
        "principal": job.get("submitter_principal"),
        "mem_peak": cg.get("mem_peak"),
        "cpu_s": cg.get("cpu_s"),
        "wall_s": round(wall_s, 3) if wall_s else None,
        "llm_calls": llm_calls,
    }
    try:
        db.add_typed_event(CX, jid, "actuals", payload)
    except Exception as e:
        try:
            db.add_event(CX, jid, "error", f"actuals stamp failed: {type(e).__name__}: {e}")
        except Exception:
            pass

SESSION_SOURCE = "session"

def _session_vmm_pid(job):
    m = re.match(r"session:pid=(\d+)$", job.get("scope_unit") or "")
    return int(m.group(1)) if m else None

def _session_remote_node(job):

    m = re.match(r"session:node=(.+)$", job.get("scope_unit") or "")
    return m.group(1) if m else None

def _session_vmm_alive(pid):

    if not pid:
        return False
    try:
        return open("/proc/%d/comm" % pid).read().strip() == "pn-vmm"
    except (OSError, ValueError):
        return False

def _session_llm_totals(jid):

    calls = tokens = 0
    try:
        for r in CX.execute("SELECT data FROM job_events WHERE job_id=? AND kind='llm.turn' AND topic=?",
                            (jid, "job/%d" % jid)):
            try:
                d = json.loads(r["data"] or "{}")
            except (ValueError, TypeError):
                continue
            st = int(d.get("status") or 0)
            if st and st >= 400:
                continue
            calls += 1
            tokens += int(d.get("tokens_in") or 0) + int(d.get("tokens_out") or 0)
    except Exception:
        pass
    return calls, tokens

def _finalize_session_row(job, state, reason=None):

    jid = job["id"]
    calls, tokens = _session_llm_totals(jid)
    started = job.get("started_at")
    now = time.time()
    payload = {
        "task_type": job.get("task_type"),
        "principal": job.get("submitter_principal"),
        "mem_peak": None, "cpu_s": None,
        "wall_s": round(now - started, 3) if started else None,
        "llm_calls": float(calls) if calls else None,
        "llm_tokens": float(tokens) if tokens else None,
    }
    try:
        db.add_typed_event(CX, jid, "actuals", payload)
    except Exception:
        pass
    if reason:
        try:
            db.add_event(CX, jid, "note", reason)
        except Exception:
            pass
    db.mark_terminal(CX, jid, state, 0 if state == "done" else None)

def _session_supervise(job):

    if _session_remote_node(job):
        return
    pid = _session_vmm_pid(job)
    if _session_vmm_alive(pid):
        return
    _finalize_session_row(job, "done",
                          "session cell vanished without detach (vmm pid %s gone) — row closed by pnd"
                          % pid)

def _session_verbs(req, verb):

    if req.get("_peer_uid") != os.getuid():
        return {"ok": False, "error": "session verbs are first-party only"}
    if verb == "session-attach":
        cell = str(req.get("cell") or "").strip()

        principal = str(req.get("cell_principal") or "owner").strip() or "owner"
        kind = "voice" if str(req.get("kind") or "") == "voice" else "session"
        node = str(req.get("node") or "").strip()
        try:
            mem = max(1, int(req.get("mem_mb") or 0))
            pid = int(req.get("pid") or 0)
        except (TypeError, ValueError):
            return {"ok": False, "error": "mem_mb/pid must be integers"}
        if not cell or (not pid and not node):
            return {"ok": False, "error": "session-attach needs cell, mem_mb, pid (or node)"}

        unit = ("session:node=%s" % node) if (node and not pid) else ("session:pid=%d" % pid)
        where = ("remote node=%s" % node) if (node and not pid) else ("vmm pid %d" % pid)
        r = CX.execute("SELECT id FROM jobs WHERE source=? AND client_tag=? AND state='running' "
                       "ORDER BY id DESC LIMIT 1", (SESSION_SOURCE, cell)).fetchone()
        if r:
            jid = r["id"]
            CX.execute("UPDATE jobs SET scope_unit=? WHERE id=?", (unit, jid))
            CX.commit()
            db.add_event(CX, jid, "note", "session cell re-attached (%s)" % where)
            return {"ok": True, "id": jid, "already": True}
        prof = {"mem": mem, "cpu_weight": 60, "latency": "realtime", "llm_weight": 0,
                "timeout_s": 7 * 86400}
        jid = db.submit(CX, cmd=["(session-cell)", cell], cwd="/", env={},
                        profile_json=json.dumps(prof), prio=10, mem=mem, tag=cell,
                        source=SESSION_SOURCE, principal=principal,
                        task_type=("voice.interactive" if kind == "voice" else "session.interactive"),
                        submitter_principal=principal)
        db.mark_running(CX, jid, unit, None)
        db.add_event(CX, jid, "note",
                     "session microVM attached (principal=%s, %d MiB, %s) — interactive "
                     "track, LLM per-call geleast" % (principal, mem, where))
        return {"ok": True, "id": jid}
    if verb == "session-turn":
        try:
            jid = int(req.get("job_id") or 0)
        except (TypeError, ValueError):
            return {"ok": False, "error": "bad job_id"}
        job = db.get(CX, jid, scope_all=True)
        if not job or job.get("source") != SESSION_SOURCE:
            return {"ok": False, "error": "no such session job"}
        payload = {"job_id": jid, "principal": job.get("submitter_principal"),
                   "tokens_in": max(0, int(req.get("tokens_in") or 0)),
                   "tokens_out": max(0, int(req.get("tokens_out") or 0)),
                   "status": int(req.get("status") or 0),
                   "wait_ms": max(0, int(req.get("wait_ms") or 0))}
        db.add_typed_event(CX, jid, "llm.turn", payload)
        try:
            db.heartbeat(CX, jid)
        except Exception:
            pass
        return {"ok": True}
    if verb == "session-detach":
        jid = req.get("job_id")
        job = None
        if jid is not None:
            try:
                job = db.get(CX, int(jid), scope_all=True)
            except (TypeError, ValueError):
                job = None
        elif req.get("cell"):
            r = CX.execute("SELECT id FROM jobs WHERE source=? AND client_tag=? AND state='running' "
                           "ORDER BY id DESC LIMIT 1", (SESSION_SOURCE, str(req["cell"]))).fetchone()
            job = db.get(CX, r["id"], scope_all=True) if r else None
        if not job or job.get("source") != SESSION_SOURCE:
            return {"ok": False, "error": "no such session job"}
        if job.get("state") != "running":
            return {"ok": True, "id": job["id"], "already": True}
        state = "failed" if str(req.get("state") or "done") == "failed" else "done"
        _finalize_session_row(job, state, str(req.get("reason") or "") or None)
        return {"ok": True, "id": job["id"], "state": state}
    return {"ok": False, "error": "unknown session verb"}

def _tail_file(path, nbytes):

    try:
        size = os.path.getsize(path)
        with open(path, "rb") as f:
            if size > nbytes:
                f.seek(size - nbytes)
            data = f.read(nbytes)
        return data.decode("utf-8", "replace")
    except OSError:
        return ""

def sandbox_props_for(job, prof, ws, mem_high=None, scratch=None):

    props = prof.systemd_properties(IO_ENABLED, mem_high=mem_high)

    props.append(f"ReadWritePaths={ws}")

    if (PIPELINE_STATE_DIR
            and str(job.get("principal") or "") == "admin"
            and str(job.get("client_tag") or "").startswith("pipeline:")
            and os.path.isdir(PIPELINE_STATE_DIR)):
        props.append(f"ReadWritePaths={PIPELINE_STATE_DIR}")

    if scratch:
        props.append(f"ReadWritePaths={scratch}")
    if prof.sandbox == "worker-strict":

        try:
            os.makedirs(SECRETS_DIR, mode=0o700, exist_ok=True)
        except OSError:
            pass
        if os.path.isdir(SECRETS_DIR):
            props.append(f"InaccessiblePaths={SECRETS_DIR}")
        else:
            print(f"[pnd] worker-strict: secrets-Riegel NICHT setzbar ({SECRETS_DIR} fehlt und "
                  f"ist nicht anlegbar) — der Auftrag laeuft ohne diesen Zusatz-Riegel",
                  file=sys.stderr, flush=True)
        sig = os.path.join(os.environ.get("XDG_RUNTIME_DIR",
                          f"/run/user/{os.getuid()}"), "zyrkel-signals.sock")
        if os.path.exists(sig):
            props.append(f"InaccessiblePaths={sig}")

    try:
        _tt = db.get_task_type(CX, job.get("task_type")) if job.get("task_type") else None
    except Exception:
        _tt = None
    if _tt and _tt.get("isolation_tier") == "cell" and slc.backend_name() == "cgroup":
        props.append("X-PnCell=1")

    if getattr(prof, "trusted", False) and slc.backend_name() == "cgroup":
        props.append("X-PnTrusted=1")
    return props

def start_job(job, prof, mem_high=None):
    out, err, rc = out_err_rc_for(job["id"])
    argv = json.loads(job["cmd"])
    env = json.loads(job["env"] or "{}")

    ws = record.mkspace(job["id"])
    db.set_workspace(CX, job["id"], ws)
    job = {**job, "workspace_path": ws}

    env["PN_JOB_ID"] = str(job["id"])
    env["PN_WORKSPACE"] = ws
    env.setdefault("XDG_RUNTIME_DIR",
                   os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))

    scratch = _job_scratch_dir(job["id"])
    try:
        os.makedirs(scratch, exist_ok=True)
        os.chmod(scratch, 0o700)
    except OSError as e:
        sys.stderr.write("pnd: scratch dir setup job %s failed: %s: %s\n"
                         % (job["id"], type(e).__name__, e))
    env["PN_SCRATCH"] = scratch
    if getattr(prof, "disk_max", None):
        env["PN_SCRATCH_MAX_MIB"] = str(int(prof.disk_max))
        env["TMPDIR"] = env["TMP"] = env["TEMP"] = scratch
    props = sandbox_props_for(job, prof, ws, mem_high=mem_high, scratch=scratch)
    if job.get("node"):

        nprops = rdisp.node_props(job["node"], timeout_s=getattr(prof, "timeout_s", None))
        if nprops is None:
            db.finalize(CX, job["id"], "failed", 125, record_ok=False,
                        fail_class=failklasse.TRANSIENT)
            db.add_event(CX, job["id"], "error",
                         f"node dispatch failed: worker '{job['node']}' unknown/unusable "
                         f"(removed from workers.json after submit?)")
            return False
        proc = rdisp.dispatch(job["id"], argv, job["cwd"], env, props + nprops, out, err, rc)
    else:

        proc = slc.dispatch(job["id"], argv, job["cwd"], env, props, out, err, rc,
                            track=sched.track_of(prof))
    if proc is None:

        db.finalize(CX, job["id"], "failed", 127, record_ok=False,
                    fail_class=failklasse.FATAL)
        db.add_event(CX, job["id"], "error", "dispatch failed (systemd-run)")
        return False
    PROCS[job["id"]] = proc
    OUT_OFF[job["id"]] = 0
    db.mark_running(CX, job["id"], slc.unit_name(job["id"]), out)

    db.add_typed_event(CX, job["id"], "state", {"state": "running"})
    return True

def _drop(jid):
    PROCS.pop(jid, None)
    OUT_OFF.pop(jid, None)
    _DAUER_NOTED.discard(jid)

    llm_release(jid)

    try:
        slc.cleanup_unit(jid)
    except Exception as e:
        sys.stderr.write("pnd: leaf cleanup job %s failed: %s: %s\n" % (jid, type(e).__name__, e))

    try:
        import shutil as _shutil
        _shutil.rmtree(_job_scratch_dir(jid), ignore_errors=True)
    except Exception as e:
        sys.stderr.write("pnd: scratch cleanup job %s failed: %s: %s\n" % (jid, type(e).__name__, e))

def _read_rationale(ws):

    for cand in (os.path.join(ws, "work", "RATIONALE.md"),
                 os.path.join(ws, "RATIONALE.md")):
        try:
            with open(cand) as f:
                return f.read()
        except OSError:
            continue
    return None

def emit_result(job, record_info, exit_code):

    try:
