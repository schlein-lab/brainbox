                    "frei": frei.get(n, e["buchbar"])}
                for n, e in snap.items()}
    except Exception as e:
        return {"error": "%s: %s" % (type(e).__name__, e)}

def _shorten_cmd(cmd, cmd_max):

    if not isinstance(cmd, str) or len(cmd) <= cmd_max:
        return cmd
    try:
        parts = json.loads(cmd)
        if not isinstance(parts, list):
            raise ValueError
    except (ValueError, TypeError):
        return cmd[:cmd_max] + "…"
    out, used = [], 0
    for i, p in enumerate(parts):
        s = p if isinstance(p, str) else json.dumps(p, ensure_ascii=False)
        if used + len(s) > cmd_max:
            rest = max(0, cmd_max - used)
            if rest:
                out.append(s[:rest] + "…")
            weitere = len(parts) - len(out)
            if weitere > 0:
                out.append("…[+%d Argument(e) gekürzt]" % weitere)
            break
        out.append(p)
        used += len(s)
    return json.dumps(out, ensure_ascii=False)

def _project_rows(jobs, fields, cmd_max):

    try:
        cm = int(cmd_max) if cmd_max is not None else None
    except (TypeError, ValueError):
        cm = None
    if cm is not None and cm > 0:
        for j in jobs:
            if j.get("cmd"):
                j["cmd"] = _shorten_cmd(j["cmd"], cm)
    if isinstance(fields, (list, tuple)) and fields:
        want = {str(f) for f in fields} | {"id", "state"}
        jobs = [{k: v for k, v in j.items() if k in want} for j in jobs]
    return jobs

def _cg_stats(job_id):

