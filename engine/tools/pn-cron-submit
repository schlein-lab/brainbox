#!/usr/bin/env python3

import json
import os
import shutil
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from pnlib import dedupkey
from pnlib import ipc

SOCK = os.environ.get("PN_SOCK") or os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid()), "pnd.sock")

def _tool(name):

    for c in (os.path.join(os.path.dirname(os.path.realpath(__file__)), name),
              os.path.expanduser(os.path.join("~", ".local", "bin", name))):
        if os.access(c, os.X_OK):
            return c
    return shutil.which(name) or name

PN = _tool("pn")
BATCH = _tool("pn-batch-run")

def _req(obj, timeout=8.0):
    return ipc.send_request(obj, timeout=timeout, path=SOCK)

def already_pending(payload_key):
    try:
        jobs = _req({"verb": "list"}).get("jobs") or []
    except Exception:
        return False
    for j in jobs:
        if j.get("state") not in ("queued", "running"):
            continue
        raw = j.get("cmd")
        if isinstance(raw, str):
            try:
                raw = json.loads(raw)
            except Exception:
                raw = [raw]
        cmdstr = " ".join(map(str, raw)) if isinstance(raw, list) else str(raw)

        if dedupkey.matches(payload_key, cmdstr):
            return j.get("id")
    return False

def main(argv):
    deadline, idle = "1500", "6"
    opts = []
    i = 0
    while i < len(argv) and argv[i] != "--":
        if argv[i] == "--deadline":
            deadline = argv[i + 1]; i += 2; continue
        if argv[i] == "--idle-tick":
            idle = argv[i + 1]; i += 2; continue
        opts.append(argv[i]); i += 1
    if i >= len(argv):
        sys.stderr.write("pn-cron-submit: fehlendes -- CMD...\n"); return 2
    payload = argv[i + 1:]
    if not payload:
        sys.stderr.write("pn-cron-submit: leeres CMD\n"); return 2

    key = dedupkey.canon(" ".join(payload))
    key = key[-120:] if len(key) > 120 else key

    jid = already_pending(key)
    if jid:
        print("[pn-cron-submit] schon in der Queue als Job %s — nichts eingereicht" % jid)
        return 0

    cmd = [PN, "run", "--detach"] + opts + ["--", BATCH, deadline, idle, "--"] + payload
    p = subprocess.run(cmd, capture_output=True, text=True)
    sys.stderr.write(p.stderr)
    if p.returncode != 0:
        return p.returncode
    print("[pn-cron-submit] Job %s eingereiht (deadline %ss): %s" % (p.stdout.strip(), deadline, key[:70]))
    return 0

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
