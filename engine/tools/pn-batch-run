#!/bin/bash
set -u
DEADLINE_S="${1:-1500}"; shift
IDLE_TICK_S="${1:-6}"; shift
[ "${1:-}" = "--" ] && shift

END=$(( $(date +%s) + DEADLINE_S ))
ticks=0
while [ "$(date +%s)" -lt "$END" ]; do
  t0=$(date +%s)
  "$@"; rc=$?
  t1=$(date +%s); dt=$(( t1 - t0 )); ticks=$(( ticks + 1 ))
  if [ "$rc" -ne 0 ]; then
    echo "[pn-batch-run] Tick $ticks endete rc=$rc nach ${dt}s -> Schluss"
    exit "$rc"
  fi
  if [ "$dt" -lt "$IDLE_TICK_S" ]; then
    echo "[pn-batch-run] Tick $ticks lief nur ${dt}s (< ${IDLE_TICK_S}s) => keine Arbeit mehr. $ticks Ticks in einem Job."
    exit 0
  fi
done
echo "[pn-batch-run] Deadline ${DEADLINE_S}s erreicht nach $ticks Ticks -> sauber beendet"
exit 0
