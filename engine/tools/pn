def cmd_subscribe(a):

    topics = a.topics if a.topics else ([f"job/{a.id}"] if a.id is not None else [f"user/me"])
    req = {"verb": "subscribe", "topics": topics}
    if a.replay is not None:
        req["after_id"] = a.replay
    p = ipc.sock_path()
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect(p)
    except Exception as e:
        sys.stderr.write(f"pn subscribe: cannot reach pnd: {e}\n"); sys.exit(3)
    s.sendall((json.dumps(req) + "\n").encode())
    buf = b""
    try:
        while True:
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                if not line.strip():
                    continue
                msg = json.loads(line.decode())
                if msg.get("type") == "ping":
                    continue
                print(json.dumps(msg))
                sys.stdout.flush()
    except KeyboardInterrupt:
        pass
    finally:
        s.close()

