def cmd_pending(a):

    r = _req({"verb": "pending", "limit": a.limit})
    if not r.get("ok"):
        sys.stderr.write(f"pn pending: {r.get('error')}\n"); sys.exit(3)
    items = r.get("pending", [])
    if not items:
        print("(no pending approvals)"); return
    print(f"{'ID':>5} {'STATE':<18} {'GATE':<11} {'TASK_TYPE':<16} NONCE")
    for p in items:
        print(f"{p['id']:>5} {p['state']:<18} {(p.get('approval_kind') or '-'):<11} "
              f"{(p.get('task_type') or '(raw)'):<16} {p.get('approval_nonce') or '-'}")
        rq = p.get("approval_request") or {}
        summ = rq.get("summary")
        if summ:
            print(f"        summary: {summ}")
        res = rq.get("result") or {}
        if res.get("result_hash"):
            print(f"        result : hash={res.get('result_hash')[:16]}  "
                  f"commit={(res.get('record_commit') or '-')[:12]}")
        act = rq.get("action") or {}
        if act.get("argv"):
            print(f"        action : {' '.join(act['argv'])[:70]}"
                  + ("  (SIDE-EFFECTING)" if act.get("side_effecting") else ""))

