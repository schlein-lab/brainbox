def _params_dict(pairs):
    d = {}
    for kv in pairs or []:
        if "=" not in kv:
            sys.stderr.write(f"pn: bad --param '{kv}' (expected k=v)\n"); sys.exit(2)
        k, v = kv.split("=", 1)
        d[k] = v
    return d

def _submit_req(a, cmd, source="cli"):
    src = "filler" if getattr(a, "filler", False) else source
    req = {"verb": "submit", "cmd": cmd, "cwd": os.getcwd(),
           "class": a.klass, "mem": a.mem, "prio": a.prio, "timeout": a.timeout,
           "latency": getattr(a, "latency", None),
           "tag": a.tag, "cpu_quota": a.cpu_quota, "disk_min": a.disk_min,
           "disk_max": getattr(a, "disk_max", None),
           "mem_max": a.mem_max, "room": a.room, "idempotent": a.idempotent,
           "source": src, "env": {"PATH": os.environ.get("PATH", "")}}

    if getattr(a, "kerne", None) is not None:
        req["kerne"] = a.kerne
    if getattr(a, "dauer_s", None) is not None:
        req["dauer_s"] = a.dauer_s
    if getattr(a, "flexibel", None):
        req["flexibel"] = True
    if getattr(a, "reply_to", None):
        rt = str(a.reply_to)
        if ":" not in rt:
            sys.stderr.write("pn: --reply-to braucht die Form KANAL:ADRESSE (z.B. file:owner)\n")
            sys.exit(2)
        req["reply_to"] = rt
    if getattr(a, "task_type", None):
        req["task_type"] = a.task_type
        req["params"] = _params_dict(getattr(a, "params", []))

    if getattr(a, "deps", None):
        try:
            req["deps"] = [int(x) for x in a.deps.replace(",", " ").split()]
        except ValueError:
            sys.stderr.write(f"pn: bad --deps '{a.deps}' (comma-separated job ids)\n"); sys.exit(2)
    if getattr(a, "group_id", None):
        req["group_id"] = a.group_id
    if getattr(a, "parent_job", None) is not None:
        req["parent_job"] = a.parent_job
    return _req(req)

def _print_kerne(r):

    kb = r.get("kerne")
    if isinstance(kb, dict):
        line = "[pn] %s Kern(e) gebucht" % kb.get("gebucht")
        if kb.get("wunsch") and kb.get("wunsch") != kb.get("gebucht"):
            line += " — flexibel heruntergestuft von %s gewünschten" % kb["wunsch"]
        e = kb.get("eta") or {}
        if e.get("human"):
            line += " — Start: %s" % e["human"]
        sys.stderr.write(line + "\n")
    ang = r.get("angebot")
    if isinstance(ang, list) and ang:
        sys.stderr.write("[pn] Angebot je Kernzahl: " + "   ".join(
            "%s Kern(e): %s" % (x.get("kerne"), x.get("human") or x.get("status"))
            for x in ang) + "\n")
    sys.stderr.flush()

class Streamer:

    def __init__(self, job_id):
        self.out = os.path.join(LOG_DIR, f"job-{job_id}.out")
        self.err = os.path.join(LOG_DIR, f"job-{job_id}.err")
        self._fo = self._fe = None

    def _pump(self, path, fh_attr, sink):
        fh = getattr(self, fh_attr)
        if fh is None:
            if not os.path.exists(path):
                return
            try:
                fh = open(path, "rb")
                setattr(self, fh_attr, fh)
            except Exception:
                return
        data = fh.read()
        if data:
            sink.write(data)
            sink.flush()

    def pump(self):
        self._pump(self.out, "_fo", sys.stdout.buffer)
        self._pump(self.err, "_fe", sys.stderr.buffer)

def cmd_run(a, cmd):
    if not cmd and not getattr(a, "task_type", None):
        sys.stderr.write("pn run: missing -- CMD... (or --task-type NAME)\n"); sys.exit(2)
    r = _submit_req(a, cmd)
    if not r.get("ok"):
        sys.stderr.write(f"pn run: submit failed: {r.get('error')}\n")
        _print_kerne(r)
        sys.exit(3)
    jid, pos = r["id"], r.get("pos", 0)
    _e = r.get("eta") or {}
    _h = f", ETA {_e['human']}" if _e.get("human") else ""
    sys.stderr.write(f"[pn] job {jid} queued (pos {pos}{_h})\n"); sys.stderr.flush()
    _print_kerne(r)

    if getattr(a, "detach", False):

        print(jid)
        return 0

    cancelled = {"v": False}
    def onsig(*_):
        cancelled["v"] = True
        _req({"verb": "cancel", "id": jid}, timeout=5)
    signal.signal(signal.SIGTERM, onsig)
    signal.signal(signal.SIGINT, onsig)

    st = Streamer(jid)
    started = False
    lost_since = None
    GRACE = 120.0
    while True:
        jr = _req_soft({"verb": "job", "id": jid})
        if jr is None or not jr.get("ok"):
            now = time.time()
            lost_since = lost_since or now
            if now - lost_since > GRACE:
                sys.stderr.write(f"[pn] lost contact with pnd >{int(GRACE)}s; job {jid} may still "
                                 f"be running — check `pn status` / `pn log {jid}`\n")
                sys.exit(75)
            st.pump(); time.sleep(1.0); continue
        lost_since = None
        job = jr["job"]; state = job["state"]
        if state == "running" and not started:
            started = True
            sys.stderr.write(f"[pn] job {jid} started\n"); sys.stderr.flush()
        if state in EXIT:
            time.sleep(0.15); st.pump(); st.pump()
            code = job["exit_code"]
            if state == "done":
                sys.exit(0 if code is None else code)
            if state == "failed":
                sys.exit(1 if code is None else code)
            sys.exit(EXIT[state])
        st.pump()
        time.sleep(0.3)

def cmd_submit(a, cmd):
    if not cmd and not getattr(a, "task_type", None):
        sys.stderr.write("pn submit: missing -- CMD... (or --task-type NAME)\n"); sys.exit(2)
    r = _submit_req(a, cmd)
    if not r.get("ok"):
        sys.stderr.write(f"pn submit: {r.get('error')}\n")
        _print_kerne(r)
        sys.exit(3)
    _print_kerne(r)

    state = r.get("state")
    if state in ("blocked", "staged"):
        extra = f" deps={r.get('deps')}" if r.get("deps") else ""
        if r.get("nonce"):
            extra += f" nonce={r['nonce']}"
        print(f"{r['id']} {state}{extra}")
    else:
        print(f"{r['id']} {r.get('pos',0)}")

def cmd_status(a):
    r = _req({"verb": "status"})
    if not r.get("ok"):
        sys.stderr.write(f"pn: {r.get('error')}\n"); sys.exit(3)
    s, c, cfg = r["snap"], r["counts"], r["cfg"]
    print(f"portioneer {r.get('version')}  up {int(r.get('uptime',0))}s")
    print(f"  RAM avail {s['mem_available']}/{s['mem_total']} MiB   "
          f"swap {s['swap_used']}/{s['swap_total']} MiB   "
          f"batch.current {s['batch_current']} MiB")
    print(f"  PSI(mem) batch {s['psi_avg10']:.1f}  global {s['psi_global_avg10']:.1f}   "
          f"load {s['load1']:.2f}/{s['cpu_count']}  disk_free {s['disk_free']} MiB")
    print(f"  floor {cfg['mem_floor']}  batch_high {cfg['batch_high']}  "
          f"max_conc {cfg['max_concurrent']}  pressure_blocked={r['pressure_blocked']}")
    print(f"  jobs: " + "  ".join(f"{k}={v}" for k, v in sorted(c.items())) +
          f"   reserved {r['reserved']} MiB   oldest_wait {int(r['oldest_wait'])}s")

    _dpct = s.get("data_free_pct")
    if _dpct is not None:
        _marke = ("  <- unter dem Boden: es startet NICHTS mehr" if _dpct < 3.0 else
                  "  <- gedrosselt: Massenarbeit wartet, latenzkritische laeuft" if _dpct < 8.0
                  else "  <- Aufraeumen laeuft" if _dpct < 15.0 else "")
        print(f"  DATA frei {_dpct:.1f}%{_marke}")
    if r.get("wait_global"):
        print(f"  ACHTUNG - es wird gar nichts zugelassen: {r['wait_global']}")
    _wr = r.get("wait_reasons") or {}
    if _wr:
        _haeufig = {}
        for _g in _wr.values():
            _haeufig[_g] = _haeufig.get(_g, 0) + 1
        _g, _n = max(_haeufig.items(), key=lambda kv: kv[1])
        print(f"  {len(_wr)} Kopf/Koepfe warten, haeufigster Grund ({_n}x): {_g}")

