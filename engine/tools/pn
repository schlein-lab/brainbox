        print(f"job {a.id}: {st}  pos {pos} ({ahead} ahead)  waiting_on={wait}  eta {h}")
    else:
        print(f"job {a.id}: {st}  pos {pos}  waiting_on={wait}")

def cmd_list(a):
    r = _req({"verb": "list", "limit": a.limit})
    if not r.get("ok"):
        sys.stderr.write(f"pn: {r.get('error')}\n"); sys.exit(3)
    print(f"{'ID':>5} {'STATE':<9} {'PRI':>4} {'MEM':>5} {'KERNE':>5} {'EXIT':>4} {'PROG':>6} {'ROOM':<12} {'WAIT':>6}  TAG/CMD")
    now = time.time()
    for j in r["jobs"]:
        wait = int(now - j["submitted_at"])
        cmd = (j.get("client_tag") or "") or " ".join(json.loads(j["cmd"]))[:40]
        ex = "" if j["exit_code"] is None else j["exit_code"]
        room = (j.get("room") or "")[:12]

        kerne = "-"
        if j.get("kerne"):
            kerne = str(j["kerne"])
            if j.get("kerne_wunsch"):
                kerne += "<%d" % j["kerne_wunsch"]
        print(f"{j['id']:>5} {j['state']:<9} {j['prio']:>4} {j['mem_estimate']:>5} {kerne:>5} {str(ex):>4} "
              f"{_short_prog(j):>6} {room:<12} {wait:>5}s  {cmd[:40]}")

