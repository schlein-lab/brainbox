def cmd_llm(a):
    req = {"verb": "ask", "prompt": a.prompt, "model": a.model,
           "kind": ("dedicated" if a.dedicated else ("loose" if a.loose else None))}
    try:
        resp = send_request(req, timeout=a.timeout or 300, path=LLM_SOCK)
    except FileNotFoundError:
        sys.stderr.write("pn llm: pn-llmd not running\n"); sys.exit(3)
    except Exception as e:
        sys.stderr.write(f"pn llm: {e}\n"); sys.exit(3)
    if not resp.get("ok") and resp.get("error") == "empty":

        sys.stderr.write("pn llm: empty reply from pn-llmd\n"); sys.exit(3)
    if resp.get("ok"):
        sys.stdout.write(resp.get("text", ""))
        if not resp.get("text", "").endswith("\n"):
            sys.stdout.write("\n")
    else:
        sys.stderr.write(f"pn llm error: {resp.get('error')}\n"); sys.exit(1)

def cmd_progress(a):
    jid = a.id if a.id is not None else _self_job_id()
    if jid is None:
        sys.stderr.write("pn progress: no job id (run inside a pn job, or pass --id)\n"); sys.exit(2)
    req = {"verb": "progress", "id": jid}
    if a.done is not None: req["done"] = a.done
    if a.total is not None: req["total"] = a.total
    if a.msg is not None: req["msg"] = a.msg
    r = _req(req)
    if not r.get("ok"):
        sys.stderr.write(f"pn progress: {r.get('error')}\n"); sys.exit(3)

