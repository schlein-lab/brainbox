#!/usr/bin/env python3

import os, sys, time, json, signal, argparse, socket

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from pnlib import LOG_DIR, ipc
from pnlib.ipc import send_request

LLM_SOCK = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "pn-llmd.sock")
EXIT = {"done": None, "failed": None, "cancelled": 130, "timeout": 124, "rejected": 1}

def _req(d, timeout=15):
    try:
        return send_request(d, timeout=timeout)
    except FileNotFoundError:
        sys.stderr.write("pn: daemon not running (no socket). Start: systemctl --user start pnd\n")
        sys.exit(3)
    except Exception as e:
        sys.stderr.write(f"pn: cannot reach pnd: {e}\n")
        sys.exit(3)

def _req_soft(d, timeout=10):

    try:
        return send_request(d, timeout=timeout)
    except Exception:
        return None

def _self_job_id():
    v = os.environ.get("PN_JOB_ID", "")
    return int(v) if v.isdigit() else None

def _short_prog(j):
    d, t = j.get("prog_done"), j.get("prog_total")
    if d is not None and t:
        return f"{int(100 * d / t)}%" if t else str(d)
    if d is not None:
        return str(d)
    return "-"

def _fmt_progress(job, now=None, stall_s=300):
    d, t, m = job.get("prog_done"), job.get("prog_total"), job.get("prog_msg")
    bits = []
    if d is not None and t:
        filled = int(20 * min(d, t) / t) if t else 0
        bits.append("[" + "#" * filled + "." * (20 - filled) + f"] {d}/{t} ({int(100*d/t)}%)")
    elif d is not None:
        bits.append(f"{d} done")
    if m:
        bits.append(str(m))
    if now and job.get("prog_at") and job.get("state") == "running" and (now - job["prog_at"]) > stall_s:
        bits.append(f"STALLED {int(now - job['prog_at'])}s")
    return "  ".join(bits)

def _split_cmd(argv):
    if "--" not in argv:
        return argv, None
    i = argv.index("--")
    return argv[:i], argv[i + 1:]

