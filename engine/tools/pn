def cmd_watch(a):
    jid = a.id
    st = Streamer(jid)
    lastline = None
    lost_since = None
    GRACE = 120.0
    while True:
        jr = _req_soft({"verb": "job", "id": jid})
        if jr is None:
            now = time.time(); lost_since = lost_since or now
            if now - lost_since > GRACE:
                sys.stderr.write(f"pn watch: lost contact with pnd >{int(GRACE)}s\n"); sys.exit(3)
            time.sleep(1.0); continue
        lost_since = None
        if not jr.get("ok"):
            sys.stderr.write(f"pn watch: {jr.get('error')}\n"); sys.exit(3)
        job = jr["job"]
        line = _fmt_progress(job, jr.get("now"), jr.get("stall_s", 300))
        if line and line != lastline:
            sys.stderr.write(f"[pn {jid}] {job['state']}  {line}\n"); sys.stderr.flush()
            lastline = line
        st.pump()
        if job["state"] in EXIT:
            st.pump()
            sys.stderr.write(f"[pn {jid}] {job['state']} (exit {job['exit_code']})\n")
            sys.exit(0 if job["state"] == "done" and (job["exit_code"] in (0, None)) else 1)
        time.sleep(0.5)

