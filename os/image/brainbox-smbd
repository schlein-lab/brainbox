#!/bin/sh
set -u
exec >>/var/log/brainbox-smbd.log 2>&1
echo "=== brainbox-smbd run $(date -Is 2>/dev/null || echo '?') args=$* PATH=$PATH ==="
set -x

if ! command -v smbd >/dev/null 2>&1 && [ ! -x /usr/sbin/smbd ]; then
  echo "[brainbox-smbd] samba not installed — media server inactive (apt install samba to enable)" >&2
  exit 0
fi
SMBD=$(command -v smbd 2>/dev/null || echo /usr/sbin/smbd)
NMBD=$(command -v nmbd 2>/dev/null || echo /usr/sbin/nmbd)

for d in /run/samba /var/run/samba /var/lib/samba /var/lib/samba/private /var/cache/samba /var/log/samba; do
  mkdir -p "$d" 2>/dev/null || true
done

SHARES=/data/shares
PUBLIC="$SHARES/public"
mkdir -p "$PUBLIC" 2>/dev/null || true
SVCUSER=$(stat -c %U "$SHARES" 2>/dev/null || echo brainbox)
groupadd -f sharemembers 2>/dev/null || true
chown "$SVCUSER":sharemembers "$PUBLIC" 2>/dev/null || true
chmod 2775 "$PUBLIC" 2>/dev/null || true

CONF=/etc/samba/smb.conf
mkdir -p /etc/samba 2>/dev/null || true
if [ -f "$CONF" ] && head -3 "$CONF" | grep -q "GENERATED by pn_mediashare" \
   && { ! command -v testparm >/dev/null 2>&1 || testparm -s "$CONF" >/dev/null 2>&1; }; then
  echo "[brainbox-smbd] keeping portal-rendered smb.conf (session shares preserved)"
else
cat > "$CONF" <<SMB
# GENERATED by brainbox-smbd at boot — the portal's pn_mediashare regenerates this (same [global] +
# [public], plus per-session credential-gated shares) whenever a session share changes.
[global]
   workgroup = WORKGROUP
   netbios name = BRAINBOX
   server string = Brainbox Medienserver
   security = user
   map to guest = never
   server min protocol = SMB3
   smb encrypt = desired
   # NetBIOS aus: die Namensaufloesung laeuft ueber mDNS/WSD, die Broadcasts auf 137/138 sind
   # reines Grundrauschen -- und in ueberwachten Netzen ein Alarmgeber.
   disable netbios = yes
   restrict anonymous = 2
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes

[public]
   comment = Öffentlich (angemeldete Freigabe-Mitglieder lesen+schreiben; Agenten nur lesend)
   path = $PUBLIC
   browseable = yes
   read only = no
   # KEIN `guest ok = yes` mehr (02.08.2026). Solange noch kein Portal-Konto existierte -- also
   # waehrend des gesamten Erstinbetriebnahme-Fensters -- schrieb JEDER im LAN anonym als uid 1000
   # in genau das Verzeichnis, das Agenten-Zellen spaeter eingehaengt bekommen. Das ist ein
   # Malware-Ablageplatz mit direktem Weg in die Agentenumgebung.
   guest ok = no
   valid users = @sharemembers
   force user = $SVCUSER
   force group = sharemembers
   create mask = 0664
   directory mask = 2775
SMB
fi
if command -v testparm >/dev/null 2>&1 && ! testparm -s "$CONF" >/dev/null 2>&1; then
  echo "[brainbox-smbd] WARN: rendered smb.conf failed testparm" >&2
fi

rm -f /run/samba/smbd.pid /run/samba/nmbd.pid 2>/dev/null || true

_bbx_profile="home"
[ -r /etc/brainbox/site.conf ] && _bbx_profile="$(sed -n 's/^NET_PROFILE=//p' /etc/brainbox/site.conf | tail -1 | sed 's/#.*//' | tr -d '"'"'"'"'"' | tr -d "'"'"'" | tr -d " ")"
_bbx_profile="${_bbx_profile:-home}"
if [ "$_bbx_profile" = "managed" ]; then
  echo "[brainbox-smbd] Netzprofil 'managed' — Medienserver bleibt aus (kein SMB/NetBIOS/WSD)." >&2
  exit 0
fi

if [ "${1:-}" != "--setup-only" ]; then
  pidof smbd >/dev/null 2>&1 || { setsid "$SMBD" -F --no-process-group >/dev/null 2>&1 & }
  pidof nmbd >/dev/null 2>&1 || { setsid "$NMBD" -F --no-process-group >/dev/null 2>&1 & }
fi

if command -v wsdd >/dev/null 2>&1; then
  if ! pgrep -f '/wsdd' >/dev/null 2>&1; then
    setsid wsdd --shortlog --workgroup WORKGROUP -n brainbox >/dev/null 2>&1 &
  fi
else
  echo "[brainbox-smbd] wsdd absent — modern Windows won't auto-discover the box (apt install wsdd)" >&2
fi

exit 0
