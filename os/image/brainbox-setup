    // the HTTPS lane ("Weiter über die gesicherte Verbindung"). The server-
    // side cfg (language, certificate no-op) is already merged at that point;
    // this only restores the CLIENT's position so the switch loses nothing.
    var rl=qsParam("lang");
    LANG=(rl==="de"||rl==="en")?rl:"de";
    LB=D.labels[LANG]||D.labels.de;
    document.documentElement.lang=LANG;
    // Over the network the box hands a stranger only a stripped detection until
    // it proves the setup code. The on-screen QR carries that code as ?claim=, so
    // a scan lands here already proving it — auto-unlock, zero typing. Otherwise
    // ask for the 6-digit code once, up front; unlocking returns the full
    // detection so EVERY step — access included — has the data it needs.
    if(D.claim_required&&!CLAIMED){
      var qc=(qsParam("claim")||"").replace(/[^0-9]/g,"").slice(0,6);
      if(qc){autoClaim(qc);return;}
      showClaimGate("");return;
