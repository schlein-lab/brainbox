def _tty_ask(prompt, default="", validate=None, secret=False):

    import getpass
    while True:
        show = prompt
        if default != "" and not secret:
            show += " [%s]" % default
        show += ": "
        try:
            raw = getpass.getpass(show) if secret else input(show)
        except EOFError:
            raw = ""
        if raw == "" and not secret:
            raw = default
        if validate is None:
            return raw
        ok, res = validate(raw)
        if ok:
            return res
        print("  ! %s" % res)

def _tty_yesno(prompt, default=False):
    d = "Y/n" if default else "y/N"
    try:
        raw = input("%s [%s]: " % (prompt, d)).strip().lower()
    except EOFError:
        raw = ""
    if not raw:
        return default
    return raw in ("y", "yes", "j", "ja")

