    return "<div class='ostep'>1. "+h(t("cert_ios_1"))+"</div>"+
      "<div class='ostep'>2. "+h(t("cert_ios_2"))+"</div>"+
      "<div class='ostep'>3. "+h(t("cert_ios_3"))+"</div>"+
