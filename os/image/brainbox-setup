// --- collect + validate a step, POST to /api/validate ---
function val(id){var e=$(id);return e?e.value:"";}
function chkVal(id){var e=$(id);return e&&e.checked?1:0;}
function radioVal(name){var els=document.getElementsByName(name);
  for(var i=0;i<els.length;i++)if(els[i].checked)return els[i].value;return"";}
function clearErrs(){var es=document.querySelectorAll(".err");
  for(var i=0;i<es.length;i++)es[i].textContent="";}
// Server errors arrive as machine keys ("pw_mismatch") or as prose. t() falls
// through to its argument, so both work; "key|3" carries a line number.
function errText(v){
  var s=String(v||""), n=null, i=s.indexOf("|");
  if(i>0){n=s.slice(i+1); s=s.slice(0,i);}
  var out=t(s);
  return n?out.replace("%N%",n):out;
}
function showErrs(errs){for(var k in errs){var el=$("e_"+k);
  if(el)el.textContent=errText(errs[k]);}}

function collect(name){
  if(name==="language")return{step:"language",fields:{LANG_UI:radioVal("lang")}};
  if(name==="owner")return{step:"owner",fields:{owner_name:val("owner_name"),admin_pin:val("admin_pin")}};
  if(name==="access")return{step:"access",fields:{ssh_keys:val("ssh_keys"),
    claim_code:val("claim_code"),
    console_password:val("console_password"),
    console_password2:val("console_password2"),
    ssh_password_auth:chkVal("ssh_password_auth")}};
  if(name==="identity")return{step:"identity",fields:{hostname:val("hostname"),
    TZ:val("TZ"),LOCALE:val("LOCALE"),keymap:val("keymap")}};
  if(name==="network")return{step:"network",fields:{net_mode:radioVal("nmode"),
    net_ifname:val("net_ifname"),net_ip:val("net_ip"),net_prefix:val("net_prefix"),
    net_gateway:val("net_gateway"),net_dns:val("net_dns"),
    wifi_ssid:val("wifi_ssid"),wifi_psk:val("wifi_psk")}};
  if(name==="brain")return{step:"brain",fields:brainFields()};
  if(name==="features")return{step:"features",fields:{
    CELLS_ENABLED:chkVal("CELLS_ENABLED"),VOICE_ENABLED:chkVal("VOICE_ENABLED"),
    NET_PROFILE:(document.getElementById("NET_PROFILE_HOME")||{}).checked?"home":"managed"}};
  if(name==="advanced")return{step:"advanced",fields:{
    HA_ENABLED:chkVal("HA_ENABLED"),HA_VIP:val("HA_VIP"),HA_VRID:val("HA_VRID"),
    VRRP_AUTH_PASS:val("VRRP_AUTH_PASS"),TELEGRAM_TOKEN:val("TELEGRAM_TOKEN"),
    RELAY_ENABLED:chkVal("RELAY_ENABLED"),PRINTER_ENABLED:chkVal("PRINTER_ENABLED"),
    MEDIA_SERVER_ENABLED:chkVal("MEDIA_SERVER_ENABLED"),
    NAS_ENABLED:chkVal("NAS_ENABLED"),NAS_URL:val("NAS_URL"),NAS_USER:val("NAS_USER"),
    NAS_PASS:val("NAS_PASS"),EMAIL_HOST:val("EMAIL_HOST"),EMAIL_USER:val("EMAIL_USER"),
    EMAIL_PASS:val("EMAIL_PASS"),EMAIL_FROM:val("EMAIL_FROM")}};
  return{step:name,fields:{}};
}
function brainFields(){
  var m=radioVal("bmode");
  return{brain_mode:m,oauth_token:val("oauth_token"),api_key:val("api_key"),
