def detect_timezones():

    zones = set()
    skip_top = {"posix", "right", "SystemV", "Etc"}
    try:
        for root, dirs, files in os.walk(ZONEINFO_DIR):
            rel_top = os.path.relpath(root, ZONEINFO_DIR).split(os.sep)[0]
            if rel_top in skip_top and rel_top != ".":
                dirs[:] = []
                continue
            for fn in files:
                if fn.endswith(".tab") or fn.startswith("leap") or fn in (
                        "posixrules", "localtime", "zone.tab", "zone1970.tab",
                        "iso3166.tab", "tzdata.zi"):
                    continue
                full = os.path.join(root, fn)
                rel = os.path.relpath(full, ZONEINFO_DIR)

                if "/" in rel and not rel.startswith("."):
                    zones.add(rel)
        zones.add("UTC")
    except OSError:
        pass
    if not zones:
        return list(TZ_FALLBACK)
    return sorted(zones)

def detect_current_tz():
