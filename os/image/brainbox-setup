class Handler(BaseHTTPRequestHandler):
    server_version = "brainbox-setup/1.0"

    already_complete = False
    portal_ip = "127.0.0.1"

    csrf_token = secrets.token_urlsafe(24)

    claim_session_token = secrets.token_urlsafe(24)

    def log_message(self, fmt, *args):

        sys.stderr.write("[brainbox-setup] %s\n" % (fmt % args))

    def _same_origin(self):

        host = (self.headers.get("Host") or "").split(",")[0].strip()
        host_name = host.rsplit(":", 1)[0].strip("[]").lower() if host else ""
        for hdr in ("Origin", "Referer"):
            val = self.headers.get(hdr)
            if not val:
                continue
            try:
                h = (urllib.parse.urlsplit(val).hostname or "").lower()
            except Exception:
                return False
            if h and host_name and h != host_name:
                return False
            if h and not host_name:
                return False
        return True

    def _csrf_ok(self):

        ctype = (self.headers.get("Content-Type") or "").split(";")[0].strip()
        if ctype != "application/json":
            return (False, "content-type must be application/json")
        if not self._same_origin():
            return (False, "cross-origin request refused")
        tok = self.headers.get("X-CSRF-Token") or ""
        if not secrets.compare_digest(tok, type(self).csrf_token):
            return (False, "missing or invalid CSRF token")
        return (True, "")

    def _client_has_claim(self):

        want = type(self).claim_session_token
        for part in (self.headers.get("Cookie") or "").split(";"):
            k, _, v = part.strip().partition("=")
            if k == "bbxclaim" and v and secrets.compare_digest(v, want):
                return True
        return False

    def _send(self, code, body, ctype="application/json; charset=utf-8",
              extra_headers=None):
        if isinstance(body, (dict, list)):
            body = json.dumps(body).encode("utf-8")
        elif isinstance(body, str):
            body = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        for hk, hv in (extra_headers or ()):
            self.send_header(hk, hv)
        self.end_headers()
        try:
            self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def _read_json(self):
        try:
            n = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            n = 0
        if n <= 0 or n > 1_000_000:
            return {}
        raw = self.rfile.read(n)
        try:
            return json.loads(raw.decode("utf-8"))
        except Exception:
            return {}

    def _claim_proof(self, code):

        try:
            if box_is_claimed():
                return (True, "")
        except Exception:
            pass
        peer = self.client_address[0] if getattr(self, "client_address", None) else ""
        if peer in ("127.0.0.1", "::1", "::ffff:127.0.0.1"):
            return (True, "")
        if self._client_has_claim():
            return (True, "")
        with _CLAIM_RL_LOCK:
            if time.monotonic() < _CLAIM_RL["until"]:
                return (False, "claim_code_locked")
        want = _read_setup_code()
        if not want:
            return (False, "claim_code_unavailable")
        code = "".join(ch for ch in (code or "") if ch.isdigit())
        if not code:
            return (False, "claim_code_required")
        if secrets.compare_digest(code, want):
            with _CLAIM_RL_LOCK:
                _CLAIM_RL["fails"] = 0
                _CLAIM_RL["until"] = 0.0
            return (True, "")
        with _CLAIM_RL_LOCK:
            _CLAIM_RL["fails"] += 1
            if _CLAIM_RL["fails"] >= 5:
                _CLAIM_RL["until"] = time.monotonic() + min(300, 2 ** (_CLAIM_RL["fails"] - 4))
        return (False, "claim_code_invalid")

    def _force_requested(self):

        return False

    def do_GET(self):
        path = self.path.split("?", 1)[0]

        if path in ("/ca.crt", "/api/ca"):
            if path == "/ca.crt":
                self._send_ca()
            else:
                self._send(200, build_ca_payload())
            return

        if path in ("/claude", "/anmelden"):
            page = CLAUDE_PAGE_HTML.replace("__CSRF_TOKEN__",
                                            type(self).csrf_token)
            self._send(200, page, "text/html; charset=utf-8")
            return

        if path == "/healthz":
            self._send(200, {"ok": True, "setup_complete": self.already_complete})
            return
        if self.already_complete and not self._force_requested():
            if path == "/trust":
                self._redirect_page()
                return
            self._redirect_page()
            return
        if path == "/":
            page = PAGE_HTML.replace("__CSRF_TOKEN__", type(self).csrf_token)

            page = page.replace("__STEPS_JSON__", json.dumps(list(STEPS_ORDER)))
            self._send(200, page, "text/html; charset=utf-8")
        elif path == "/api/detect":
            payload = build_detect_payload()

            try:
                claimed = box_is_claimed()
            except Exception:
                claimed = True
            peer = self.client_address[0] if getattr(self, "client_address", None) else ""
            is_local = peer in ("127.0.0.1", "::1", "::ffff:127.0.0.1")

            if not claimed and not is_local and not self._client_has_claim():
                payload = _detect_payload_public(payload)
            self._send(200, payload)
        elif path == "/api/certcheck":
            self._send(200, portal_tls_check())
        elif path == "/trust":
            self._redirect_page()
        else:
            self._send(404, {"error": "not found"})

    def _send_ca(self):
        ident = detect_service_identity()
        pem = None
        try:
            p = _ca_ensure(ident)
            if p:
                with open(p, "rb") as f:
                    pem = f.read()
        except OSError:
            pem = None
        if not pem:
            self._send(503, {"error": "certificate not available yet"})
            return
        self.send_response(200)
        self.send_header("Content-Type", "application/x-x509-ca-cert")
        self.send_header("Content-Disposition",
                         'attachment; filename="%s"' % CA_DOWNLOAD_NAME)
        self.send_header("Content-Length", str(len(pem)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        try:
            self.wfile.write(pem)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def _redirect_page(self):

        url = "https://brainbox.local:%d" % _portal_port()
        html = ("<!doctype html><meta charset=utf-8>"
                "<meta http-equiv=refresh content='5;url=%s'>"
                "<style>body{font-family:system-ui;margin:3rem auto;max-width:32rem;"
                "text-align:center;color:#333}a{color:#2563eb}</style>"
                "<h2>Brainbox</h2><p>Eingerichtet — öffnen: "
                "<a href='%s'>%s</a></p>"
                "<p style='font-size:.85rem'>Neues Gerät? "
                "<a href='/ca.crt'>Zertifikat herunterladen</a></p>"
                % (url, url, url))
        self._send(200, html, "text/html; charset=utf-8")

    CLAUDE_POST_PATHS = ()

    def do_POST(self):
        path = self.path.split("?", 1)[0]
        if self.already_complete and not self._force_requested() \
                and path not in self.CLAUDE_POST_PATHS:
            self._send(403, {"error": "setup already complete"})
            return
        ok, msg = self._csrf_ok()
        if not ok:
            self._send(403, {"error": msg})
            return
        data = self._read_json()
        cfg = get_session_cfg()
        if path == "/api/claude-save":
            self._send(200, claude_signin_save(data.get("token", "")))
            return
        if path == "/api/claim":

            ok, reason = self._claim_proof((data or {}).get("claim_code", ""))
            if not ok:
                self._send(200, {"ok": False, "error": reason})
                return
            cookie = ("bbxclaim=%s; HttpOnly; SameSite=Strict; Path=/"
                      % type(self).claim_session_token)
            self._send(200, {"ok": True}, extra_headers=(("Set-Cookie", cookie),))
            return
        if path == "/api/validate":
            step = data.get("step", "")
            fields = data.get("fields", {}) or {}
            with _CFG_LOCK:
                ok, errors = validate_and_merge(cfg, step, fields)
            if step == "access":
                cok, creason = self._claim_proof(fields.get("claim_code", ""))
                if not cok:
                    ok = False
                    errors = dict(errors or {})
                    errors["claim_code"] = creason
            self._send(200, {"ok": ok, "errors": errors})
        elif path == "/api/verify-brain":

            fields = data.get("fields", {}) or {}
            with _CFG_LOCK:
                validate_and_merge(cfg, "brain", fields)
                result = verify_brain(cfg)
            self._send(200, result)
        elif path == "/api/login/start":

            ident = cfg.get("_ident") or detect_service_identity()
            res = login_start(ident, data.get("provider", "claude"))
            try:
                self._send(200, res)
            except Exception:

                if res.get("session"):
                    _login_reap(res["session"], "browser gone")
                raise
        elif path == "/api/login/poll":
            self._send(200, login_poll(data.get("session", "")))
        elif path == "/api/login/input":

            self._send(200, login_input(data.get("session", ""),
                                        data.get("text", ""),
                                        data.get("key", "")))
        elif path == "/api/login/cancel":
            self._send(200, login_cancel(data.get("session", "")))
        elif path == "/api/summary":
            with _CFG_LOCK:
                self._send(200, _sanitize_payload(cfg))
        elif path == "/api/apply":

            cok, creason = self._claim_proof((data or {}).get("claim_code", ""))
            if not cok:
                self._send(403, {"error": creason})
                return
            with _CFG_LOCK:
                payload = apply(cfg)

                type(self).already_complete = box_is_claimed()

            _reload_wizard_tls()
            self._send(200, payload)

            try:
                self.wfile.flush()
            except Exception:
                pass
            deferred_network_apply(cfg)
        else:
            self._send(404, {"error": "not found"})

