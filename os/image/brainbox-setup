def _to_int01(v, default=0):
    if isinstance(v, bool):
        return 1 if v else 0
    s = str(v).strip().lower()
    if s in ("1", "true", "on", "yes"):
        return 1
    if s in ("0", "false", "off", "no", ""):
        return 0
    return default

def validate_and_merge(cfg, step, fields):

    errors = {}

    def setf(dst, key, val):
        dst[key] = val

    if step == "language":
        lang = fields.get("LANG_UI", "de")
        if lang not in ("de", "en"):
            errors["LANG_UI"] = "invalid"
        else:
            cfg["LANG_UI"] = lang

            if cfg.get("LOCALE") in ("de_DE.UTF-8", "en_US.UTF-8"):
                cfg["LOCALE"] = "de_DE.UTF-8" if lang == "de" else "en_US.UTF-8"

    elif step == "owner":
        ok, res = validate_owner_name(fields.get("owner_name", ""))
        if not ok:
            errors["owner_name"] = res
        else:
            cfg["owner_name"] = res
        raw_pin = (fields.get("admin_pin") or "").strip()
        ok, res = validate_pin(raw_pin)
        if not ok:
            errors["admin_pin"] = res
        else:
            cfg["admin_pin"] = res

            cfg["_pin_generated"] = (raw_pin == "")

    elif step == "access":

        ok, res = validate_ssh_keys(fields.get("ssh_keys", ""))
        if not ok:
            errors["ssh_keys"] = res
        else:
            cfg["ssh_keys"] = res
        pw = fields.get("console_password") or ""
        ok, res = validate_console_password(pw, fields.get("console_password2"))
        if not ok:
            errors["console_password"] = res
        elif pw:

            cfg["console_password"] = res
        want = _to_int01(fields.get("ssh_password_auth", 0))
        if want and not cfg.get("console_password") \
                and detect_access_state()["initial_pw"]:

            errors["ssh_password_auth"] = "pw_auth_needs_new_pw"
            want = 0
        cfg["ssh_password_auth"] = want

    elif step == "identity":
        ok, res = validate_hostname(fields.get("hostname", ""))
        if not ok:
            errors["hostname"] = res
        else:
            cfg["hostname"] = res
        tz = (fields.get("TZ") or "").strip()
        if tz:
            ok, res = validate_timezone(tz)
            if ok:
                cfg["TZ"] = res
            else:
                errors["TZ"] = res
        loc = (fields.get("LOCALE") or "").strip()
        if loc:
            if loc in KNOWN_LOCALES:
                cfg["LOCALE"] = loc
            else:
                errors["LOCALE"] = "unknown locale"
        ok, res = validate_keymap(fields.get("keymap", ""))
        if not ok:
            errors["keymap"] = res
        else:
            cfg["keymap"] = res

    elif step == "network":
        mode = fields.get("net_mode", "dhcp")
        if mode not in ("dhcp", "static"):
            errors["net_mode"] = "invalid"
            mode = "dhcp"
        cfg["net"]["mode"] = mode
        ifname = (fields.get("net_ifname") or "").strip()
        valid_ifs = [n["name"] for n in detect_nics()]
        if ifname:
            if ifname in valid_ifs:
                cfg["net"]["ifname"] = ifname
            else:
                errors["net_ifname"] = "unknown interface"
        if mode == "static":
            ok, res = validate_ipv4(fields.get("net_ip", ""))
            if not ok:
                errors["net_ip"] = res
            else:
                cfg["net"]["ip"] = res
            prefix_in = fields.get("net_prefix", "")
            if prefix_in in ("", None):
                prefix_in = 24
            ok, res = validate_prefix(prefix_in)
            if not ok:
                errors["net_prefix"] = res
            else:
                cfg["net"]["prefix"] = res

            gw = (fields.get("net_gateway") or "").strip()
            if not gw:
                errors["net_gateway"] = "net_gw_required"
            else:
                ok, res = validate_ipv4(gw)
                if not ok:
                    errors["net_gateway"] = res
                else:
                    cfg["net"]["gateway"] = res
            ok, res = validate_dns_list(fields.get("net_dns", ""))
            if not ok:
                errors["net_dns"] = res
            else:
                cfg["net"]["dns"] = res

        ssid = fields.get("wifi_ssid", "")
        psk = fields.get("wifi_psk", "")
        ok, res = validate_ssid(ssid)
        if not ok:
            errors["wifi_ssid"] = res
        else:
            cfg["wifi"]["ssid"] = res
        if cfg["wifi"]["ssid"]:
            ok, res = validate_psk(psk)
            if not ok:
                errors["wifi_psk"] = res
            else:
                cfg["wifi"]["psk"] = res
                cfg["WIFI_PSK"] = res

    elif step == "brain":
        mode = fields.get("brain_mode", "subscription")
        if mode not in ("subscription", "apikey", "custom"):
            errors["brain_mode"] = "invalid"
            mode = "subscription"
        cfg["brain"]["mode"] = mode
        if mode == "subscription":
            tok = (fields.get("oauth_token") or "").strip()
            if tok:

                cfg["brain"]["oauth_token"] = tok
            elif login_signed_in(cfg.get("_ident") or {}):

                cfg["brain"]["oauth_token"] = ""
            else:
                errors["oauth_token"] = "required"
        elif mode == "apikey":
            key = (fields.get("api_key") or "").strip()
            if not RE_APIKEY.match(key):
                errors["api_key"] = "must start with sk-ant-"
            else:
                cfg["brain"]["api_key"] = key
        elif mode == "custom":
            url = (fields.get("base_url") or "").strip()
            if not RE_URL.match(url):
                errors["base_url"] = "must be an http(s) URL"
            else:
                cfg["brain"]["base_url"] = url
            lk = (fields.get("llm_key") or "").strip()
            if not lk:
                errors["llm_key"] = "required"
            else:
                cfg["brain"]["llm_key"] = lk
            model = (fields.get("model") or "").strip()
            if not model:
                errors["model"] = "required"
            else:
                cfg["brain"]["model"] = model

    elif step == "features":
        home = cfg["_ident"]["SERVICE_HOME"]
        want_cells = _to_int01(fields.get("CELLS_ENABLED", 0))

        if want_cells and not detect_cells_available(home):
            cfg["CELLS_ENABLED"] = 0
        else:
            cfg["CELLS_ENABLED"] = want_cells
        cfg["VOICE_ENABLED"] = _to_int01(fields.get("VOICE_ENABLED", 1))

        cfg["NET_PROFILE"] = "home" if str(fields.get("NET_PROFILE", "")).strip() == "home" else "managed"

    elif step == "advanced":

        ha = _to_int01(fields.get("HA_ENABLED", 0))
        cfg["HA_ENABLED"] = ha
        if ha:
            ok, res = validate_ipv4(fields.get("HA_VIP", ""))
            if not ok:
                errors["HA_VIP"] = res
            else:
                cfg["HA_VIP"] = res
            ok, res = validate_vrid(fields.get("HA_VRID", 51))
            if not ok:
                errors["HA_VRID"] = res
            else:
                cfg["HA_VRID"] = res
            cfg["VRRP_AUTH_PASS"] = (fields.get("VRRP_AUTH_PASS") or "").strip()

        tg = (fields.get("TELEGRAM_TOKEN") or "").strip()
        if tg:
            if not RE_TELEGRAM.match(tg):
                errors["TELEGRAM_TOKEN"] = "invalid bot token"
            else:
                cfg["TELEGRAM_TOKEN"] = tg

        cfg["RELAY_ENABLED"] = _to_int01(fields.get("RELAY_ENABLED", 0))
        cfg["MEDIA_SERVER_ENABLED"] = _to_int01(fields.get("MEDIA_SERVER_ENABLED", 0))
        
        
        
        cfg["PRINTER_ENABLED"] = 0

        nas = _to_int01(fields.get("NAS_ENABLED", 0))
        cfg["NAS_ENABLED"] = nas
        if nas:
            url = (fields.get("NAS_URL") or "").strip()
            if not url:
                errors["NAS_URL"] = "required when NAS enabled"
            else:
                cfg["NAS_URL"] = url
            cfg["NAS_USER"] = (fields.get("NAS_USER") or "").strip()
            cfg["NAS_PASS"] = (fields.get("NAS_PASS") or "")

        eh = (fields.get("EMAIL_HOST") or "").strip()
        eu = (fields.get("EMAIL_USER") or "").strip()
        ep = (fields.get("EMAIL_PASS") or "")
        ef = (fields.get("EMAIL_FROM") or "").strip()
        if eh or eu or ep:
            if not (eh and eu and ep):
                errors["EMAIL_HOST"] = "host, user and password required together"
            else:
                cfg["email"] = {"host": eh, "user": eu, "pass": ep, "from": ef}
    elif step in STEPS_ORDER:

        pass
    else:
        errors["_step"] = "unknown step"

    return (len(errors) == 0, errors)

