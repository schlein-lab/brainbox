    "<button class='primary' id='claimBtn'>"+h(t("next"))+"</button></div>";
  if(err){var el=$("e_claim_code");if(el)el.textContent=errText(err);}
  var inp=$("claim_code"),b=$("claimBtn");
  function go(){
    var code=((inp&&inp.value)||"").replace(/[^0-9]/g,"");
    if(!code){showClaimGate("claim_code_required");return;}
    if(b)b.disabled=true;
    api("POST","/api/claim",{claim_code:code}).then(function(r){
      if(r&&r.ok){CLAIMED=true;boot();return;}
      showClaimGate((r&&r.error)||"claim_code_invalid");
    }).catch(function(){showClaimGate("claim_code_invalid");});
  }
  if(b)b.onclick=go;
  if(inp){
    inp.oninput=function(){var x=inp.value.replace(/[^0-9]/g,"").slice(0,6);if(x!==inp.value)inp.value=x;};
    inp.onkeydown=function(e){if(e.key==="Enter"){e.preventDefault();go();}};
    inp.focus();
  }
}

