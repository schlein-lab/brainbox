def _netplan_yaml(cfg):
    net = cfg.get("net", {})
    ifname = net.get("ifname") or "eth0"
    wifi = cfg.get("wifi", {})
    wifi_if = cfg.get("_wifi_ifname")
    have_wifi = bool(wifi.get("ssid") and wifi.get("psk") and wifi_if)

    emit_eth = not (have_wifi and ifname == wifi_if)

    renderer = "NetworkManager" if _nm_active() else "networkd"
    lines = ["# brainbox netplan — generated by brainbox-setup (mode 0600)",
             "network:", "  version: 2", "  renderer: %s" % renderer]
    if emit_eth:
        lines.append("  ethernets:")
        if net.get("mode") == "static":
            lines.append("    %s:" % ifname)
            lines.append("      dhcp4: false")
            lines.append("      addresses: [%s/%s]" % (net.get("ip", ""),
                                                       net.get("prefix", 24)))
            if net.get("gateway"):
                lines.append("      routes:")
                lines.append("        - to: default")
                lines.append("          via: %s" % net["gateway"])
            dns = net.get("dns") or []
            if dns:
                lines.append("      nameservers:")
                lines.append("        addresses: [%s]" % ", ".join(dns))
        else:
            lines.append("    %s:" % ifname)
            lines.append("      dhcp4: true")

    if have_wifi:
        lines.append("  wifis:")
        lines.append("    %s:" % wifi_if)
        lines.append("      dhcp4: true")
        lines.append("      access-points:")
        lines.append("        \"%s\":" % wifi["ssid"])
        lines.append("          password: \"%s\"" % wifi["psk"])
    return "\n".join(lines) + "\n"

def _nm_keyfile(cfg):

    net = cfg.get("net", {})
    ifname = net.get("ifname") or "eth0"
    lines = ["# brainbox — generated by brainbox-setup (mode 0600)",
             "[connection]", "id=brainbox", "uuid=%s" % _stable_uuid("brainbox"),
             "type=ethernet", "interface-name=%s" % ifname, "autoconnect=true",
             "", "[ethernet]", "", "[ipv4]"]
    if net.get("mode") == "static":
        addr = "%s/%s" % (net.get("ip", ""), net.get("prefix", 24))
        lines.append("method=manual")
        lines.append("address1=%s" % addr)
        if net.get("gateway"):
            lines.append("gateway=%s" % net["gateway"])
        dns = net.get("dns") or []
        if dns:
            lines.append("dns=%s;" % ";".join(dns))
    else:
        lines.append("method=auto")
    lines += ["", "[ipv6]", "method=auto", ""]
    return "\n".join(lines) + "\n"

