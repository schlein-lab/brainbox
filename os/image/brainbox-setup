// the claim cookie so the box trusts this browser with the full detection. The
// field is numeric-only (the code is digits) so a phone shows the number pad.
function showClaimGate(err){
  relabelHeader();
  var sn=$("stepno");if(sn)sn.textContent="";
  var bar=$("bar");if(bar)bar.style.width="8%";
  $("view").innerHTML=
    "<div class='step-title'>"+h(t("claim_gate_title"))+"</div>"+
