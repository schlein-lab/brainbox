    return "<div class='ostep'>1. "+h(t("cert_android_1"))+"</div>"+
      "<div class='ostep'>2. "+h(t("cert_android_2"))+"</div>"+
      "<div class='hint'>"+h(t("cert_android_note"))+"</div>";
  }
  if(os==="win"){
