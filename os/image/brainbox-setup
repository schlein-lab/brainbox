            tgt = os.readlink("/etc/localtime")
            marker = "zoneinfo/"
            if marker in tgt:
                return tgt.split(marker, 1)[1]
    except OSError:
        pass
    try:
        with open("/etc/timezone") as f:
            tz = f.read().strip()
            if tz:
                return tz
    except OSError:
        pass
    return "UTC"

