def detect_lease(ifname=None):

    out = {"ip": "", "prefix": 24, "gateway": "", "dns": []}
    if not shutil.which("ip"):
        return out
    rc, txt, _ = run(["ip", "-o", "-4", "addr", "show"], timeout=5)
    if rc == 0:
        for line in txt.splitlines():
            parts = line.split()
            if len(parts) >= 4 and parts[1] != "lo":
                if ifname and parts[1] != ifname:
                    continue
                cidr = parts[3]
                if "/" in cidr:
                    out["ip"], p = cidr.split("/", 1)
                    try:
                        out["prefix"] = int(p)
                    except ValueError:
                        pass
                    break
    rc, txt, _ = run(["ip", "-o", "-4", "route", "show", "default"], timeout=5)
    if rc == 0:
        for line in txt.splitlines():
            parts = line.split()
            if "via" in parts:
                out["gateway"] = parts[parts.index("via") + 1]
                if not ifname or ("dev" in parts and
                                  parts[parts.index("dev") + 1] == ifname):
                    break
    dns = []
    if shutil.which("resolvectl"):
        rc, txt, _ = run(["resolvectl", "dns"], timeout=5)
        if rc == 0:
            for tok in txt.replace(":", " ").split():
                if RE_IPV4.match(tok) and tok not in dns:
                    dns.append(tok)
    if not dns:
        try:
            with open("/etc/resolv.conf") as f:
                for line in f:
                    if line.startswith("nameserver"):
                        ip = line.split()[1]
                        if RE_IPV4.match(ip) and ip not in dns:
                            dns.append(ip)
        except OSError:
            pass
    dns = [d for d in dns if not d.startswith("127.")]
    if not dns and out["gateway"]:
        dns = [out["gateway"]]
    out["dns"] = dns[:3]
    return out

def detect_serial():
    try:
        with open("/proc/cpuinfo") as f:
            for line in f:
                if line.lower().startswith("serial"):
                    val = line.split(":", 1)[1].strip()
                    if val:
                        return val[-8:].lower()
    except OSError:
        pass
    try:
        with open("/sys/firmware/devicetree/base/serial-number", "rb") as f:
            val = f.read().split(b"\x00", 1)[0].decode("ascii", "ignore").strip()
            if val:
                return val[-8:].lower()
    except OSError:
        pass
    try:
        with open("/etc/machine-id") as f:
            mid = f.read().strip()
            if mid:
                return mid[:8].lower()
    except OSError:
        pass
    return secrets.token_hex(3)

