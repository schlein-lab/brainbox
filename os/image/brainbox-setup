def _verify_apikey(api_key):

    body = json.dumps({
        "model": APIKEY_VERIFY_MODEL,
        "max_tokens": 1,
        "messages": [{"role": "user", "content": "hi"}],
    }).encode("utf-8")
    req = urllib.request.Request(ANTHROPIC_MESSAGES_URL, data=body, method="POST")
    req.add_header("x-api-key", api_key)
    req.add_header("anthropic-version", ANTHROPIC_VERSION)
    req.add_header("content-type", "application/json")
    try:

        with urllib.request.urlopen(req, timeout=T_APIKEY_VERIFY):
            return {"ok": True, "detail": "API key valid"}
    except urllib.error.HTTPError as e:

        if e.code in (401, 403):
            return {"ok": False, "detail": "invalid API key"}
        return {"ok": True,
                "detail": "API key accepted (endpoint returned HTTP %s)" % e.code}
    except (urllib.error.URLError, socket.timeout, OSError):
        return {"ok": False,
                "detail": "could not reach api.anthropic.com — stored, verify later"}

def _host_is_metadata(host):

    h = (host or "").strip("[]").lower()
    if h in ("metadata", "metadata.google.internal"):
        return True
    m = RE_IPV4.match(h)
    if m and m.group(1) == "169" and m.group(2) == "254":
        return True
    return False

def _verify_custom(base_url, api_key, model):

    try:
        host = urllib.parse.urlsplit(base_url).hostname or ""
    except Exception:
        host = ""
    if _host_is_metadata(host):
        return {"ok": False,
                "detail": "refusing to probe link-local/metadata address"}
    url = base_url.rstrip("/") + "/models"
    req = urllib.request.Request(url, method="GET")
    if api_key:
        req.add_header("Authorization", "Bearer %s" % api_key)
    try:
        with urllib.request.urlopen(req, timeout=T_CUSTOM_VERIFY) as resp:
            if resp.status == 200:
                detail = "models endpoint reachable"
                try:
                    data = json.loads(resp.read().decode("utf-8", "replace"))
                    ids = []
                    if isinstance(data, dict) and isinstance(data.get("data"), list):
                        ids = [m.get("id") for m in data["data"]
                               if isinstance(m, dict)]
                    if model and model in ids:
                        detail = "model '%s' present" % model
                except Exception:
                    pass
                return {"ok": True, "detail": detail}
            return {"ok": False, "detail": "status %s" % resp.status}
    except urllib.error.HTTPError as e:
        return {"ok": False,
                "detail": "models endpoint not verifiable (HTTP %s) — stored" % e.code}
    except (urllib.error.URLError, socket.timeout, OSError):
        return {"ok": False,
                "detail": "models endpoint not verifiable — stored"}

def verify_brain(cfg):

    try:
        brain = cfg.get("brain", {})
        mode = brain.get("mode", "subscription")
        ident = cfg["_ident"]
        if mode == "subscription":
            tok = (brain.get("oauth_token") or "").strip()
            if tok:
                return _verify_subscription(tok, ident)

            lv = _login_verify(_login_spec("claude"), ident)
            if lv.get("connected"):
                return {"ok": True,
                        "detail": "signed in (subscription, file credential; method=%s)"
                                  % (lv.get("method") or "oauth")}
            if lv.get("cred"):
                return {"ok": True,
                        "detail": "credential file present (subscription)"}
            return {"ok": False, "detail": "no token provided"}
        if mode == "apikey":
            key = (brain.get("api_key") or "").strip()
            if not key:
                return {"ok": False, "detail": "no API key provided"}
            return _verify_apikey(key)
        if mode == "custom":
            return _verify_custom(brain.get("base_url", ""),
                                  brain.get("llm_key", ""),
                                  brain.get("model", ""))
        return {"ok": False, "detail": "unknown brain mode"}
    except Exception as e:
        return {"ok": False, "detail": "verify error: %s" % e}

