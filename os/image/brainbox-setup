function csrfTok(){var m=document.querySelector('meta[name="bbx-csrf"]');
  return m?m.getAttribute("content"):"";}
function api(method,path,body){
  var hdrs={"Content-Type":"application/json"};
  if(method!=="GET")hdrs["X-CSRF-Token"]=csrfTok();
  return fetch(path,{method:method,headers:hdrs,
    body:body?JSON.stringify(body):undefined}).then(function(r){return r.json();});
