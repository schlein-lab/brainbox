function detectOS(){
  var u=navigator.userAgent||"";
  if(/iPhone|iPad|iPod/i.test(u))return "ios";
  if(/Android/i.test(u))return "android";
  if(/Windows/i.test(u))return "win";
  if(/Mac OS X|Macintosh/i.test(u))return "mac";
  return "linux";
