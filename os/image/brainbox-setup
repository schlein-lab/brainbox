  }).catch(function(){
    b.disabled=false;
    if(hintEl)hintEl.innerHTML="<div class='err'>Die Box hat nicht geantwortet.</div>";
  });
}

// The CLI's own last words, so a failure quotes the vendor instead of this
// page inventing a reason for it.
function lastLine(lines){
  for(var i=(lines||[]).length-1;i>=0;i--){
    var s=(lines[i]||"").trim();
    if(s&&s.indexOf("http")<0&&s.indexOf("Paste code here")!==0)return s;
  }
  return "";
}

function tick(){
