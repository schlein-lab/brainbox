def _env_merge_file(path, drop_keys, add_pairs, mode):

    drop_re = re.compile(r"^\s*(export\s+)?(%s)=" % "|".join(drop_keys))
    kept = []
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                if drop_re.match(line):
                    continue
                kept.append(line.rstrip("\n"))
    except OSError:
        kept = []
    for k, v in add_pairs:
        kept.append("%s=%s" % (k, shq(v)))
    text = "\n".join(kept).rstrip("\n") + "\n"
    _atomic_write(path, text, mode=mode, uid=0, gid=0)

def claude_signin_save(token):

    token = (token or "").strip()
    if not RE_OAUTH_TOKEN.match(token):
        return {"ok": False, "detail": "kein gültiger Abo-Token"}
    ident = detect_service_identity()
    v = _verify_subscription(token, ident)
    pairs = [("CLAUDE_CODE_OAUTH_TOKEN", token)]
    try:
        _env_merge_file(SECRETS_ENV, BRAIN_ENV_KEYS, pairs, 0o600)
        _env_merge_file(PND_ENV, BRAIN_ENV_KEYS, pairs, 0o600)
    except OSError as e:
        return {"ok": False, "detail": "konnte nicht gespeichert werden: %s" % e}

    notes = []
    if detect_tool("pnctl"):
        for svc in ("pn-llmd", "brainbox-portal"):
            rc, _, _ = run(["pnctl", "restart", svc], timeout=T_HANDOFF)
            if rc != 0:
                rc, _, _ = run(["pnctl", "up", svc], timeout=T_HANDOFF)
            notes.append("%s rc=%s" % (svc, rc))
    return {"ok": True, "verified": bool(v.get("ok")),
            "detail": v.get("detail") or "", "restart": ", ".join(notes)}

