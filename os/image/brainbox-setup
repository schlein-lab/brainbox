    var md=$("m_dhcp"), ms=$("m_static");
    if(md)md.className="radio"+(m==="dhcp"?" sel":"");
    if(ms)ms.className="radio"+(m==="static"?" sel":"");
    if(m==="static")prefillStatic();
  }
  var rs=document.getElementsByName("nmode");
  for(var i=0;i<rs.length;i++)rs[i].onchange=syncMode;
  var ifs=$("net_ifname"); if(ifs)ifs.onchange=syncWifi;
  // opening "Advanced" selects static; closing it returns to the DHCP default so a
  // curiosity open->collapse never leaves the step silently pinned to static.
  var d=$("netAdv");
