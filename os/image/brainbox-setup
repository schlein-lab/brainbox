def _verify_subscription(token, ident):

    home = ident["SERVICE_HOME"]
    user = ident["SERVICE_USER"]
    claude = detect_tool("claude", home)
    if not claude:
        return {"ok": False,
                "detail": "claude CLI not found; token stored, verify later"}
    env = dict(os.environ)
    env["CLAUDE_CODE_OAUTH_TOKEN"] = token
    env["HOME"] = home

    if _is_root() and shutil.which("runuser"):
        cmd = ["runuser", "-w", "CLAUDE_CODE_OAUTH_TOKEN,HOME",
               "-u", user, "--", claude, "-p", "reply with OK"]
        rc, out, err = run(cmd, timeout=T_CLAUDE_VERIFY, env=env)
    else:
        rc, out, err = run([claude, "-p", "reply with OK"],
                           timeout=T_CLAUDE_VERIFY, env=env)
    blob = ((out or "") + " " + (err or "")).lower()
    auth_fail = re.search(r"auth|unauthor|login|401|403", blob)
    if rc == 0 and out.strip() and not auth_fail:
        return {"ok": True, "detail": "claude CLI responded"}
    if auth_fail:
        return {"ok": False, "detail": "token rejected (auth error)"}
    return {"ok": False,
            "detail": "claude CLI did not confirm (rc=%s); token stored" % rc}

