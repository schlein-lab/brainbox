  var pFetch=fetch(url,{mode:"no-cors",cache:"no-store",
                        signal:ctrl?ctrl.signal:undefined})
    .then(function(){return "ok";},
          function(e){return (e&&e.name==="AbortError")?"timeout":"fail";});
  var pSrv=api("GET","/api/certcheck")
    .then(function(r){return r;},function(){return null;});
  Promise.all([pFetch,pSrv]).then(function(res){
    if(to)clearTimeout(to);
    var cl=res[0], srv=res[1];
