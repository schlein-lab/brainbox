  // The code Claude shows has the form <code>#<state>. Copying only the part
  // before the '#' is the classic mistake, so name it immediately -- but send
  // it anyway: Claude's CLI is the authority on its own code format, and this
  // page must not start rejecting valid codes if that format ever changes.
  if(hintEl){
    hintEl.innerHTML = code.indexOf("#")<0
      ? "<div class='warn'>Achtung: Der Code enthält normalerweise ein „#“ und "+
        "geht danach noch weiter. Bitte prüfen, ob wirklich alles kopiert "+
        "wurde — er wird trotzdem gesendet.</div>"
      : "";
  }
  var b=$("send"); b.disabled=true;
  post("/api/login/input",{session:SID,text:code,key:"enter"}).then(function(r){
    b.disabled=false;
    if(!r.ok){
