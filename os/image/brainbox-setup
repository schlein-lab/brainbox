function syncWifi(){
  var wb=$("wifiBox"); if(!wb)return;
  var ifn=val("net_ifname"), isw=false, nics=(D&&D.nics)||[];
  for(var i=0;i<nics.length;i++)if(nics[i].name===ifn&&nics[i].wifi)isw=true;
