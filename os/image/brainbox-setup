    // security confirmation. The all-users variant is offered as the hedge.
    return "<div class='ostep'>1. "+h(t("cert_win_1"))+"</div>"+
      "<div class='ostep'>2. "+h(t("cert_win_2"))+"</div>"+
      cmdBlock("certutil -addstore -user Root \"%USERPROFILE%\\Downloads\\"+f+"\"")+
      "<div class='hint'>"+h(t("cert_win_admin"))+"</div>"+
      cmdBlock("certutil -addstore Root \"%USERPROFILE%\\Downloads\\"+f+"\"")+
      "<div class='hint'>"+h(t("cert_win_3"))+"</div>";
  }
  if(os==="mac"){
    return "<div class='ostep'>1. "+h(t("cert_mac_1"))+"</div>"+
      "<div class='ostep'>2. "+h(t("cert_mac_2"))+"</div>"+
      cmdBlock("sudo security add-trusted-cert -d -r trustRoot "+
               "-k /Library/Keychains/System.keychain ~/Downloads/"+f)+
      "<div class='hint'>"+h(t("cert_mac_fallback"))+"</div>"+
      "<div class='hint'>"+h(t("cert_mac_3"))+"</div>";
  }
  // Linux. The old NSS one-liner ERRORED on a fresh machine: certutil -A
  // fails with SEC_ERROR_BAD_DATABASE when ~/.pki/nssdb was never created.
  // The guarded -N creates the store ONLY when missing (running -N on an
  // existing store would wipe it — never hand a user that footgun).
  return "<div class='ostep'>1. "+h(t("cert_linux_1"))+"</div>"+
    cmdBlock("sudo cp ~/Downloads/"+f+" /usr/local/share/ca-certificates/\n"+
             "sudo update-ca-certificates")+
    "<div class='hint'>"+h(t("cert_linux_fedora"))+"</div>"+
    cmdBlock("sudo cp ~/Downloads/"+f+" /etc/pki/ca-trust/source/anchors/\n"+
             "sudo update-ca-trust")+
    "<div class='ostep'>2. "+h(t("cert_linux_2"))+"</div>"+
    cmdBlock("mkdir -p \"$HOME/.pki/nssdb\"\n"+
             "[ -e \"$HOME/.pki/nssdb/cert9.db\" ] || certutil -d sql:$HOME/.pki/nssdb -N --empty-password\n"+
             "certutil -d sql:$HOME/.pki/nssdb -A -t \"C,,\" -n \"Brainbox Root CA\" -i ~/Downloads/"+f)+
    "<div class='ostep'>3. "+h(t("cert_linux_3"))+"</div>"+
    "<div class='hint'>"+h(t("cert_linux_note"))+"</div>";
