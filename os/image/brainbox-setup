  r.textContent=t("testing"); r.className="";
  api("POST","/api/verify-brain",{fields:brainFields()}).then(function(res){
    r.textContent=(res.ok?"✓ ":"✗ ")+(res.detail||"");
    r.className=res.ok?"ok":"err";
  }).catch(function(){r.textContent="✗";r.className="err";});
}
// ---- in-wizard sign-in lane -----------------------------------------------
// Same mechanism as the standalone /claude page: the box runs Claude's OWN
// `claude auth login` and this shows its terminal. Nothing here parses the
// sign-in protocol, and "connected" comes from the box asking the vendor's CLI
// afterwards -- not from a process having exited.
var LSID=null, LTIMER=null, LURL=null;
function loginStopPoll(){if(LTIMER){clearInterval(LTIMER);LTIMER=null;}}
// Server hands back a machine-readable `reason`; prefer the translated text and
// fall back to the server's detail only for causes this build has no phrasing
// for. Codes that Claude itself rejects are deliberately absent: its own
// wording is already visible in the terminal.
function oauthMsg(r){
  var k=(r&&r.reason)?("oauth_e_"+r.reason):null;
  return (k&&LB&&LB[k])||(r&&r.detail)||"failed";
}
function loginPaintTerm(lines){
  var el=$("oauth_term"); if(!el)return;
  var stick=el.scrollTop+el.clientHeight>=el.scrollHeight-24;
  var txt=(lines||[]).join("\n").replace(/\n{3,}/g,"\n\n");
  // Linkify AFTER escaping: escaped text holds no raw < > or ", so matching to
  // whitespace cannot break out of the attribute, and the URL's own &amp;
  // entities decode back to '&' in href and label alike.
  el.innerHTML=h(txt).replace(/(https?:\/\/[^\s]+)/g,
    "<a href=\"$1\" target=\"_blank\" rel=\"noopener noreferrer\">$1</a>");
  if(stick)el.scrollTop=el.scrollHeight;
}
function loginPaintLink(url){
  var box=$("oauth_openbox"); if(!box)return;
  if(url&&url!==LURL){
    LURL=url;
    box.innerHTML="<a class='oauthlink' target='_blank' rel='noopener noreferrer' "+
      "href=\""+h(url)+"\">"+h(t("oauth_open"))+"</a>";
  }else if(!url&&!LURL){
    box.innerHTML="<div class='hint'>"+h(t("oauth_waiting_link"))+"</div>";
  }
}
function loginSetLive(running,checking){
  var el=$("oauth_live"); if(!el)return;
  el.textContent = running ? t("oauth_running")
                 : checking ? t("oauth_checking")
                 : t("oauth_ended");
}
function sendLoginCode(){
  var ci=$("oauth_code"); if(!ci)return;
  var code=(ci.value||"").trim();
  var err=$("oauth_err");
  if(!code){if(err){err.textContent=t("oauth_need_code");err.className="err";}return;}
  // <code>#<state>: copying only the part before the '#' is the classic
  // mistake. Name it at once, but still send -- the CLI is the authority on
  // its own code format and must stay able to accept a changed one.
  if(err){
    if(code.indexOf("#")<0){err.textContent=t("oauth_e_code_incomplete");err.className="hint";}
    else{err.textContent="";err.className="";}
  }
  var b=$("btnOauthFinish"); if(b)b.disabled=true;
  api("POST","/api/login/input",{session:LSID,text:code,key:"enter"}).then(function(r){
    if(b)b.disabled=false;
    if(!r.ok){if(err){err.textContent="✗ "+oauthMsg(r);err.className="err";}return;}
    ci.value="";                     // never leave the code in the field
  }).catch(function(){
    if(b)b.disabled=false;
    if(err){err.textContent="✗ network error";err.className="err";}
  });
}
function loginTick(){
  if(!LSID){loginStopPoll();return;}
  api("POST","/api/login/poll",{session:LSID}).then(function(r){
    var a=$("oauthArea"); if(!a)return;
    if(!r.ok){
      loginStopPoll();
      a.innerHTML="<div class='err'>✗ "+h(oauthMsg(r))+"</div>";
      var ob=$("btnOauth"); if(ob)ob.disabled=false;
      return;
    }
    loginPaintLink(r.url); loginPaintTerm(r.lines); loginSetLive(r.running,r.checking);
    if(r.running||r.checking)return;
    loginStopPoll();
    var b=$("btnOauthFinish"); if(b)b.disabled=true;
    var res=$("oauth_result"); if(!res)return;
    if(r.connected===true){
      // No token to stash: the credential is a file. The brain step's
      // validation accepts that (see login_signed_in on the server).
      res.innerHTML="<div class='ok'>✓ "+h(t("oauth_connected"))+"</div>";
      return;
    }
    res.innerHTML="<div class='err'>"+h(t("oauth_e_no_credential"))+"</div>";
    var ob2=$("btnOauth"); if(ob2)ob2.disabled=false;
  }).catch(function(){ /* transient: keep polling */ });
}
function startOauth(){
  var a=$("oauthArea"); if(!a)return;
  var btn=$("btnOauth"); if(btn)btn.disabled=true;
  loginStopPoll(); LSID=null; LURL=null;
  a.innerHTML="<div class='hint'>"+h(t("oauth_starting"))+"</div>";
  api("POST","/api/login/start",{provider:"claude"}).then(function(r){
    if(!r.ok){
      if(btn)btn.disabled=false;
      a.innerHTML="<div class='err'>✗ "+h(oauthMsg(r))+"</div>";
      return;
    }
    LSID=r.session;
    // Say out loud when this start killed an attempt that was still running:
    // any sign-in link still open in another tab is now dead, and a code from
    // it would come back rejected with no explanation.
    var notes="";
    if(r.superseded>0)notes+="<div class='hint'>"+h(t("oauth_superseded"))+"</div>";
    if(r.foreign>0)notes+="<div class='hint'>"+h(t("oauth_foreign"))+"</div>";
    a.innerHTML=notes+
      "<ol class='oauthsteps'>"+
        "<li>"+h(t("oauth_step1"))+"<div id='oauth_openbox'></div></li>"+
        "<li>"+h(t("oauth_step2"))+
          "<div class='row oauthrow'><input type='text' id='oauth_code' autocomplete='off' "+
            "spellcheck='false' placeholder=\""+h(t("oauth_code_ph"))+"\">"+
            "<button class='primary' id='btnOauthFinish'>"+h(t("oauth_finish"))+"</button></div>"+
          "<div class='err' id='oauth_err'></div></li>"+
      "</ol>"+
      "<div class='hint' id='oauth_live'></div>"+
      "<div class='oauthterm' id='oauth_term'></div>"+
      "<div id='oauth_result'></div>";
    loginPaintLink(r.url); loginPaintTerm(r.lines); loginSetLive(r.running,r.checking);
    if($("btnOauthFinish"))$("btnOauthFinish").onclick=sendLoginCode;
    var ci=$("oauth_code");
    if(ci){ci.focus();ci.onkeydown=function(e){
      if(e.key==="Enter"){e.preventDefault();sendLoginCode();}};}
    loginStopPoll(); LTIMER=setInterval(loginTick,700);
  }).catch(function(){
    if(btn)btn.disabled=false;
    a.innerHTML="<div class='err'>✗ network error</div>";
  });
}
function wireBrain(){
  var rs=document.getElementsByName("bmode");
  for(var i=0;i<rs.length;i++)rs[i].onchange=switchPane;
  switchPane();
  if($("testBrain"))$("testBrain").onclick=doTestBrain;
