def L(lang, key):

    return LABELS.get(lang, LABELS["en"]).get(key) or LABELS["en"].get(key) or key

def run(cmd, timeout=T_TOOL, env=None, input_=None):

    try:
        p = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,

            input=(input_.encode() if isinstance(input_, str) else input_),
            timeout=timeout,
            env=env,
            check=False,
        )
        return (p.returncode,
                p.stdout.decode("utf-8", "replace"),
                p.stderr.decode("utf-8", "replace"))
    except FileNotFoundError as e:
        return (127, "", "not found: %s" % e)
    except subprocess.TimeoutExpired:
        return (124, "", "timeout after %ss" % timeout)
    except Exception as e:
        return (1, "", "error: %s" % e)

def shq(v):

    s = "" if v is None else str(v)
    return "'" + s.replace("'", "'\\''") + "'"

def _is_root():
    return os.geteuid() == 0

def _atomic_write(path, text, mode=0o644, uid=None, gid=None):

    d = os.path.dirname(path) or "."
    tmp = os.path.join(d, ".%s.tmp.%d" % (os.path.basename(path), os.getpid()))
    fd = os.open(tmp, os.O_CREAT | os.O_WRONLY | os.O_TRUNC, mode)
    try:
        os.write(fd, text.encode("utf-8"))
        os.fchmod(fd, mode)
        os.fsync(fd)
    finally:
        os.close(fd)
    os.rename(tmp, path)
    try:
        if uid is not None and _is_root():
            os.chown(path, uid, gid if gid is not None else 0)
    except OSError:
        pass

def ensure_brainbox_dir():
    try:
        os.makedirs(BRAINBOX_DIR, mode=0o755, exist_ok=True)
        if _is_root():
            try:
                os.chown(BRAINBOX_DIR, 0, 0)
            except OSError:
                pass
    except OSError:
        pass

def detect_arch():
    try:
        return os.uname().machine or "unknown"
    except Exception:
        return "unknown"

def detect_kvm():
    return os.path.exists("/dev/kvm")

def _read_kv_file(path):

    out = {}
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, _, v = line.partition("=")
                k = k.strip()
                if k.startswith("export "):
                    k = k[len("export "):].strip()
                v = v.strip().strip('"').strip("'")
                out[k] = v
    except OSError:
        pass
    return out

def detect_service_identity():

    d = _read_kv_file(SERVICE_ENV)
    user = d.get("SERVICE_USER")
    home = d.get("SERVICE_HOME")
    uid = d.get("SERVICE_UID")
    if user and home and uid:
        try:
            uid_i = int(uid)
        except ValueError:
            uid_i = None
        if uid_i is not None:
            return {"SERVICE_USER": user, "SERVICE_HOME": home, "SERVICE_UID": uid_i}

    try:
        with open("/etc/passwd", "r", encoding="utf-8", errors="replace") as f:
            best = None
            for line in f:
                parts = line.rstrip("\n").split(":")
                if len(parts) < 7:
                    continue
                name, _, u, _, _, h, sh = parts[:7]
                try:
                    u_i = int(u)
                except ValueError:
                    continue
                if u_i >= 1000 and u_i < 65000 and h.startswith("/") \
                        and os.path.isdir(h) \
                        and sh and "nologin" not in sh and "false" not in sh:
                    if best is None or u_i < best["SERVICE_UID"]:
                        best = {"SERVICE_USER": name, "SERVICE_HOME": h,
                                "SERVICE_UID": u_i}
            if best:
                return best
    except OSError:
        pass

    return {"SERVICE_USER": "brainbox", "SERVICE_HOME": "/home/brainbox",
            "SERVICE_UID": 1000}

def _iface_is_wifi(ifname):
    if os.path.isdir("/sys/class/net/%s/wireless" % ifname):
        return True
    if os.path.exists("/sys/class/net/%s/phy80211" % ifname):
        return True
    return False

def _sshd_password_auth():

    rc, out, _ = run(["sshd", "-T"], timeout=10)
    if rc == 0:
        for line in out.splitlines():
            s = line.strip().lower()
            if s.startswith("passwordauthentication"):
                return s.split()[-1] == "yes"
    try:
        with open(SSHD_DROPIN, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                s = line.strip().lower()
                if s.startswith("passwordauthentication"):
                    return s.split()[-1] == "yes"
    except OSError:
        pass
    return None

def detect_access_state():

    ident = detect_service_identity()
    ak = os.path.join(ident["SERVICE_HOME"], ".ssh", "authorized_keys")
    keys = 0
    try:
