def _stable_uuid(seed):

    import hashlib
    hx = hashlib.sha1(seed.encode("utf-8")).hexdigest()
    return "%s-%s-%s-%s-%s" % (hx[0:8], hx[8:12], hx[12:16], hx[16:20],
                               hx[20:32])

def _ifupdown_conf(cfg):
    net = cfg.get("net", {})
    ifname = net.get("ifname") or "eth0"
    lines = ["# brainbox — generated by brainbox-setup",
             "auto %s" % ifname]
    if net.get("mode") == "static":
        lines.append("iface %s inet static" % ifname)

        lines.append("    address %s/%s" % (net.get("ip", ""),
                                            net.get("prefix", 24)))
        if net.get("gateway"):
            lines.append("    gateway %s" % net["gateway"])
        dns = net.get("dns") or []
        if dns:
            lines.append("    dns-nameservers %s" % " ".join(dns))
    else:
        lines.append("iface %s inet dhcp" % ifname)
    return "\n".join(lines) + "\n"

def _networkd_conf(cfg):
    net = cfg.get("net", {})
    ifname = net.get("ifname") or "eth0"
    lines = ["# brainbox — generated by brainbox-setup",
             "[Match]", "Name=%s" % ifname, "", "[Network]"]
    if net.get("mode") == "static":
        lines.append("Address=%s/%s" % (net.get("ip", ""), net.get("prefix", 24)))
        if net.get("gateway"):
            lines.append("Gateway=%s" % net["gateway"])
        for d in (net.get("dns") or []):
            lines.append("DNS=%s" % d)
    else:
        lines.append("DHCP=yes")
    return "\n".join(lines) + "\n"

def _step(report, name, fn):

    try:
        detail = fn()
        report.append({"step": name, "ok": True,
                       "detail": detail if isinstance(detail, str) else "ok"})
        return True
    except Exception as e:
        report.append({"step": name, "ok": False, "detail": "%s" % e})
        return False

def _apply_hostname(cfg):
    hn = cfg["hostname"]
    if detect_tool("hostnamectl"):
        rc, _, err = run(["hostnamectl", "set-hostname", hn])
        if rc == 0:
            return "hostnamectl set-hostname %s" % hn

    _atomic_write("/etc/hostname", hn + "\n", mode=0o644, uid=0, gid=0)

    run(["hostname", hn])

    try:
        with open("/etc/hosts", "r", encoding="utf-8", errors="replace") as f:
            lines = f.read().splitlines()
    except OSError:
        lines = ["127.0.0.1\tlocalhost"]
    out, replaced = [], False
    for ln in lines:
        if ln.strip().startswith("127.0.1.1"):
            out.append("127.0.1.1\t%s" % hn)
            replaced = True
        else:
            out.append(ln)
    if not replaced:
        out.append("127.0.1.1\t%s" % hn)
    _atomic_write("/etc/hosts", "\n".join(out) + "\n", mode=0o644, uid=0, gid=0)
    return "set live hostname + wrote /etc/hostname + /etc/hosts"

def _apply_timezone(cfg):
    tz = cfg["TZ"]
    if detect_tool("timedatectl"):
        rc, _, err = run(["timedatectl", "set-timezone", tz])
        if rc == 0:
            return "timedatectl set-timezone %s" % tz

    src = os.path.join(ZONEINFO_DIR, tz)
    if not os.path.exists(src):
        raise RuntimeError("zoneinfo missing for %s" % tz)
    try:
        if os.path.islink("/etc/localtime") or os.path.exists("/etc/localtime"):
            os.unlink("/etc/localtime")
    except OSError:
        pass
    os.symlink(src, "/etc/localtime")
    _atomic_write("/etc/timezone", tz + "\n", mode=0o644, uid=0, gid=0)
    return "symlinked /etc/localtime + wrote /etc/timezone"

def _apply_locale(cfg):
    loc = cfg["LOCALE"]
    _atomic_write("/etc/default/locale", "LANG=%s\n" % loc, mode=0o644, uid=0, gid=0)
    detail = "wrote /etc/default/locale"
    if detect_tool("locale-gen"):

        try:
            with open("/etc/locale.gen", "r", encoding="utf-8",
                      errors="replace") as f:
                gen = f.read().splitlines()
            changed = False
            for i, ln in enumerate(gen):
                s = ln.strip()
                if s.startswith("#") and loc in s:
                    gen[i] = s.lstrip("#").strip()
                    changed = True
            if changed:
                _atomic_write("/etc/locale.gen", "\n".join(gen) + "\n",
                              mode=0o644, uid=0, gid=0)
        except OSError:
            pass
        rc, _, _ = run(["locale-gen"], timeout=60)
        detail += "; locale-gen rc=%s" % rc
    return detail

def _apply_keymap(cfg):
    km = cfg.get("keymap") or ""
    if not km:
        return "no keymap set"
    _atomic_write("/etc/default/keyboard",
                  'XKBMODEL="pc105"\nXKBLAYOUT="%s"\nXKBVARIANT=""\n'
                  'XKBOPTIONS=""\n' % km, mode=0o644, uid=0, gid=0)
    if detect_tool("setupcon"):
        run(["setupcon"], timeout=30)
    return "wrote /etc/default/keyboard (%s)" % km

def _apply_network(cfg):
    stack = cfg.get("_net_stack") or detect_net_stack()
    if stack == "brainbox":

        net = cfg.get("net", {})
        mode = net.get("mode", "dhcp")
        lines = ["MODE=%s" % mode]
        if mode == "static":
            if net.get("ifname"):
                lines.append("IFACE=%s" % net["ifname"])
            lines.append("IP=%s" % (net.get("ip") or ""))
            lines.append("PREFIX=%s" % (net.get("prefix") or 24))
            if net.get("gateway"):
                lines.append("GATEWAY=%s" % net["gateway"])
            dns = net.get("dns") or []
            if dns:
                lines.append("DNS=%s" % ",".join(dns))
        _atomic_write(NETWORK_CONF, "\n".join(lines) + "\n",
                      mode=0o644, uid=0, gid=0)
        cfg["_network_changed"] = True

        if mode == "static":
            return "wrote %s (MODE=static); applies via deferred apply" % NETWORK_CONF
        return "wrote %s (MODE=dhcp); no change (pn-init already DHCPs)" % NETWORK_CONF
    if stack == "netplan":
        _atomic_write(NETPLAN_FILE, _netplan_yaml(cfg), mode=0o600, uid=0, gid=0)
        rc, _, err = run(["netplan", "generate"], timeout=30)
        cfg["_network_changed"] = True
        if rc != 0:
            raise RuntimeError("netplan generate rejected the config (rc=%s): %s"
                               % (rc, (err or "").strip()[:200]))
        return ("wrote %s (0600); netplan generate ok; "
                "applies next boot or via deferred apply" % NETPLAN_FILE)
    if stack == "networkmanager":
        os.makedirs("/etc/NetworkManager/system-connections",
                    mode=0o700, exist_ok=True)
        _atomic_write(NM_KEYFILE, _nm_keyfile(cfg), mode=0o600, uid=0, gid=0)
        detail = "wrote %s (0600)" % NM_KEYFILE
        wifi = cfg.get("wifi", {})
        if wifi.get("ssid") and wifi.get("psk") and cfg.get("_wifi_ifname"):
            _atomic_write(NM_WIFI_KEYFILE, _nm_wifi_keyfile(cfg),
                          mode=0o600, uid=0, gid=0)
            detail += "; wrote %s (0600)" % NM_WIFI_KEYFILE
        if detect_tool("nmcli"):
            run(["nmcli", "connection", "reload"], timeout=15)
            detail += "; nmcli connection reload"
        cfg["_network_changed"] = True
        return detail + "; activates via deferred apply / next boot"
    if stack == "ifupdown":
        _atomic_write(IFUPDOWN_FILE, _ifupdown_conf(cfg), mode=0o644, uid=0, gid=0)

        src_line = "source /etc/network/interfaces.d/*"
        try:
            with open(IFUPDOWN_MAIN, "r", encoding="utf-8",
                      errors="replace") as f:
                body = f.read()
        except OSError:
            body = ""
        if "interfaces.d" not in body:
            body = body.rstrip("\n") + "\n" + src_line + "\n"
            _atomic_write(IFUPDOWN_MAIN, body, mode=0o644, uid=0, gid=0)
        cfg["_network_changed"] = True
        return "wrote %s; activates next boot" % IFUPDOWN_FILE

    _atomic_write(NETWORKD_FILE, _networkd_conf(cfg), mode=0o644, uid=0, gid=0)
    cfg["_network_changed"] = True
    detail = "wrote %s" % NETWORKD_FILE
    if not _networkd_active():

        enabled = False
        if shutil.which("systemctl"):
            rc, _, _ = run(["systemctl", "enable", "systemd-networkd"],
                           timeout=15)
            enabled = (rc == 0)
        if enabled:
            detail += "; enabled systemd-networkd (was inactive)"
        else:
            detail += ("; WARNING systemd-networkd is not active — this file "
                       "will NOT apply until it is enabled")
    return detail + "; activates next boot"

CA_DOWNLOAD_NAME = "brainbox-ca.crt"

def _pn_certs_script(ident):
    return os.path.join(ident["SERVICE_HOME"],
                        "brainarbeit/cockpit/server/pn_certs.py")

def _ca_cert_file(ident):

    return os.path.join(ident["SERVICE_HOME"], ".config", "brainbox-portal",
                        "ca", "brainbox-ca.pem")

def _run_pn_certs(ident, verb):

    certs = _pn_certs_script(ident)
    if not os.path.exists(certs):
        return (127, "", "pn_certs.py not found")
    if _is_root() and shutil.which("runuser"):
        return run(["runuser", "-u", ident["SERVICE_USER"], "--", "python3",
                    certs, verb], timeout=T_CERTS)
    return run(["python3", certs, verb], timeout=T_CERTS)

def _ca_ensure(ident):

    path = _ca_cert_file(ident)
    if os.path.exists(path):
        return path
    _run_pn_certs(ident, "ensure")
    return path if os.path.exists(path) else None

def _ca_fingerprint_of(path):
    if not path or not shutil.which("openssl"):
        return None
    rc, out, _ = run(["openssl", "x509", "-in", path, "-noout",
                      "-fingerprint", "-sha256"], timeout=15)
    if rc != 0:
        return None
    m = re.search(r"([0-9A-Fa-f]{2}(?::[0-9A-Fa-f]{2}){10,})", out or "")
    return m.group(1) if m else None

def build_ca_payload():

    ident = detect_service_identity()
    path = _ca_ensure(ident)
    if not path:
        return {"ok": False, "available": False, "filename": CA_DOWNLOAD_NAME,
                "fingerprint": None, "portal_port": _portal_port(),
                "wizard_https_port": _TLS_STATE["port"] or None}
    return {"ok": True, "available": True, "filename": CA_DOWNLOAD_NAME,
            "fingerprint": _ca_fingerprint_of(path), "portal_port": _portal_port(),

            "wizard_https_port": _TLS_STATE["port"] or None}

def portal_tls_check():

    port = _portal_port()
    out = {"ok": True, "portal_port": port,
           "portal_up": False, "serves_box_ca": False}
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=3) as raw:
            ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
            ctx.check_hostname = False
            ctx.verify_mode = ssl.CERT_NONE
            with ctx.wrap_socket(raw, server_hostname="localhost"):
                out["portal_up"] = True
    except Exception:
        return out
    try:
        ca = _ca_cert_file(detect_service_identity())
        if ca and os.path.exists(ca):
            ctx2 = ssl.create_default_context(cafile=ca)

            with socket.create_connection(("127.0.0.1", port), timeout=3) as raw2:
                with ctx2.wrap_socket(raw2, server_hostname="localhost"):
                    out["serves_box_ca"] = True
    except Exception:
        pass
    return out

def _apply_identity_ca(cfg):
    ident = cfg["_ident"]
    home = ident["SERVICE_HOME"]
    user = ident["SERVICE_USER"]
    certs = os.path.join(home, "brainarbeit/cockpit/server/pn_certs.py")
    if not os.path.exists(certs):
        return "pn_certs.py not found — skipped (non-fatal)"
    if _is_root() and shutil.which("runuser"):
        rc, out, err = run(["runuser", "-u", user, "--", "python3", certs,
                            "ensure"], timeout=T_CERTS)
    else:
        rc, out, err = run(["python3", certs, "ensure"], timeout=T_CERTS)

    fp = None
    if _is_root() and shutil.which("runuser"):
        rc2, out2, _ = run(["runuser", "-u", user, "--", "python3", certs,
                            "info"], timeout=T_CERTS)
    else:
        rc2, out2, _ = run(["python3", certs, "info"], timeout=T_CERTS)
    if rc2 == 0 and out2:
        m = re.search(r"([0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){7,})", out2)
        if m:
            fp = m.group(1)
        else:
            try:
                info = json.loads(out2)
                fp = info.get("fingerprint") or info.get("ca_fingerprint")
            except Exception:
                pass
    cfg["_ca_fingerprint"] = fp
    return "pn_certs ensure rc=%s; fingerprint=%s" % (rc, "captured" if fp else "n/a")

_PIN_WRITER = (
    "import json,os,sys\n"
    "cfgpath=sys.argv[1]; pin=os.environ['BBX_ADMIN_PIN']\n"
    "d=os.path.dirname(cfgpath)\n"
    "os.makedirs(d,mode=0o700,exist_ok=True)\n"
    "try:\n"
    "    with open(cfgpath) as f: cfg=json.load(f)\n"
    "    if not isinstance(cfg,dict): cfg={}\n"
    "except Exception: cfg={}\n"
    "cfg['pin']=pin\n"
    "tmp=cfgpath+'.tmp'\n"
    "fd=os.open(tmp,os.O_CREAT|os.O_WRONLY|os.O_TRUNC,0o600)\n"
    "os.write(fd,json.dumps(cfg,indent=2).encode()); os.fsync(fd); os.close(fd)\n"
    "os.rename(tmp,cfgpath)\n"
    "print('pin-set')\n"
)

def _apply_identity_pin(cfg):
    ident = cfg["_ident"]
    home = ident["SERVICE_HOME"]
    user = ident["SERVICE_USER"]
    pin = cfg.get("admin_pin")
    cfgpath = os.path.join(home, ".config/brainbox-portal/config.json")
    if pin:

        env = dict(os.environ)
        env["BBX_ADMIN_PIN"] = pin
        if _is_root() and shutil.which("runuser"):
            cmd = ["runuser", "-w", "BBX_ADMIN_PIN", "-u", user, "--",
                   "python3", "-c", _PIN_WRITER, cfgpath]
        else:
            cmd = ["python3", "-c", _PIN_WRITER, cfgpath]
        rc, out, err = run(cmd, timeout=30, env=env)
        if rc == 0:
            return "PIN written to brainbox-portal config"
        raise RuntimeError("PIN write failed rc=%s: %s" % (rc, err.strip()[:120]))

    pp = detect_tool("brainbox-portal", home)
    if pp and _is_root() and shutil.which("runuser"):
        run(["runuser", "-u", user, "--", pp, "setup"], timeout=30)
        return "ran brainbox-portal setup (auto-generate PIN)"
    return "no PIN and no brainbox-portal — skipped"

def _write_authorized_keys(user, home, keys):
    ssh_dir = os.path.join(home, ".ssh")
    ak = os.path.join(ssh_dir, "authorized_keys")
    try:
        uid = pwd.getpwnam(user).pw_uid
        gid = pwd.getpwnam(user).pw_gid
    except KeyError:
        uid = gid = None
    try:
        os.makedirs(ssh_dir, mode=0o700, exist_ok=True)
        os.chmod(ssh_dir, 0o700)
        if _is_root() and uid is not None:
            os.chown(ssh_dir, uid, gid)
    except OSError as e:
        raise RuntimeError("cannot prepare %s: %s" % (ssh_dir, e))
    existing = []
    try:
        with open(ak, "r", encoding="utf-8", errors="replace") as f:
            existing = [ln.rstrip("\n") for ln in f]
    except OSError:
        pass

    def body(ln):
        p = ln.split()
        return p[1] if len(p) > 1 else ln

    have = set(body(ln) for ln in existing
               if ln.strip() and not ln.lstrip().startswith("#"))
    added = [k for k in keys if body(k) not in have]
    if not added:
        return "SSH key(s) already present, nothing added"
    text = "\n".join(ln for ln in (existing + added) if ln.strip()) + "\n"

    _atomic_write(ak, text, mode=0o600,
                  uid=(uid if _is_root() else None), gid=gid)
    return "%d SSH key(s) added to %s (%d total)" % (
        len(added), ak, len(have) + len(added))

def _apply_sshd_password_auth(cfg):

    want = 1 if cfg.get("ssh_password_auth") else 0
    cur = _sshd_password_auth()
    if cur is not None and bool(cur) == bool(want):
        return ""
    if cur is None and not want:

        return "sshd password login: state unreadable, left untouched"
    if not _is_root():
        raise RuntimeError("sshd change needs root")
    body = ["PasswordAuthentication %s" % ("yes" if want else "no"),
            "KbdInteractiveAuthentication %s" % ("yes" if want else "no"),

            "PermitRootLogin no"]
    try:
        os.makedirs(os.path.dirname(SSHD_DROPIN), mode=0o755, exist_ok=True)
    except OSError:
        pass

    prev = None
    if os.path.exists(SSHD_DROPIN):
        try:
            prev = open(SSHD_DROPIN, "r", encoding="utf-8").read()
        except OSError:
            prev = None
    _atomic_write(SSHD_DROPIN, "\n".join(body) + "\n", mode=0o644)
    rc, _, err = run(["sshd", "-t"], timeout=10)
    if rc not in (0, 127):
        if prev is None:
            try:
                os.unlink(SSHD_DROPIN)
            except OSError:
                pass
        else:
            _atomic_write(SSHD_DROPIN, prev, mode=0o644)
        raise RuntimeError("sshd rejected the config, change rolled back: %s"
                           % err.strip()[:120])
    for cmd in (["pnctl", "restart", "sshd"], ["systemctl", "reload", "ssh"],
                ["systemctl", "reload", "sshd"], ["service", "ssh", "reload"]):
        if detect_tool(cmd[0]):
            rc, _, _ = run(cmd, timeout=T_HANDOFF)
            if rc == 0:
                return "sshd password login %s (reloaded via %s)" % (
                    "ON" if want else "off", cmd[0])
    return "sshd password login %s (active on next sshd start)" % (
        "ON" if want else "off")

def _apply_access(cfg):

    ident = cfg["_ident"]
    user, home = ident["SERVICE_USER"], ident["SERVICE_HOME"]
    notes, failed = [], []
    keys = list(cfg.get("ssh_keys") or [])
    if keys:
        try:
            notes.append(_write_authorized_keys(user, home, keys))
        except Exception as e:
            failed.append("ssh keys: %s" % e)
    pw = cfg.get("console_password") or ""
    if pw:
        try:
            if not _is_root():
                raise RuntimeError("needs root")
            rc, _, err = run(["chpasswd"], timeout=20,
                             input_="%s:%s\n" % (user, pw))
            if rc != 0:
                raise RuntimeError("chpasswd rc=%s: %s" % (rc, err.strip()[:120]))

            try:
                os.unlink(INITIAL_PW_FILE)
            except OSError:
                pass

            if detect_tool("chage"):
                run(["chage", "-d", time.strftime("%Y-%m-%d"), user], timeout=10)
            notes.append("console/sudo password set for %s" % user)
        except Exception as e:
            failed.append("password: %s" % e)
    try:
        n = _apply_sshd_password_auth(cfg)
        if n:
            notes.append(n)
    except Exception as e:
        failed.append("sshd: %s" % e)
    if failed:
        raise RuntimeError("; ".join(failed +
                                     (["done: " + ", ".join(notes)] if notes else [])))
    return "; ".join(notes) if notes else "nothing to change"

def apply(cfg):

    ensure_brainbox_dir()
    report = []
    ident = cfg["_ident"]

    essential_ok = True
    essential_ok &= _step(report, "site.conf", lambda: (write_site_conf(cfg) or "wrote %s" % SITE_CONF))
    essential_ok &= _step(report, "secrets.env", lambda: (write_secrets_env(cfg) or "wrote %s (0600)" % SECRETS_ENV))
    essential_ok &= _step(report, "caps.env", lambda: (write_caps_env(cfg) or "wrote %s" % CAPS_ENV))
    essential_ok &= _step(report, "pnd.env", lambda: (append_pnd_env(cfg) or "merged brain env into %s (0600)" % PND_ENV))

    _step(report, "hostname", lambda: _apply_hostname(cfg))
    _step(report, "timezone", lambda: _apply_timezone(cfg))
    _step(report, "locale", lambda: _apply_locale(cfg))
    _step(report, "keymap", lambda: _apply_keymap(cfg))
    _step(report, "network", lambda: _apply_network(cfg))

    _step(report, "identity-ca", lambda: _apply_identity_ca(cfg))
    pin_ok = _step(report, "identity-pin", lambda: _apply_identity_pin(cfg))

    _step(report, "access", lambda: _apply_access(cfg))

    vb = verify_brain(cfg)
    report.append({"step": "brain-verify", "ok": vb["ok"], "detail": vb["detail"]})

    if essential_ok and pin_ok:
        _step(report, "setup-complete", lambda: (write_setup_complete(cfg) or "wrote %s" % SETUP_COMPLETE))
    else:
        report.append({"step": "setup-complete", "ok": False,
                       "detail": "skipped — essential config/PIN incomplete; "
                                 "wizard will re-offer on next boot"})

    def _handoff():
        chain = ["pn-llmd", "brainbox-portal"]
        if detect_tool("pnctl"):
            notes = []
            for svc in chain:

                rc, _, _ = run(["pnctl", "restart", svc], timeout=T_HANDOFF)
                if rc != 0:
                    rc, _, _ = run(["pnctl", "up", svc], timeout=T_HANDOFF)
                notes.append("%s rc=%s" % (svc, rc))
            return "pnctl " + ", ".join(notes)
        if detect_tool("systemctl"):
            notes = []
            for svc in chain:
                rc, out, _ = run(["systemctl", "list-unit-files",
                                  svc + ".service"], timeout=10)
                if rc == 0 and svc in out:
                    rc2, _, _ = run(["systemctl", "restart", svc], timeout=T_HANDOFF)
                    notes.append("%s rc=%s" % (svc, rc2))
            return "systemctl " + (", ".join(notes) if notes
                                   else "no units; starts next boot")
        return "brain + portal start on next boot (no pnctl/systemd)"
    _step(report, "handoff", _handoff)

    hn = cfg["hostname"]

    net = cfg.get("net", {})
    if net.get("mode") == "static" and net.get("ip"):
        ip = net["ip"]
    else:
        ip = detect_primary_ip()

    pport = _portal_port()

    setup_ok = any(r.get("step") == "setup-complete" and bool(r.get("ok"))
                   for r in report)
    payload = {
        "ok": setup_ok,
        "hostname": hn,

        "portal_urls": ["https://brainbox.local:%d" % pport, "https://%s:%d" % (ip, pport)],
        "pin": cfg.get("admin_pin"),

        "pin_generated": bool(cfg.get("_pin_generated")),
        "ca_fingerprint": cfg.get("_ca_fingerprint"),

        "trust_url": ("http://%s/ca.crt" % ip if WIZARD_PORT == 80
                      else "http://%s:%d/ca.crt" % (ip, WIZARD_PORT)),
        "brain": {"mode": cfg.get("brain", {}).get("mode"), "verify": vb},

        "ssh": {"user": ident["SERVICE_USER"], "host": ip,
                "keys": len(cfg.get("ssh_keys") or []),
                "password_auth": bool(cfg.get("ssh_password_auth"))},
        "owner_name": cfg.get("owner_name", ""),
        "report": report,
        "network_changed": bool(cfg.get("_network_changed")),
        "net_stack": cfg.get("_net_stack") or detect_net_stack(),
    }
    return payload

def deferred_network_apply(cfg):

    stack = cfg.get("_net_stack") or detect_net_stack()
    if not cfg.get("_network_changed"):
        return
    cmd = None
    if stack == "netplan" and detect_tool("netplan"):
        cmd = "sleep 5; netplan apply"
    elif stack == "networkmanager" and detect_tool("nmcli"):

        cmd = "sleep 5; nmcli connection reload; nmcli connection up brainbox"
    elif stack == "brainbox" and (cfg.get("net", {}) or {}).get("mode") == "static" \
            and os.path.exists(BRAINBOX_NETCFG):

        cmd = "sleep 5; %s %s" % (BRAINBOX_NETCFG, NETWORK_CONF)
    if cmd is None:
        return
    try:
        subprocess.Popen(["sh", "-c", cmd],
                         start_new_session=True,
                         stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)
    except Exception:
        pass

