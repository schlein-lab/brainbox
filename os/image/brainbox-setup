function onNext(){
  var name=STEPS[STEP];
  clearErrs();
  var pkt=collect(name);
  var btn=$("nextBtn"); btn.disabled=true;
  api("POST","/api/validate",pkt).then(function(r){
    btn.disabled=false;
    if(!r.ok){
      showErrs(r.errors||{});
      // brain: the oauth_token error div lives in the collapsed manual <details>,
      // so surface a visible step-level message instead of a silent no-op.
      if(name==="brain"&&r.errors&&r.errors.oauth_token){
        var a=$("oauthArea"); if(a)a.innerHTML="<div class='err'>"+h(t("brain_connect_first"))+"</div>";
      }
      // access: if the claim gate rejects but its field is not on this view (the
      // unlock happens up front now), never fail silently — send the owner back
      // to the gate with the reason, instead of a Next that does nothing.
      if(name==="access"&&r.errors&&r.errors.claim_code&&!$("e_claim_code")){
        CLAIMED=false; showClaimGate(r.errors.claim_code); return;
      }
      return;
    }
