class _QuietTLSServer(ThreadingHTTPServer):

    def finish_request(self, request, client_address):
        request.settimeout(10)
        request.do_handshake()
        request.settimeout(None)
        super().finish_request(request, client_address)

    def handle_error(self, request, client_address):
        exc = sys.exc_info()[1]
        if isinstance(exc, (ssl.SSLError, ConnectionError, TimeoutError, OSError)):
            sys.stderr.write("[brainbox-setup] https lane: %s from %s\n"
                             % (type(exc).__name__, client_address[0]))
            return
        super().handle_error(request, client_address)

def _wizard_leaf_paths(ident):

    d = os.path.join(ident["SERVICE_HOME"], ".config", "brainbox-portal")
    return os.path.join(d, "cert.pem"), os.path.join(d, "key.pem")

def _start_https():

    try:
        ident = detect_service_identity()
        cert, key = _wizard_leaf_paths(ident)
        if not (os.path.exists(cert) and os.path.exists(key)):
            _run_pn_certs(ident, "ensure")
        if not (os.path.exists(cert) and os.path.exists(key)):
            sys.stderr.write("[brainbox-setup] https lane: no leaf yet — "
                             "serving HTTP only\n")
            return None
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.load_cert_chain(cert, key)
        srv = _QuietTLSServer(("0.0.0.0", WIZARD_HTTPS_PORT), Handler)
        srv.socket = ctx.wrap_socket(srv.socket, server_side=True,
                                     do_handshake_on_connect=False)
        _TLS_STATE.update(ctx=ctx, cert=cert, key=key, port=WIZARD_HTTPS_PORT)
        threading.Thread(target=srv.serve_forever, daemon=True,
                         name="wizard-https").start()
        sys.stderr.write("[brainbox-setup] https lane on :%d (same leaf as "
                         "the portal)\n" % WIZARD_HTTPS_PORT)
        return srv
    except Exception as e:
        sys.stderr.write("[brainbox-setup] https lane unavailable (%s) — "
                         "serving HTTP only\n" % e)
        _TLS_STATE.update(ctx=None, cert=None, key=None, port=0)
        return None

def _reload_wizard_tls():

    st = _TLS_STATE
    if not (st["ctx"] and st["cert"] and st["key"]):
        return
    try:
        if os.path.exists(st["cert"]) and os.path.exists(st["key"]):
            st["ctx"].load_cert_chain(st["cert"], st["key"])
    except Exception as e:
        sys.stderr.write("[brainbox-setup] https lane: leaf reload failed "
                         "(%s); serving previous cert\n" % e)

def _authorized_keys_present(ident):

    ak = os.path.join(ident.get("SERVICE_HOME", ""), ".ssh", "authorized_keys")
    try:
        with open(ak, encoding="utf-8", errors="replace") as f:
            for ln in f:
                ln = ln.strip()
                if ln and not ln.startswith("#"):
                    return True
    except OSError:
        pass
    return False

def _read_initial_pw():

    try:
        with open(INITIAL_PW_FILE, encoding="utf-8", errors="replace") as f:
            v = f.read().strip()
            return v or None
    except OSError:
        return None

def _read_setup_code():

    try:
        with open(SETUP_CODE_FILE, encoding="utf-8", errors="replace") as f:
            v = "".join(ch for ch in f.read().strip() if ch.isdigit())
            return v or None
    except OSError:
        return None

def box_is_claimed():

    try:
        if os.path.exists(SETUP_COMPLETE):
            return True
        ident = detect_service_identity()
        fresh = os.path.exists(INITIAL_PW_FILE)
        keys = _authorized_keys_present(ident)
        if fresh and not keys:
            return False
        return True
    except Exception as e:
        sys.stderr.write("[brainbox-setup] box_is_claimed: %s -> fail-closed\n" % e)
        return True

def _serve(force):
    already = box_is_claimed() and not force
    Handler.already_complete = already
    Handler.portal_ip = detect_primary_ip()

    if already:

        pass

    port = 80
    httpd = None
    global WIZARD_PORT
    for cand in (80, 8099):
        try:
            httpd = ThreadingHTTPServer(("0.0.0.0", cand), Handler)
            port = cand
            WIZARD_PORT = cand
            break
        except (PermissionError, OSError) as e:
            sys.stderr.write("[brainbox-setup] cannot bind :%d (%s)\n" % (cand, e))
            continue
    if httpd is None:
        sys.stderr.write("[brainbox-setup] no port available; exiting\n")
        return 1

    tls_srv = _start_https()

    if already:
        sys.stderr.write("[brainbox-setup] setup-complete present; serving "
                         "redirect on :%d\n" % port)
    else:
        ip = detect_primary_ip()
        sys.stderr.write("[brainbox-setup] wizard on http://%s:%d/ "
                         "(and http://localhost:%d/)\n" % (ip, port, port))

    _login_gc_start()
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        try:
            _login_reap_all("shutdown")
        except Exception:
            pass
        if tls_srv is not None:
            try:
                tls_srv.shutdown()
                tls_srv.server_close()
            except Exception:
                pass
        httpd.server_close()
    return 0

def main(argv):
    args = argv[1:]
    force = "--force" in args
    tty = "--tty" in args

    lang = "de"
    for a in args:
        if a.startswith("--lang="):
            lang = a.split("=", 1)[1]
    if lang not in ("de", "en"):
        env_lang = os.environ.get("LANG", "")
        lang = "de" if env_lang.startswith("de") else ("en" if lang == "en" else "de")

    ensure_brainbox_dir()

    if tty:
        if os.path.exists(SETUP_COMPLETE) and not force:
            print("Setup already complete (%s). Use --force to re-run."
                  % SETUP_COMPLETE)
            return 0
        cfg = new_cfg(lang)
        try:
            return run_tty(cfg, lang)
        except KeyboardInterrupt:
            print("\nAborted.")
            return 130

    return _serve(force)

if __name__ == "__main__":
    sys.exit(main(sys.argv))
