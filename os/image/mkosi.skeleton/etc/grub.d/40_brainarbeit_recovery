#!/bin/sh
# GRUB recovery menu entries for the Brainarbeit appliance (run by grub-mkconfig at image
# assembly). Two safety nets that the in-init harness cannot test (STATUS.md "Deferred"):
#
#   1) "Brainarbeit (recovery: pn-init minimal)" — boots pn-init as PID1 in RECOVERY MODE
#      (pn.recovery): minimal bring-up, ONLY sacred services (sshd, the door) start, risky
#      services are held, and pn-init NEVER auto-resets — it stays up awaiting a human. The
#      appliance ships NO systemd (the image force-purges the systemd daemon family in
#      mkosi.postinst.chroot), so "boot stock systemd" is NOT a valid recovery path here; the
#      no-systemd replacement is pn-init's own pn.recovery handler (see os/init/pn-init.c).
#      The active root slot is read from grubenv ($prev_root_slot), NOT hardcoded.
#   2) "Brainarbeit (previous slot)" — the greenboot/self-update fallback: forces the OTHER
#      root slot via the saved $prev_root_slot grubenv var. greenboot also flips this
#      automatically on a failed health gate (see greenboot-health.sh).
#
# The DEFAULT entry (generated by 10_linux) carries the pn-init cmdline and is selected by
# $default in grubenv; greenboot decrements $boot_attempts and falls back here on exhaustion.
set -e

# Pull the kernel/initrd the normal generator found, so we track the real installed version.
cat <<'GRUBHEAD'

# --- Brainarbeit recovery entries (40_brainarbeit_recovery) ---
GRUBHEAD

# Load A/B + greenboot state from grubenv (default-safe if unset).
cat <<'GRUBENV'
load_env
if [ -z "${boot_attempts}" ]; then set boot_attempts=0; fi
GRUBENV

for kver in $(find /boot -maxdepth 1 -name 'vmlinuz-*' 2>/dev/null | sed 's#.*/vmlinuz-##' | sort -V); do
    vmlinuz="/vmlinuz-${kver}"
    initrd="/initrd.img-${kver}"
    cat <<RECOVERY

menuentry 'Brainarbeit (recovery: pn-init minimal)' --class recovery {
    load_env
    # Active slot from grubenv (default-safe to root-a) — must NOT hardcode root-a.
    if [ "\${prev_root_slot}" = "b" ]; then set rslot='root-b'; else set rslot='root-a'; fi
    echo "Booting RECOVERY: pn-init minimal on slot \${rslot} (sacred services only)..."
    linux  ${vmlinuz} root=LABEL=\${rslot} ro init=/usr/lib/brainarbeit/pn-init console=ttyS0 console=tty0 panic=-1 pn.recovery pn.fullsystem pn.devmgr=mdev
    initrd ${initrd}
}

menuentry 'Brainarbeit (previous slot — greenboot fallback)' --class fallback {
    load_env
    if [ "\${prev_root_slot}" = "b" ]; then set rslot='root-b'; else set rslot='root-a'; fi
    echo "Booting PREVIOUS slot \${rslot} (auto-revert)..."
    linux  ${vmlinuz} root=LABEL=\${rslot} ro init=/usr/lib/brainarbeit/pn-init console=ttyS0 console=tty0 panic=-1 pn.crashmax=3
    initrd ${initrd}
}
RECOVERY
done
